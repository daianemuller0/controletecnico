<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ControleTecnico</RootNamespace>
    <AssemblyName>ControleTecnico</AssemblyName>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- ícone do ControleTecnico.exe (Explorer, atalho, barra de tarefas): logo da Howden -->
    <ApplicationIcon>howden.ico</ApplicationIcon>
    <Product>Controle Técnico</Product>
    <AssemblyTitle>Controle Técnico</AssemblyTitle>
    <Company>Howden South America</Company>
    <!-- outra cópia do projeto clonada DENTRO desta pasta (ex.: C:\tecnicos\controletecnico\controletecnico) não entra na compilação:
         sem isto tudo aparece duas vezes ("já define um membro chamado…") -->
    <DefaultItemExcludes>$(DefaultItemExcludes);controletecnico/**;ControleTecnico/**;controletecnico-*/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests/**" />
    <Content Remove="Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mesmo provider do Previsão: DuckDB sobre Parquet (inclui a lib nativa). -->
    <PackageReference Include="DuckDB.NET.Data.Full" Version="1.1.3" />
    <!-- Leitura/escrita de .xlsx (importação e planilha modelo). -->
    <PackageReference Include="ClosedXML" Version="0.102.2" />
  </ItemGroup>

</Project>
