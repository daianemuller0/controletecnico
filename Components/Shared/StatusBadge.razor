<span class="badge @Item.Css" title="@L[Titulo ?? Item.Label]">@Icons.Svg(Item.Icon, "bico")@L[Item.Label]@if (!string.IsNullOrEmpty(Extra)) { <span class="badge-extra">@L[Extra]</span> }</span>

@code {
    [Parameter, EditorRequired] public Item Item { get; set; } = default!;
    [Parameter] public string? Extra { get; set; }
    [Parameter] public string? Titulo { get; set; }
}
