@* Documentos da viagem (passagem, hotel, carro…): botão próprio por tipo e lista agrupada. *@
@inject Servicos Svc
@inject Db Db
@inject Sessao Sessao

<div class="panel dv">
    <div class="panel-head"><div class="panel-title">@Icons.Svg("paperclip")@L["Documentos da viagem"] <span class="hint">@L.F("{0} arquivo(s)", _anexos.Count)</span></div></div>
    @if (!VerAnexos) { <div class="muted">@Icons.Svg("lock")@(Sessao.Apresentacao ? L["Documentos ocultos no modo apresentação."] : L["Documentos ocultos para o seu perfil."])</div> }
    else
    {
        @if (Pode)
        {
            <div class="dv-botoes">
                @foreach (var (cat, rot, ico) in Cats)
                {
                    <label class="dv-add" title="@($"{L["Adicionar"]} {L[rot].ToLowerInvariant()}")">@Icons.Svg(ico)<span>@L[rot]</span><small>@L["adicionar"]</small>
                        <InputFile OnChange="e => Enviar(e, cat)" multiple accept=".pdf,.jpg,.jpeg,.png,.msg,.eml" /></label>
                }
            </div>
            <div class="muted sm">@L["PDF, JPG, PNG ou e-mail salvo (.msg/.eml), até 15 MB cada. Os documentos vão anexados no e-mail da Ordem de Serviço."]</div>
        }
        @if (_enviando) { <div class="muted sm mt8">@L["Enviando…"]</div> }
        @if (!string.IsNullOrEmpty(_msg)) { <div class="alert-box alert-erro mt8">@Icons.Svg("alert")<div>@_msg</div></div> }
        @if (Local && Pendentes.Count > 0)
        {
            <div class="dv-grupo"><div class="dv-gtit">@Icons.Svg("clock")@L["Serão anexados ao salvar a viagem"]</div>
                @foreach (var pd in Pendentes.ToList())
                {
                    var info = Cats.First(c => c.cat == Cat(pd.Categoria));
                    <div class="anexo">@Icons.Svg(info.ico)<span>@pd.Nome</span><span class="muted sm">@L[info.rot] · @(pd.Dados.Length / 1024) KB</span>
                        <button class="row-act del" @onclick="() => { Pendentes.Remove(pd); }" title="@L["Tirar"]">@Icons.Svg("x")</button></div>
                }
            </div>
        }
        @if (_anexos.Count == 0 && !(Local && Pendentes.Count > 0)) { <div class="dv-vazio">@L["Nenhum documento ainda. Use os botões acima para anexar passagem, reserva de hotel, carro…"]</div> }
        @foreach (var g in _anexos.GroupBy(a => Cat(a.Categoria)).OrderBy(g => Array.FindIndex(Cats, c => c.cat == g.Key)))
        {
            var info = Cats.First(c => c.cat == g.Key);
            <div class="dv-grupo"><div class="dv-gtit">@Icons.Svg(info.ico)@L[info.rot]</div>
                @foreach (var an in g.OrderBy(a => a.NomeOriginal))
                {
                    <div class="anexo">@Icons.Svg("file")<a href="/arquivos/@an.Id" target="_blank" rel="noopener">@an.NomeOriginal</a><span class="muted sm">@(an.Tamanho / 1024) KB</span>
                        <a class="btn-link" href="/arquivos/@an.Id?baixar=true" download="@an.NomeOriginal" title="@L["Baixar"]">@Icons.Svg("download")</a>
                        @if (Pode) { <button class="row-act del" @onclick="() => Remover(an)" title="@L["Remover"]">@Icons.Svg("x")</button> }</div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public string ViagemId { get; set; } = "";
    [Parameter, EditorRequired] public Ator Ator { get; set; } = default!;
    [Parameter] public bool Pode { get; set; }
    [Parameter] public bool VerAnexos { get; set; }
    [Parameter] public EventCallback OnMudou { get; set; }
    /// <summary>Viagem ainda não salva: os arquivos ficam aqui e são anexados logo depois de salvar.</summary>
    [Parameter] public List<Pendente> Pendentes { get; set; } = new();
    public sealed record Pendente(string Nome, string Categoria, byte[] Dados);
    private bool Local => string.IsNullOrEmpty(ViagemId);

    private static readonly (string cat, string rot, string ico)[] Cats = { ("voo", "Voo / passagem", "plane"), ("hotel", "Hotel", "customers"), ("carro", "Carro", "car"), ("outro", "Outros", "paperclip") };
    private static string Cat(string c) => Cats.Any(x => x.cat == c) ? c : "outro";
    private List<Anexo> _anexos = new(); private string? _msg; private bool _enviando;

    protected override void OnParametersSet() => Carregar();
    private void Carregar() => _anexos = Local ? new() : Db.Anexos.Onde(a => a.DonoTipo == "viagem" && a.DonoId == ViagemId);

    private async Task Enviar(InputFileChangeEventArgs e, string cat)
    {
        _msg = null; _enviando = true; var falhas = new List<string>(); var n = 0;
        foreach (var f in e.GetMultipleFiles(20))
            try
            {
                await using var s = f.OpenReadStream(Armazenamento.TamanhoMaximo);
                if (Local)
                {
                    using var ms = new MemoryStream(); await s.CopyToAsync(ms); var b = ms.ToArray();
                    Armazenamento.Validar(f.Name, b.Length, b.AsSpan(0, Math.Min(8, b.Length)), aceitaEmail: true);
                    Pendentes.Add(new Pendente(f.Name, cat, b));
                }
                else await Svc.AnexarAsync(Ator, "viagem", ViagemId, f.Name, s, cat);
                n++;
            }
            catch (Exception ex) { falhas.Add($"{f.Name}: {string.Join(" ", Ui.Erros(ex).Select(x => L[x]))}"); }
        _enviando = false; Carregar();
        if (falhas.Count > 0) _msg = string.Join(" | ", falhas);
        if (n > 0) Sessao.Avisar(Local ? L.F("{0} documento(s) pronto(s): serão anexados ao salvar a viagem.", n) : L.F("{0} documento(s) anexado(s).", n));
        await OnMudou.InvokeAsync();
    }
    private async Task Remover(Anexo a)
    {
        try { Svc.RemoverAnexo(Ator, a.Id); Carregar(); await OnMudou.InvokeAsync(); }
        catch (Exception ex) { _msg = string.Join(" ", Ui.Erros(ex).Select(x => L[x])); }
    }
}
