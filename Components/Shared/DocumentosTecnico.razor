@* Documentos, treinamentos e certificações de um técnico: cadastro, anexos, renovação e histórico. *@
@implements IDisposable
@inject Servicos Svc
@inject Db Db
@inject Sessao Sessao

<div class="toolbar">
    <h3 class="sec nm">@Icons.Svg(Modo == "docs" ? "file" : "shield")@(Modo == "docs" ? L["Documentos"] : L["Treinamentos e certificações"])</h3>
    <span class="grow"></span>
    @if (PodeEditar) { <button class="btn-primary" @onclick="Novo">@Icons.Svg("plus")@(Modo == "docs" ? L["Adicionar documento"] : L["Adicionar treinamento / certificação"])</button> }
</div>
@if (Sessao.Apresentacao)
{
    <div class="alert-box alert-info">@Icons.Svg("eye-off")<div>@L["Modo apresentação: o conteúdo dos arquivos fica oculto. Situação e vencimentos continuam visíveis."]</div></div>
}
else if (!PodeConteudo)
{
    <div class="alert-box alert-info">@Icons.Svg("lock")<div>@L["Seu perfil vê a situação e os vencimentos, mas não o conteúdo dos arquivos."]</div></div>
}

@if (_atuais.Count == 0)
{
    <div class="empty-state sm"><div class="ico">@Icons.Svg(Modo == "docs" ? "file" : "shield")</div><h3>@L["Nada cadastrado ainda"]</h3><p>@(PodeEditar ? L["Use o botão acima para adicionar o primeiro registro."] : L["Nenhum registro para exibir."])</p></div>
}
else
{
    <div class="table-wrap"><table class="grid-tbl">
        <thead><tr><th>@L["Registro"]</th><th>@L["Norma"]</th><th>@L["Emissão"]</th><th>@L["Vencimento"]</th><th>@L["Situação"]</th><th>@L["Anexos"]</th><th></th></tr></thead>
        <tbody>
        @foreach (var d in _atuais)
        {
            var st = DocEngine.Status(d, _hoje, Db.DiasAlerta); var dias = DocEngine.DiasParaVencer(d, _hoje);
            var anexos = _anexos.Where(a => a.DonoId == d.Id).ToList();
            var versoes = _todos.Where(x => x.RaizId == d.RaizId && x.Id != d.Id).OrderByDescending(x => x.Versao).ToList();
            <tr>
                <td><strong>@d.Nome</strong><div class="muted sm">@L[d.Categoria] · v@d.Versao@(string.IsNullOrEmpty(d.Emissor) ? "" : " · " + d.Emissor)</div></td>
                <td>@d.Norma@if (!string.IsNullOrEmpty(d.NormaVersao)) { <span class="muted sm"> (@d.NormaVersao)</span> }</td>
                <td>@Tempo.Dia(d.Emissao)</td>
                <td>@(d.SemVencimento ? L["Sem vencimento"] : Tempo.Dia(d.Vencimento))@if (dias is not null) { <div class="muted sm">@(dias < 0 ? L.F("vencido há {0} dia(s)", -dias) : L.F("em {0} dia(s)", dias))</div> }</td>
                <td><StatusBadge Item="@Trad(Ui.StDoc(st))" /></td>
                <td>
                    @foreach (var a in anexos) { <div class="anexo">@Icons.Svg("paperclip")@LinkAnexo(a)</div> }
                    @if (anexos.Count == 0) { <span class="muted sm">@L["sem anexo"]</span> }
                </td>
                <td class="right nowrap">
                    @if (PodeEditar)
                    {
                        <button class="row-act" title="@L["Editar dados"]" @onclick="() => Editar(d)">@Icons.Svg("edit")</button>
                        <button class="row-act" title="@L["Renovar (mantém a versão anterior no histórico)"]" @onclick="() => AbrirRenovar(d)">@Icons.Svg("refresh")</button>
                        <label class="row-act" title="@L["Adicionar anexo"]">@Icons.Svg("paperclip")<InputFile OnChange="e => AnexarDireto(d.Id, e)" multiple accept=".pdf,.jpg,.jpeg,.png" class="sr-only" /></label>
                        <button class="row-act del" title="@L["Excluir"]" @onclick="() => _excluir = d">@Icons.Svg("trash")</button>
                    }
                    @if (versoes.Count > 0) { <button class="row-act" title="@L.F("Histórico de renovações ({0})", versoes.Count)" @onclick="() => _hist = d">@Icons.Svg("history")</button> }
                </td>
            </tr>
        }
        </tbody>
    </table></div>
}
@if (!string.IsNullOrEmpty(_msgAnexo)) { <div class="alert-box alert-erro mt8">@Icons.Svg("alert")<div>@_msgAnexo</div></div> }

@if (_hist is not null)
{
    var vs = _todos.Where(x => x.RaizId == _hist.RaizId).OrderByDescending(x => x.Versao).ToList();
    <Dialogo Titulo="@L.F("Histórico · {0}", _hist.Nome)" Largo="true" OnFechar="@(() => _hist = null)">
        <p class="muted">@L["Cada renovação cria uma nova versão; os certificados anteriores e seus arquivos são mantidos."]</p>
        <div class="table-wrap"><table class="grid-tbl">
            <thead><tr><th>@L["Versão"]</th><th>@L["Emissão"]</th><th>@L["Vencimento"]</th><th>@L["Situação"]</th><th>@L["Cadastrado por"]</th><th>@L["Anexos"]</th></tr></thead>
            <tbody>
            @foreach (var v in vs)
            {
                var st = DocEngine.Status(v, _hoje, Db.DiasAlerta);
                <tr>
                    <td>v@v.Versao @if (v.Atual) { <span class="tag ok">@L["atual"]</span> }</td>
                    <td>@Tempo.Dia(v.Emissao)</td><td>@(v.SemVencimento ? L["Sem vencimento"] : Tempo.Dia(v.Vencimento))</td>
                    <td><StatusBadge Item="@Trad(Ui.StDoc(st))" /></td><td>@v.CadastradoPor<div class="muted sm">@Tempo.Hora(v.CriadoEm, Db.FusoPadrao, null, true)</div></td>
                    <td>@foreach (var a in _anexos.Where(a => a.DonoId == v.Id)) { <div class="anexo">@Icons.Svg("paperclip")@LinkAnexo(a)</div> }</td>
                </tr>
            }
            </tbody>
        </table></div>
    </Dialogo>
}

@if (_excluir is not null)
{
    <Dialogo Titulo="@L["Excluir registro"]" OnFechar="@(() => _excluir = null)" Erros="_erros">
        <p>@((MarkupString)L.F("Excluir {0} e seus anexos? Esta ação não pode ser desfeita. Para trocar por um novo certificado use <em>Renovar</em>, que preserva o histórico.", Negrito(_excluir.Nome)))</p>
        <div class="modal-actions"><button class="btn-ghost" @onclick="@(() => _excluir = null)">@L["Cancelar"]</button><button class="btn-danger" @onclick="Excluir">@Icons.Svg("trash")@L["Excluir"]</button></div>
    </Dialogo>
}

@if (_f is not null)
{
    <Dialogo Titulo="@Titulo" Largo="true" OnFechar="@(() => _f = null)" Erros="_erros">
        @if (_renovando is not null) { <div class="alert-box alert-info">@Icons.Svg("info")<div>@((MarkupString)L.F("Renovando {0} (v{1}, vencimento {2}). A versão atual passa para o histórico, com seus arquivos.", Negrito(_renovando.Nome), _renovando.Versao, Tempo.Dia(_renovando.Vencimento)))</div></div> }
        <div class="form-grid">
            <label class="fld full">@L["Nome do documento / treinamento / certificação"] *<input @bind="_f.Nome" /></label>
            <label class="fld">@L["Categoria"] *<CampoLista Value="@_f.Categoria" ValueChanged="@((string v) => { _f.Categoria = v; })" Opcoes="@(Categorias)" Placeholder="" /></label>
            <label class="fld">@L["Norma relacionada"] <span class="hint">@L["ex.: NR-10, ISO 18436-2"]</span><input @bind="_f.Norma" /></label>
            <label class="fld">@L["Identificação / versão da norma"]<input @bind="_f.NormaVersao" placeholder="@L["ex.: 2014, Rev. 3"]" /></label>
            <label class="fld">@L["Instituição / responsável pela emissão"]<input @bind="_f.Emissor" /></label>
            <label class="fld">@L["Data de emissão / realização"]<input type="date" value="@Ui.DataInput(_f.Emissao)" @onchange="e => _f.Emissao = Ui.DoDataInput(e.Value?.ToString())" /></label>
            <label class="fld">@L["Data de vencimento"]<input type="date" disabled="@_f.SemVencimento" value="@Ui.DataInput(_f.Vencimento)" @onchange="e => _f.Vencimento = Ui.DoDataInput(e.Value?.ToString())" />
                <span class="hint">@L["A validade é a deste registro do técnico, definida por quem cadastra ou pela regra da empresa — não é presumida pela norma."]</span></label>
            <label class="fld chk"><input type="checkbox" @bind="_f.SemVencimento" />@L["Sem vencimento"]</label>
            <label class="fld full">@L["Observações"]<textarea @bind="_f.Obs"></textarea></label>
            <div class="fld full"><span>@L["Anexos (PDF, JPG ou PNG, até 15 MB cada) — mais de um por registro"]</span>
                <InputFile OnChange="AoEscolher" multiple accept=".pdf,.jpg,.jpeg,.png" />
                @foreach (var a in _novosArquivos) { <div class="anexo">@Icons.Svg("paperclip")@a.Name <span class="muted sm">(@(a.Size / 1024) KB)</span></div> }
            </div>
            <div class="fld full muted sm">@L.F("Responsável pelo cadastro: {0}", string.IsNullOrEmpty(_f.Id) || _renovando is not null ? Ator.Nome : _f.CadastradoPor)</div>
        </div>
        <div class="modal-actions"><button class="btn-ghost" @onclick="@(() => _f = null)">@L["Cancelar"]</button><button class="btn-primary" @onclick="Salvar" disabled="@_salvando">@Icons.Svg("check")@(_renovando is not null ? L["Renovar"] : L["Salvar"])</button></div>
    </Dialogo>
}


@code {
    [Parameter, EditorRequired] public string TecnicoId { get; set; } = "";
    [Parameter] public string Modo { get; set; } = "docs";
    [Parameter, EditorRequired] public Ator Ator { get; set; } = default!;
    [Parameter] public EventCallback OnMudou { get; set; }

    private static readonly string[] CatDocs = { "Documento pessoal", "Exame / saúde", "Outro" };
    private static readonly string[] CatTrein = { "Treinamento", "Certificação", "Norma / comprovação" };
    private string[] Categorias => Modo == "docs" ? CatDocs : CatTrein;
    private bool NaSecao(string cat) => Modo == "docs" ? !CatTrein.Contains(cat) : CatTrein.Contains(cat);

    private List<Documento> _todos = new(), _atuais = new(); private List<Anexo> _anexos = new();
    private DateTime _hoje;
    private Documento? _f, _renovando, _excluir, _hist; private List<string>? _erros; private bool _salvando; private string? _msgAnexo;
    private List<IBrowserFile> _novosArquivos = new();
    private bool PodeEditar => Ator.Pode(Perm.EditarDocs, TecnicoId);
    private bool PodeConteudo => Ator.Pode(Perm.VerDocsConteudo, TecnicoId) && !Sessao.Apresentacao;
    private string Titulo => _renovando is not null ? L["Renovar"] : string.IsNullOrEmpty(_f?.Id) ? L["Novo registro"] : L["Editar registro"];
    /// <summary>Rótulo do vocabulário traduzido para o StatusBadge.</summary>
    private Item Trad(Item i) => i with { Label = L[i.Label] };
    private static string Negrito(string? s) => $"<strong>{System.Net.WebUtility.HtmlEncode(s ?? "")}</strong>";

    protected override void OnInitialized() => Sessao.Mudou += Ao;
    private void Ao() => InvokeAsync(StateHasChanged);
    public void Dispose() => Sessao.Mudou -= Ao;
    protected override void OnParametersSet() => Carregar();

    private void Carregar()
    {
        _hoje = DocEngine.Hoje(Db.FusoPadrao);
        _todos = Db.Documentos.Onde(d => d.TecnicoId == TecnicoId);
        _atuais = _todos.Where(d => d.Atual && NaSecao(d.Categoria)).OrderBy(d => d.Vencimento ?? DateTime.MaxValue).ToList();
        var ids = _todos.Select(d => d.Id).ToHashSet();
        _anexos = Db.Anexos.Onde(a => a.DonoTipo == "documento" && ids.Contains(a.DonoId)).OrderBy(a => a.CriadoEm).ToList();
    }

    private RenderFragment LinkAnexo(Anexo a) => __builder =>
    {
        if (PodeConteudo)
        {
            <a href="/arquivos/@a.Id" target="_blank" rel="noopener">@a.NomeOriginal</a>
            <a class="btn-link" href="/arquivos/@a.Id?baixar=true" download="@a.NomeOriginal" title="@L["Baixar"]">@Icons.Svg("download")</a>
            @if (PodeEditar && _todos.FirstOrDefault(x => x.Id == a.DonoId)?.Atual == true)
            { <button class="row-act del" title="@L["Remover anexo"]" @onclick="() => RemoverAnexo(a)">@Icons.Svg("x")</button> }
        }
        else { <span class="muted">@(Sessao.Apresentacao ? L["arquivo oculto"] : a.NomeOriginal)</span> }
    };

    private void Novo()
    {
        _f = new Documento { TecnicoId = TecnicoId, Categoria = Categorias[0] }; _renovando = null; _erros = null; _novosArquivos = new();
    }
    private void Editar(Documento d) { _f = d; _renovando = null; _erros = null; _novosArquivos = new(); }
    private void AbrirRenovar(Documento d)
    {
        _renovando = d; _erros = null; _novosArquivos = new();
        _f = new Documento { TecnicoId = d.TecnicoId, Nome = d.Nome, Categoria = d.Categoria, Norma = d.Norma, NormaVersao = d.NormaVersao, Emissor = d.Emissor, SemVencimento = d.SemVencimento, Emissao = Tempo.SoData(DateTime.UtcNow) };
    }

    private void AoEscolher(InputFileChangeEventArgs e) => _novosArquivos = e.GetMultipleFiles(10).ToList();

    private async Task Salvar()
    {
        if (_f is null) return;
        _salvando = true; _erros = null; var falhas = new List<string>();
        try
        {
            Documento salvo = _renovando is not null ? Svc.Renovar(Ator, _renovando.Id, _f) : Svc.SalvarDocumento(Ator, _f);
            foreach (var arq in _novosArquivos)
            {
                try { await using var s = arq.OpenReadStream(Armazenamento.TamanhoMaximo); await Svc.AnexarAsync(Ator, "documento", salvo.Id, arq.Name, s); }
                catch (Exception ex) { falhas.Add($"{arq.Name}: {string.Join(" ", Ui.Erros(ex).Select(x => L[x]))}"); }
            }
            _f = null; _renovando = null; Carregar();
            if (falhas.Count > 0) { _msgAnexo = L.F("O registro foi salvo, mas alguns anexos não: {0}", string.Join(" | ", falhas)); Sessao.Avisar("Registro salvo; verifique os anexos recusados.", true); }
            else { _msgAnexo = null; Sessao.Avisar("Registro salvo."); }
            await OnMudou.InvokeAsync();
        }
        catch (Exception ex) { _erros = Ui.Erros(ex); }
        _salvando = false;
    }

    private async Task AnexarDireto(string docId, InputFileChangeEventArgs e)
    {
        _msgAnexo = null; var falhas = new List<string>();
        foreach (var arq in e.GetMultipleFiles(10))
        {
            try { await using var s = arq.OpenReadStream(Armazenamento.TamanhoMaximo); await Svc.AnexarAsync(Ator, "documento", docId, arq.Name, s); }
            catch (Exception ex) { falhas.Add($"{arq.Name}: {string.Join(" ", Ui.Erros(ex).Select(x => L[x]))}"); }
        }
        Carregar();
        if (falhas.Count > 0) _msgAnexo = string.Join(" | ", falhas); else Sessao.Avisar("Anexo adicionado.");
    }

    private void RemoverAnexo(Anexo a)
    {
        try { Svc.RemoverAnexo(Ator, a.Id); Carregar(); Sessao.Avisar("Anexo removido."); }
        catch (Exception ex) { _msgAnexo = string.Join(" ", Ui.Erros(ex).Select(x => L[x])); }
    }

    private async Task Excluir()
    {
        try { Svc.ExcluirDocumento(Ator, _excluir!.Id); _excluir = null; Carregar(); Sessao.Avisar("Registro excluído."); await OnMudou.InvokeAsync(); }
        catch (Exception ex) { _erros = Ui.Erros(ex); }
    }
}
