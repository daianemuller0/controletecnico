@* Seletor com busca para listas (serviço, cliente, técnico, especialidade…). Com Criar, aceita um valor manual: cria o item na hora. *@
@inject Sessao Sessao

<div class="sel @(_aberto ? "aberto" : "")">
    @if (_aberto) { <div class="sel-fundo" @onclick="Fechar"></div> }
    <div class="sel-campo @(Disabled ? "off" : "")">
        @Icons.Svg("search")
        @if (!_aberto)
        {
            <button type="button" class="sel-valor @(_atual is null ? "vazio" : "")" @onclick="Abrir" disabled="@Disabled">
                @if (_atual is not null) { <strong>@_atual.Rotulo</strong> } else { <span>@Placeholder</span> }
            </button>
        }
        else
        {
            <input class="sel-input" @bind="_texto" @bind:event="oninput" @bind:after="Refiltrar" @onkeydown="Tecla" placeholder="@(Criar is null ? "Digite para buscar…" : "Digite para buscar ou criar…")" autocomplete="off" autofocus />
        }
        @if (_atual is not null && AllowClear && !Disabled) { <button type="button" class="sel-x" @onclick="Limpar" aria-label="Limpar seleção">@Icons.Svg("x")</button> }
    </div>
    @if (_aberto)
    {
        <div class="sel-painel" role="listbox">
            @if (!string.IsNullOrEmpty(Vazio)) { <button type="button" class="sel-op sel-vazio" @onclick="Limpar">@Vazio</button> }
            @if (PodeCriar)
            {
                <button type="button" class="sel-op sel-criar @(_ativo == -1 ? "ativo" : "")" @onclick="CriarNovo">
                    <span class="sel-l1">@Icons.Svg("plus")Criar @RotuloCriar “@_texto.Trim()”</span><span class="sel-l2">Usar um valor que ainda não está na lista</span>
                </button>
            }
            @for (var i = 0; i < _res.Count; i++)
            {
                var r = _res[i]; var idx = i;
                <button type="button" role="option" class="sel-op @(i == _ativo ? "ativo" : "") @(r.Id == Value ? "sel" : "")" @onclick="() => Escolher(r)" @onmouseover="() => _ativo = idx">
                    <span class="sel-l1">@r.Rotulo</span>@if (!string.IsNullOrEmpty(r.Sub)) { <span class="sel-l2">@r.Sub</span> }
                </button>
            }
            @if (_res.Count == 0 && !PodeCriar) { <div class="sel-nada">Nada encontrado.</div> }
            <div class="sel-rodape">@(_total > _res.Count ? $"Mostrando {_res.Count} de {_total:N0}" : $"{_total:N0} opção(ões)")</div>
        </div>
    }
</div>

@code {
    public sealed record ItemSel(string Id, string Rotulo, string? Sub = null);

    [Parameter] public IEnumerable<ItemSel> Itens { get; set; } = Array.Empty<ItemSel>();
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "— selecione —";
    [Parameter] public string? Vazio { get; set; }
    [Parameter] public bool AllowClear { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Quando informado, o texto digitado que não existe vira uma opção "Criar …" (valor manual).</summary>
    [Parameter] public Func<string, Task<string?>>? Criar { get; set; }
    [Parameter] public string RotuloCriar { get; set; } = "";

    private bool _aberto; private string _texto = ""; private int _ativo; private int _total; private List<ItemSel> _res = new(); private ItemSel? _atual; private List<ItemSel> _todos = new();

    protected override void OnParametersSet() { _todos = Itens.ToList(); _atual = string.IsNullOrEmpty(Value) ? null : _todos.FirstOrDefault(i => i.Id == Value); }

    private bool PodeCriar => Criar is not null && _texto.Trim().Length >= 2 && !_todos.Any(i => DocEngine.Norm(i.Rotulo) == DocEngine.Norm(_texto));
    private void Abrir() { if (Disabled) return; _aberto = true; _texto = ""; Refiltrar(); }
    private void Fechar() => _aberto = false;

    private void Refiltrar()
    {
        var palavras = DocEngine.Norm(_texto).Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var q = _todos.Where(i => palavras.All(w => DocEngine.Norm(i.Rotulo + " " + i.Sub).Contains(w)));
        var lista = q.OrderBy(i => DocEngine.Norm(i.Rotulo).StartsWith(string.Join(' ', palavras)) ? 0 : 1).ThenBy(i => i.Rotulo, StringComparer.OrdinalIgnoreCase).ToList();
        _total = lista.Count; _res = lista.Take(60).ToList(); _ativo = PodeCriar && _res.Count == 0 ? -1 : 0;
    }

    private async Task Escolher(ItemSel r) { _aberto = false; _atual = r; await ValueChanged.InvokeAsync(r.Id); }
    private async Task Limpar() { _aberto = false; _atual = null; await ValueChanged.InvokeAsync(""); }

    private async Task CriarNovo()
    {
        if (Criar is null) return;
        try
        {
            var id = await Criar(_texto.Trim());
            if (string.IsNullOrEmpty(id)) return;
            _aberto = false; await ValueChanged.InvokeAsync(id);
        }
        catch (Exception ex) { Sessao.Avisar(string.Join(" ", Ui.Erros(ex)), true); }
    }

    private async Task Tecla(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown": _ativo = Math.Min(_res.Count - 1, _ativo + 1); break;
            case "ArrowUp": _ativo = Math.Max(PodeCriar ? -1 : 0, _ativo - 1); break;
            case "Enter": if (_ativo == -1 || (_res.Count == 0 && PodeCriar)) await CriarNovo(); else if (_res.Count > 0) await Escolher(_res[Math.Clamp(_ativo, 0, _res.Count - 1)]); break;
            case "Escape": Fechar(); break;
        }
    }
}
