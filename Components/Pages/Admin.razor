    protected override async Task OnInitializedAsync()
    {
        _ator = await Sessao.AtorAsync();
        _aba = _ator.Pode(Perm.Administrar) ? "usr" : "aud"; Carregar();
        if (AbaQuery is "marca" or "apres" or "cfg" or "usr" or "aud" or "arm") _aba = AbaQuery;
        ApCarregar(); HowdenCarregar(); _alertas = string.Join(", ", Db.DiasAlerta); _fuso = Db.FusoPadrao; _horas = Db.ConfirmacaoValidadeHoras; _contatoGeo = Db.Cfg("geocoding_contato"); (_relPara, _relVenda) = Svc.DestinatariosRelatorio();
    }
    private void Carregar() { _usuarios = Db.Usuarios.Todos().OrderBy(u => u.Id).ToList(); _aud = Db.Auditorias.Todos().OrderByDescending(a => a.Quando).ToList(); }
    private IEnumerable<Auditoria> AudFiltrada => _aud.Where(a => (_fAcao == "" || a.Acao.StartsWith(_fAcao)) && (string.IsNullOrWhiteSpace(_buscaAud) || DocEngine.Norm($"{a.Usuario} {a.Acao} {a.Resumo}").Contains(DocEngine.Norm(_buscaAud))));

    // ---- endereço da Howden
    private bool _mapaH;
    private string _hNome = "", _hRua = "", _hCidade = "", _hEstado = "", _hPais = "", _hLat = "", _hLon = ""; private List<string>? _errosH;
    private void HowdenCarregar()
    {
        var h = Svc.Howden(); var ci = System.Globalization.CultureInfo.InvariantCulture;
        _hNome = h.nome; _hRua = Db.Cfg("howden_end_rua"); _hCidade = Db.Cfg("howden_end_cidade"); _hEstado = Db.Cfg("howden_end_estado"); _hPais = Db.Cfg("howden_end_pais", "Brasil");
        _hLat = h.lat?.ToString(ci) ?? ""; _hLon = h.lon?.ToString(ci) ?? "";
    }
    private static double? Num(string s) => double.TryParse(s.Replace(',', '.').Trim(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : null;
    private async Task HowdenNoMapa((double lat, double lon, string origem) x)
    {
        _errosH = null;
        try { await Svc.SalvarHowdenAsync(_ator, _hNome, _hRua, _hCidade, _hEstado, _hPais, x.lat, x.lon, null); HowdenCarregar(); Sessao.Avisar(L["Posição exata da Howden gravada."]); }
        catch (Exception ex) { _errosH = Ui.Erros(ex); }
    }

    private async Task SalvarHowden()
    {
        _errosH = null;
        try
        {
            // endereço igual e posição já exata: mantém a posição; endereço mudou: procura de novo (só aceita o endereço exato)
            var mesmoEndereco = _hRua == Db.Cfg("howden_end_rua") && _hCidade == Db.Cfg("howden_end_cidade") && _hEstado == Db.Cfg("howden_end_estado") && _hPais == Db.Cfg("howden_end_pais", "Brasil");
            var manter = mesmoEndereco && Snapshot.Exata(Db.Cfg("howden_nivel"));
            var r = await Svc.SalvarHowdenAsync(_ator, _hNome, _hRua, _hCidade, _hEstado, _hPais, manter ? Num(_hLat) : null, manter ? Num(_hLon) : null, Geo);
            HowdenCarregar();
            if (r is { Ok: false }) _errosH = new() { L.F("Endereço salvo, mas a posição exata não foi encontrada: {0}", L[r.Mensagem]) };
            else Sessao.Avisar(r is { Ok: true } ? L["Endereço salvo e encontrado no mapa no endereço exato."] : L["Endereço salvo."]);
        }
        catch (Exception ex) { _errosH = Ui.Erros(ex); }
    }

    // ---- apresentação automática
    private AutoEtapas.Cfg _ap = new(); private List<AutoEtapas.Etapa> _apOrdem = new();
    private void ApCarregar()
    {
        _ap = Svc.ApresentacaoAtual();
        // lista completa: as escolhidas primeiro (na ordem salva), depois as demais
        _apOrdem = _ap.Etapas.Select(AutoEtapas.De).Concat(AutoEtapas.Todas.Where(e => !_ap.Etapas.Contains(e.Chave))).ToList();
    }
    private void ApAlternar(string chave, bool on) { if (on) { if (!_ap.Etapas.Contains(chave)) _ap.Etapas.Add(chave); } else _ap.Etapas.Remove(chave); ApReordenar(); }
    private void ApLista(List<string> l, string chave, bool on) { if (on) { if (!l.Contains(chave)) l.Add(chave); } else l.Remove(chave); }
    private void ApMover(int i, int d) { var j = i + d; if (j < 0 || j >= _apOrdem.Count) return; (_apOrdem[i], _apOrdem[j]) = (_apOrdem[j], _apOrdem[i]); ApReordenar(); }
    private void ApReordenar() => _ap.Etapas = _apOrdem.Select(e => e.Chave).Where(_ap.Etapas.Contains).ToList();
    private void ApPadrao() { _ap = new AutoEtapas.Cfg(); _apOrdem = AutoEtapas.Todas.ToList(); _erros = null; }
    private void ApSalvar()
    {
        _erros = null;
        try { ApReordenar(); Svc.SalvarApresentacao(_ator, _ap); ApCarregar(); Sessao.Avisar(L["Configuração da apresentação salva."]); }
        catch (Exception ex) { _erros = Ui.Erros(ex); }
    }

    private void Compactar() { try { var n = Svc.CompactarAgora(_ator); Sessao.Avisar(L.F("{0} entidade(s) compactada(s).", n)); } catch (Exception ex) { Sessao.Avisar(string.Join(" ", Ui.Erros(ex).Select(x => L[x])), true); } }
    private void NovoUsuario() { _u = new Usuario { Papel = Roles.Consulta }; _novoU = true; _senha = ""; _erros = null; }
    private void EditarUsuario(Usuario u) { _u = u.Copia<Usuario>(); _novoU = false; _senha = ""; _erros = null; }
    private async Task FotoUsuario(InputFileChangeEventArgs e)
    {
        try { await using var st = e.File.OpenReadStream(Armazenamento.TamanhoMaximo); await Svc.DefinirFotoUsuarioAsync(_ator, _u!.Id, e.File.Name, st); _u.FotoAnexoId = Db.Usuarios.Obter(_u.Id)!.FotoAnexoId; Carregar(); Sessao.Avisar(L["Foto do usuário atualizada."]); }
        catch (Exception ex) { _erros = Ui.Erros(ex); }
    }
    private Usuario? _excluirU;
    private void ConfirmarExcluirUsuario()
    {
        _erros = null;
        try { var n = _excluirU!.Nome; Svc.ExcluirUsuario(_ator, _excluirU.Id); _excluirU = null; Carregar(); Sessao.Avisar(L.F("Usuário {0} excluído.", n)); }
        catch (Exception ex) { _erros = Ui.Erros(ex); }
    }
    private void SalvarUsuario() { try { Svc.SalvarUsuario(_ator, _u!, _senha); _u = null; Carregar(); Sessao.Avisar(L["Usuário salvo."]); } catch (Exception ex) { _erros = Ui.Erros(ex); } }
    private void AlternarBu(string bu, bool on)
    {
        var l = Ator.LerBus(_u!.Bus).ToList(); if (on) { if (!l.Contains(bu)) l.Add(bu); } else l.Remove(bu);
        _u.Bus = string.Join(",", Vocab.Bus.Select(b => b.Cod).Where(l.Contains));
    }
    private void SalvarRelatorio() { _errosRel = null; try { Svc.SalvarDestinatariosRelatorio(_ator, _relPara, _relVenda); Sessao.Avisar(L["Destinatários do relatório do serviço salvos."]); Carregar(); } catch (Exception ex) { _errosRel = Ui.Erros(ex); } }
    private void SalvarCfg() { _erros = null; try { Svc.SalvarConfig(_ator, _alertas, _fuso, _horas, _contatoGeo); Sessao.Avisar(L["Configurações salvas."]); Carregar(); } catch (Exception ex) { _erros = Ui.Erros(ex); } }
    private void ExecutarDados()
    {
        try { if (_confirma == "recarregar") Svc.RecarregarDemo(_ator); else Svc.LimparDadosOperacionais(_ator); _confirma = ""; Carregar(); Sessao.Avisar(L["Concluído."]); }
        catch (Exception ex) { _erros = Ui.Erros(ex); }
    }
