@page "/admin"
@attribute [Authorize(Roles = "admin,gestao")]
@inject Servicos Svc
@inject Db Db
@inject Geocoder Geo
@inject Rota Rt
@inject Sessao Sessao
@inject IConfiguration Cfg

<PageTitle>Administração · Controle Técnico</PageTitle>
<div class="page-head compacto"><div><h1>Administração</h1><p class="subtitle">Usuários e permissões, configurações, integrações e histórico de alterações.</p></div></div>

<div class="tabs" role="tablist">
    @if (_ator.Pode(Perm.Administrar))
    {
        <button class="tab @(_aba == "usr" ? "active" : "")" @onclick='() => _aba = "usr"'>Usuários e perfis</button>
        <button class="tab @(_aba == "cfg" ? "active" : "")" @onclick='() => _aba = "cfg"'>Configurações e integrações</button>
    }
    @if (_ator.Pode(Perm.Administrar) || _ator.Pode(Perm.EditarTecnicos)) { <button class="tab @(_aba == "apres" ? "active" : "")" @onclick='() => _aba = "apres"'>Apresentação</button> }
    @if (_ator.Pode(Perm.Administrar)) { <button class="tab @(_aba == "marca" ? "active" : "")" @onclick='() => _aba = "marca"'>Identidade visual</button> }
    @if (_ator.Pode(Perm.Administrar)) { <button class="tab @(_aba == "arm" ? "active" : "")" @onclick='() => _aba = "arm"'>Armazenamento</button> }
    <button class="tab @(_aba == "aud" ? "active" : "")" @onclick='() => _aba = "aud"'>Histórico de alterações</button>
    @if (_ator.Pode(Perm.Administrar)) { <button class="tab @(_aba == "demo" ? "active" : "")" @onclick='() => _aba = "demo"'>Dados</button> }
</div>

@if (_aba == "usr" && _ator.Pode(Perm.Administrar))
{
    <div class="toolbar"><span class="grow"></span><button class="btn-primary" @onclick="NovoUsuario">@Icons.Svg("plus")Novo usuário</button></div>
    <div class="table-wrap"><table class="grid-tbl">
        <thead><tr><th>Login</th><th>Nome</th><th>Perfil</th><th>Equipe de controle</th><th>Técnico vinculado</th><th>Situação</th><th></th></tr></thead>
        <tbody>
        @foreach (var u in _usuarios)
        {
            <tr><td><code>@u.Id</code></td><td>@u.Nome</td><td><span class="tag">@Roles.Label(u.Papel)</span></td><td>@if (u.EquipeControle) { <span class="badge st-info">@Icons.Svg("check", "bico")Sim</span> }</td><td>@Db.Tecnicos.Obter(u.TecnicoId)?.Nome</td>
                <td><span class="badge @(u.Ativo ? "st-pos" : "st-neutral")">@(u.Ativo ? "Ativo" : "Inativo")</span></td>
                <td class="right"><button class="row-act" @onclick="() => EditarUsuario(u)" title="Editar">@Icons.Svg("edit")</button></td></tr>
        }
        </tbody>
    </table></div>
    <div class="panel mt16">
        <div class="panel-head"><div class="panel-title">O que cada perfil pode fazer</div></div>
        <table class="grid-tbl matriz"><thead><tr><th>Permissão</th>@foreach (var r in Roles.All) { <th>@r.Label</th> }</tr></thead><tbody>
            @foreach (var (p, nome) in Matriz)
            {
                <tr><td>@nome</td>@foreach (var r in Roles.All) { var a = new Ator { Papel = r.Role }; <td class="c">@(a.Pode(p) ? "●" : r.Role == Roles.Tecnico && new Ator { Papel = r.Role, TecnicoId = "x" }.Pode(p, "x") ? "só o próprio" : "—")</td> }</tr>
            }
        </tbody></table>
        <p class="muted sm">As permissões são aplicadas no servidor em cada operação, não apenas na interface.</p>
    </div>
}
else if (_aba == "cfg" && _ator.Pode(Perm.Administrar))
{
    <div class="g12 top">
        <div class="c6"><div class="panel">
            <div class="panel-head"><div class="panel-title">Parâmetros</div></div>
            <div class="form-grid">
                <label class="fld full">Alertas antecipados de vencimento (dias, separados por vírgula)<input @bind="_alertas" /></label>
                <label class="fld">Fuso horário padrão da agenda<CampoLista Value="@_fuso" ValueChanged="@((string v) => { _fuso = v; })" Opcoes="@(Vocab.Fusos)" Placeholder="" Class="field" /></label>
                <label class="fld">Validade da localização confirmada (horas)<input type="number" min="1" @bind="_horas" /></label>
                <label class="fld full">E-mail de contato da geocodificação <span class="hint">opcional, recomendado pela política do serviço de mapas (Nominatim/OpenStreetMap)</span><input type="email" @bind="_contatoGeo" placeholder="ti@suaempresa.com" /></label>
            </div>
            @if (_erros is { Count: > 0 }) { <div class="alert-box alert-erro mt8">@Icons.Svg("alert")<div>@foreach (var e in _erros) { <div>@e</div> }</div></div> }
            <div class="modal-actions"><button class="btn-primary" @onclick="SalvarCfg">@Icons.Svg("check")Salvar</button></div>
        </div></div>
        <div class="c6"><div class="panel">
            <div class="panel-head"><div class="panel-title">Integrações externas</div></div>
            <p class="muted sm">Configuradas por ambiente (appsettings ou variáveis de ambiente). Segredos nunca ficam no código.</p>
            <table class="grid-tbl"><tbody>
                <tr><td><strong>Geocodificação (localizar plantas pelo endereço)</strong><div class="muted sm">Geocoding__Ativo · Geocoding__BaseUrl · Geocoding__Contato</div></td><td>@if (Geo.Configurado) { <span class="badge st-pos">Ativa</span> } else { <span class="badge st-warn">Desativada</span> }</td></tr>
                <tr><td><strong>Estimativa de rota (carro)</strong><div class="muted sm">Routing__BaseUrl (compatível com OSRM)</div></td><td>@if (Rt.Configurada) { <span class="badge st-pos">Ativa</span> } else { <span class="badge st-warn">Não configurada — informar manualmente</span> }</td></tr>
                <tr><td><strong>Camada do mapa</strong><div class="muted sm">Mapa__TileUrl · @Cfg["Mapa:TileUrl"]</div></td><td><span class="badge st-info">OpenStreetMap (público)</span></td></tr>
            </tbody></table>
        </div></div>
    </div>
    <div class="panel mt16" style="max-width:900px">
        <div class="panel-head"><div class="panel-title">@Icons.Svg("customers")Endereço da empresa (técnicos "na Howden")</div></div>
        <p class="muted sm">Quando um técnico não está em viagem ele aparece <strong>em casa</strong> (endereço da ficha) ou, se marcado, <strong>neste endereço</strong>. Em ambos os casos fica disponível.</p>
        <div class="form-grid g3">
            <label class="fld">Nome do local<input @bind="_hNome" maxlength="80" /></label>
            <label class="fld full">Endereço (rua, número, bairro)<input @bind="_hRua" /></label>
            <label class="fld">Cidade<input @bind="_hCidade" /></label>
            <label class="fld">Estado<input @bind="_hEstado" /></label>
            <label class="fld">País<input @bind="_hPais" /></label>
            <label class="fld">Latitude <span class="hint">opcional · vazio = localizar pelo endereço</span><input @bind="_hLat" placeholder="-19.9" /></label>
            <label class="fld">Longitude<input @bind="_hLon" placeholder="-43.9" /></label>
            <div class="fld">@if (Svc.Howden().lat is { } la) { <span class="tag ok">@Icons.Svg("pin")No mapa: @la.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture), @Svc.Howden().lon?.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture)</span> } else { <span class="tag neg">Sem coordenadas — os técnicos "na Howden" não aparecem no mapa</span> }</div>
        </div>
        @if (_errosH is { Count: > 0 }) { <div class="alert-box alert-erro mt8">@Icons.Svg("alert")<div>@foreach (var e in _errosH) { <div>@e</div> }</div></div> }
        <div class="modal-actions"><button class="btn-primary" @onclick="SalvarHowden">@Icons.Svg("check")Salvar endereço da empresa</button></div>
    </div>
}
else if (_aba == "aud")
{
    <div class="toolbar">
        <input class="field busca" placeholder="Filtrar por usuário, ação ou texto…" @bind="_buscaAud" @bind:event="oninput" />
        <select class="field w-auto" @bind="_fAcao"><option value="">Todas as ações</option>@foreach (var a in _aud.Select(x => x.Acao.Split('.')[0]).Distinct().OrderBy(x => x)) {<option>@a</option>}</select>
    </div>
    <div class="table-wrap"><table class="grid-tbl">
        <thead><tr><th>Quando</th><th>Quem</th><th>Ação</th><th>Detalhe</th></tr></thead>
        <tbody>
        @foreach (var a in AudFiltrada.Take(300))
        {
            <tr><td class="nowrap">@Tempo.Hora(a.Quando, Db.FusoPadrao, null, true)</td><td>@a.Usuario <span class="muted sm">(@Roles.Label(a.Papel))</span></td><td><code>@a.Acao</code></td><td>@a.Resumo</td></tr>
        }
        </tbody></table></div>
    <p class="muted sm">Exibindo as 300 mais recentes que atendem ao filtro (de @_aud.Count registros).</p>
}
else if (_aba == "apres" && (_ator.Pode(Perm.Administrar) || _ator.Pode(Perm.EditarTecnicos)))
{
    <p class="muted">Defina o que aparece (e em que ordem) quando alguém aperta <strong>Modo automático</strong> na Visão operacional. Vale para todos os usuários.</p>
    <div class="g12 top">
        <div class="c6"><div class="panel">
            <div class="panel-head"><div class="panel-title">Etapas e ordem</div></div>
            <ul class="ap-lista">
                @foreach (var (e, i) in _apOrdem.Select((e, i) => (e, i)))
                {
                    var on = _ap.Etapas.Contains(e.Chave);
                    <li class="@(on ? "" : "off")">
                        <input type="checkbox" checked="@on" @onchange="x => ApAlternar(e.Chave, (bool)x.Value!)" aria-label="Mostrar @e.Titulo" />
                        <span class="ap-ico" style="background:@e.Cor">@Icons.Svg(e.Icone)</span>
                        <span class="ap-nome"><strong>@e.Titulo</strong><small>@e.Sub</small></span>
                        <button class="icon-btn" disabled="@(i == 0)" @onclick="() => ApMover(i, -1)" aria-label="Subir">@Icons.Svg("up")</button>
                        <button class="icon-btn" disabled="@(i == _apOrdem.Count - 1)" @onclick="() => ApMover(i, 1)" aria-label="Descer">@Icons.Svg("down")</button>
                    </li>
                }
            </ul>
        </div></div>
        <div class="c6">
            <div class="panel">
                <div class="panel-head"><div class="panel-title">Indicadores gerenciais — o que mostrar</div></div>
                @foreach (var g in AutoEtapas.Graficos) { <label class="chk-inline ap-chk"><input type="checkbox" checked="@_ap.Graficos.Contains(g.Chave)" @onchange="x => ApLista(_ap.Graficos, g.Chave, (bool)x.Value!)" />@g.Rotulo</label> }
            </div>
            <div class="panel mt16">
                <div class="panel-head"><div class="panel-title">Agenda — visualizações</div></div>
                @foreach (var v in AutoEtapas.VistasAgenda) { <label class="chk-inline ap-chk"><input type="checkbox" checked="@_ap.Vistas.Contains(v.Chave)" @onchange="x => ApLista(_ap.Vistas, v.Chave, (bool)x.Value!)" />@v.Rotulo</label> }
            </div>
            <div class="panel mt16">
                <div class="panel-head"><div class="panel-title">Ritmo</div></div>
                <label class="fld">Velocidade ao iniciar<select @bind="_ap.Velocidade"><option value="lenta">Lenta</option><option value="normal">Normal</option><option value="rapida">Rápida</option></select></label>
                <label class="chk-inline ap-chk"><input type="checkbox" @bind="_ap.Repetir" />Repetir o ciclo continuamente (desmarque para encerrar ao fim)</label>
            </div>
        </div>
    </div>
    @if (_erros is { Count: > 0 }) { <div class="alert-box alert-erro mt16">@Icons.Svg("alert")<div>@foreach (var e in _erros) { <div>@e</div> }</div></div> }
    <div class="modal-actions" style="justify-content:flex-start;gap:10px">
        <button class="btn-primary" @onclick="ApSalvar">@Icons.Svg("check")Salvar apresentação</button>
        <button class="btn-ghost" @onclick="ApPadrao">Restaurar padrão</button>
        <a class="btn-ghost" href="/">@Icons.Svg("monitor")Ir para a Visão operacional</a>
    </div>
}
else if (_aba == "marca" && _ator.Pode(Perm.Administrar))
{
    <IdentidadeVisualPainel />
}
else if (_aba == "arm" && _ator.Pode(Perm.Administrar))
{
    var d = Svc.DiagnosticoArmazenamento(_ator);
    <div class="panel">
        <div class="panel-head"><div class="panel-title">Base de dados compartilhada</div>@if (d.Ok) { <span class="badge st-pos">@Icons.Svg("check", "bico")Leitura e escrita OK</span> } else { <span class="badge st-neg">@Icons.Svg("x", "bico")Problema de acesso</span> }</div>
        <dl class="ficha-dl">
            <dt>Pasta</dt><dd><code>@d.Pasta</code></dd>
            <dt>Pasta de rede</dt><dd>@(d.Rede ? "Sim" : "Não (pasta local)")</dd>
            <dt>Espelho local (leitura)</dt><dd>@(d.Espelho is null ? "não usado" : d.Espelho)</dd>
            <dt>Teste de gravação</dt><dd>@d.LatenciaMs ms @if (!string.IsNullOrEmpty(d.Mensagem)) { <span class="neg"> · @d.Mensagem</span> }</dd>
        </dl>
        <p class="muted sm">Cada gravação cria um arquivo pequeno na pasta da entidade; a compactação consolida os arquivos e move os antigos para <code>_historico</code> (30 dias).</p>
        <table class="grid-tbl"><thead><tr><th>Entidade</th><th>Arquivos na pasta</th></tr></thead><tbody>
            @foreach (var kv in d.Arquivos.OrderBy(k => k.Key)) { <tr><td>@kv.Key</td><td>@kv.Value</td></tr> }
        </tbody></table>
        <div class="modal-actions"><button class="btn-ghost" @onclick="Compactar">@Icons.Svg("layers")Compactar agora</button></div>
    </div>
}
else if (_aba == "demo" && _ator.Pode(Perm.Administrar))
{
    <div class="panel">
        <div class="panel-head"><div class="panel-title">Ambiente de demonstração</div></div>
        <p>Situação: @if (Db.Demo) { <span class="badge st-warn">Demonstração (dados fictícios)</span> } else { <span class="badge st-pos">Dados reais</span> }</p>
        <div class="imp-acoes">
            <button class="btn-ghost" @onclick="@(() => _confirma = "recarregar")">@Icons.Svg("refresh")Recarregar dados fictícios</button>
            <button class="btn-danger-ghost" @onclick="@(() => _confirma = "limpar")">@Icons.Svg("trash")Apagar todos os dados operacionais</button>
        </div>
        <p class="muted sm">Usuários e histórico de alterações são preservados. Apagar remove técnicos, clientes, plantas, viagens, documentos e anexos.</p>
    </div>
}

@if (_u is not null)
{
    <Dialogo Titulo="@(_novoU ? "Novo usuário" : "Editar usuário")" OnFechar="@(() => _u = null)" Erros="_erros">
        <div class="form-grid">
            <label class="fld">Login<input @bind="_u.Id" disabled="@(!_novoU)" /></label>
            <label class="fld">Nome<input @bind="_u.Nome" /></label>
            <label class="fld">Perfil<select @bind="_u.Papel">@foreach (var r in Roles.All) {<option value="@r.Role">@r.Label</option>}</select></label>
            <label class="fld chk"><input type="checkbox" @bind="_u.EquipeControle" />Equipe de controle de viagens <span class="hint">pode ser responsável por viagens e tem "Minhas viagens"</span></label>
            <label class="fld">Técnico vinculado <span class="hint">obrigatório para o perfil Técnico</span><select @bind="_u.TecnicoId"><option value="">—</option>@foreach (var t in Db.Tecnicos.Todos().OrderBy(t => t.Nome)) {<option value="@t.Id">@t.Nome</option>}</select></label>
            <label class="fld full">@(_novoU ? "Senha (mín. 8 caracteres)" : "Nova senha (deixe vazio para manter)")<input type="password" @bind="_senha" autocomplete="new-password" /></label>
            <label class="fld chk"><input type="checkbox" @bind="_u.Ativo" />Usuário ativo</label>
        </div>
        <div class="modal-actions"><button class="btn-ghost" @onclick="@(() => _u = null)">Cancelar</button><button class="btn-primary" @onclick="SalvarUsuario">@Icons.Svg("check")Salvar</button></div>
    </Dialogo>
}
@if (_confirma != "")
{
    <Dialogo Titulo="Confirmar" OnFechar="@(() => _confirma = "")" Erros="_erros">
        <p>@(_confirma == "recarregar" ? "Apagar os dados atuais e carregar novamente os dados fictícios?" : "Apagar TODOS os dados operacionais e anexos? Esta ação não pode ser desfeita.")</p>
        <div class="modal-actions"><button class="btn-ghost" @onclick="@(() => _confirma = "")">Cancelar</button><button class="btn-danger" @onclick="ExecutarDados">Confirmar</button></div>
    </Dialogo>
}

@code {
    [SupplyParameterFromQuery(Name = "aba")] public string? AbaQuery { get; set; }
    private Ator _ator = new(); private string _aba = "aud"; private List<Usuario> _usuarios = new(); private List<Auditoria> _aud = new();
    private List<string>? _erros; private Usuario? _u; private bool _novoU; private string _senha = "", _alertas = "", _fuso = "", _buscaAud = "", _fAcao = "", _confirma = ""; private int _horas; private string _contatoGeo = "";

    private static readonly (Perm, string)[] Matriz =
    {
        (Perm.VerEquipe, "Ver a equipe, mapa e agenda geral"), (Perm.VerContatos, "Ver telefone e e-mail dos técnicos"), (Perm.EditarTecnicos, "Cadastrar e editar técnicos"),
        (Perm.EditarClientes, "Cadastrar clientes e plantas / importar planilhas"), (Perm.EditarViagens, "Criar, alterar e cancelar viagens"), (Perm.VerReservas, "Ver códigos de reserva e anexos de viagens"),
        (Perm.EditarAgenda, "Lançar e reagendar compromissos e indisponibilidades"), (Perm.VerDocsStatus, "Ver situação e vencimento de documentos"), (Perm.VerDocsConteudo, "Ver / baixar arquivos de documentos"),
        (Perm.EditarDocs, "Cadastrar e renovar documentos"), (Perm.EditarRequisitos, "Configurar requisitos por serviço/planta"), (Perm.ConfirmarLocal, "Confirmar localização"),
        (Perm.VerAuditoria, "Ver histórico de alterações"), (Perm.Administrar, "Administrar usuários e configurações"),
    };

    protected override async Task OnInitializedAsync()
    {
        _ator = await Sessao.AtorAsync();
        _aba = _ator.Pode(Perm.Administrar) ? "usr" : "aud"; Carregar();
        if (AbaQuery is "marca" or "apres" or "cfg" or "usr" or "aud" or "arm" or "demo") _aba = AbaQuery;
        ApCarregar(); HowdenCarregar(); _alertas = string.Join(", ", Db.DiasAlerta); _fuso = Db.FusoPadrao; _horas = Db.ConfirmacaoValidadeHoras; _contatoGeo = Db.Cfg("geocoding_contato");
    }
    private void Carregar() { _usuarios = Db.Usuarios.Todos().OrderBy(u => u.Id).ToList(); _aud = Db.Auditorias.Todos().OrderByDescending(a => a.Quando).ToList(); }
    private IEnumerable<Auditoria> AudFiltrada => _aud.Where(a => (_fAcao == "" || a.Acao.StartsWith(_fAcao)) && (string.IsNullOrWhiteSpace(_buscaAud) || DocEngine.Norm($"{a.Usuario} {a.Acao} {a.Resumo}").Contains(DocEngine.Norm(_buscaAud))));

    // ---- endereço da Howden
    private string _hNome = "", _hRua = "", _hCidade = "", _hEstado = "", _hPais = "", _hLat = "", _hLon = ""; private List<string>? _errosH;
    private void HowdenCarregar()
    {
        var h = Svc.Howden(); var ci = System.Globalization.CultureInfo.InvariantCulture;
        _hNome = h.nome; _hRua = Db.Cfg("howden_end_rua"); _hCidade = Db.Cfg("howden_end_cidade"); _hEstado = Db.Cfg("howden_end_estado"); _hPais = Db.Cfg("howden_end_pais", "Brasil");
        _hLat = h.lat?.ToString(ci) ?? ""; _hLon = h.lon?.ToString(ci) ?? "";
    }
    private static double? Num(string s) => double.TryParse(s.Replace(',', '.').Trim(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : null;
    private async Task SalvarHowden()
    {
        _errosH = null;
        try
        {
            var la = Num(_hLat); var lo = Num(_hLon);
            if ((_hLat.Trim() != "" && la is null) || (_hLon.Trim() != "" && lo is null)) throw new ValidacaoException("Latitude/longitude inválidas (use ponto ou vírgula decimal).");
            var r = await Svc.SalvarHowdenAsync(_ator, _hNome, _hRua, _hCidade, _hEstado, _hPais, la, lo, Geo);
            HowdenCarregar();
            Sessao.Avisar(r is { Ok: false } ? "Endereço salvo, mas não foi possível localizá-lo: " + r.Mensagem : r is { Ok: true } ? $"Endereço salvo e localizado (nível: {r.Nivel})." : "Endereço salvo.", r is { Ok: false });
        }
        catch (Exception ex) { _errosH = Ui.Erros(ex); }
    }

    // ---- apresentação automática
    private AutoEtapas.Cfg _ap = new(); private List<AutoEtapas.Etapa> _apOrdem = new();
    private void ApCarregar()
    {
        _ap = Svc.ApresentacaoAtual();
        // lista completa: as escolhidas primeiro (na ordem salva), depois as demais
        _apOrdem = _ap.Etapas.Select(AutoEtapas.De).Concat(AutoEtapas.Todas.Where(e => !_ap.Etapas.Contains(e.Chave))).ToList();
    }
    private void ApAlternar(string chave, bool on) { if (on) { if (!_ap.Etapas.Contains(chave)) _ap.Etapas.Add(chave); } else _ap.Etapas.Remove(chave); ApReordenar(); }
    private void ApLista(List<string> l, string chave, bool on) { if (on) { if (!l.Contains(chave)) l.Add(chave); } else l.Remove(chave); }
    private void ApMover(int i, int d) { var j = i + d; if (j < 0 || j >= _apOrdem.Count) return; (_apOrdem[i], _apOrdem[j]) = (_apOrdem[j], _apOrdem[i]); ApReordenar(); }
    private void ApReordenar() => _ap.Etapas = _apOrdem.Select(e => e.Chave).Where(_ap.Etapas.Contains).ToList();
    private void ApPadrao() { _ap = new AutoEtapas.Cfg(); _apOrdem = AutoEtapas.Todas.ToList(); _erros = null; }
    private void ApSalvar()
    {
        _erros = null;
        try { ApReordenar(); Svc.SalvarApresentacao(_ator, _ap); ApCarregar(); Sessao.Avisar("Configuração da apresentação salva."); }
        catch (Exception ex) { _erros = Ui.Erros(ex); }
    }

    private void Compactar() { try { var n = Svc.CompactarAgora(_ator); Sessao.Avisar($"{n} entidade(s) compactada(s)."); } catch (Exception ex) { Sessao.Avisar(string.Join(" ", Ui.Erros(ex)), true); } }
    private void NovoUsuario() { _u = new Usuario { Papel = Roles.Consulta }; _novoU = true; _senha = ""; _erros = null; }
    private void EditarUsuario(Usuario u) { _u = u.Copia<Usuario>(); _novoU = false; _senha = ""; _erros = null; }
    private void SalvarUsuario() { try { Svc.SalvarUsuario(_ator, _u!, _senha); _u = null; Carregar(); Sessao.Avisar("Usuário salvo."); } catch (Exception ex) { _erros = Ui.Erros(ex); } }
    private void SalvarCfg() { _erros = null; try { Svc.SalvarConfig(_ator, _alertas, _fuso, _horas, _contatoGeo); Sessao.Avisar("Configurações salvas."); Carregar(); } catch (Exception ex) { _erros = Ui.Erros(ex); } }
    private void ExecutarDados()
    {
        try { if (_confirma == "recarregar") Svc.RecarregarDemo(_ator); else Svc.LimparDadosOperacionais(_ator); _confirma = ""; Carregar(); Sessao.Avisar("Concluído."); }
        catch (Exception ex) { _erros = Ui.Erros(ex); }
    }
}
