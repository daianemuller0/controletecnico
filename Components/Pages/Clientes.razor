@page "/clientes"
@attribute [Authorize]
@implements IDisposable
@inject Servicos Svc
@inject Db Db
@inject Importador Imp
@inject Geocoder Geo
@inject Sessao Sessao
@inject IJSRuntime JS
@inject IConfiguration Cfg

<PageTitle>Clientes e plantas · Controle Técnico</PageTitle>

<div class="page-head compacto">
    <div>
        <h1>Clientes e plantas</h1>
        <p class="subtitle">Cadastro dos clientes e das plantas/unidades de atendimento, com localização no mapa e importação por planilha.</p>
    </div>
    <div class="momento-ctl">
        @if (!Geo.Configurado)
        {
            <span class="tag warn" title="@Geo.Pendencia">Geocodificação não configurada</span>
        }
    </div>
</div>

<div class="tabs" role="tablist">
    <button role="tab" class="tab @(_aba == "plantas" ? "active" : "")" @onclick='() => _aba = "plantas"'>Plantas / unidades <span class="tab-badge">@_plantas.Count</span></button>
    <button role="tab" class="tab @(_aba == "clientes" ? "active" : "")" @onclick='() => _aba = "clientes"'>Clientes <span class="tab-badge">@_clientes.Count</span></button>
    @if (_pode)
    {
        <button role="tab" class="tab @(_aba == "importar" ? "active" : "")" @onclick='() => _aba = "importar"'>Importar planilha</button>
    }
</div>

@if (_aba == "clientes")
{
    <div class="toolbar">
        <input class="field busca" placeholder="Buscar cliente…" @bind="_buscaCli" @bind:event="oninput" aria-label="Buscar cliente" />
        <label class="chk-inline"><input type="checkbox" @bind="_soAtivosCli" />Somente ativos</label>
        <span class="grow"></span>
        @if (_pode) { <button class="btn-primary" @onclick="NovoCliente">@Icons.Svg("plus")Novo cliente</button> }
    </div>
    <div class="table-wrap"><table class="grid-tbl">
        <thead><tr><th>Cliente</th><th>Contato</th><th>Plantas</th><th>Situação</th><th></th></tr></thead>
        <tbody>
        @foreach (var c in ClientesFiltrados)
        {
            var np = _plantas.Count(p => p.ClienteId == c.Id);
            <tr>
                <td><strong>@c.Nome</strong>@if (!string.IsNullOrEmpty(c.RazaoSocial) && c.RazaoSocial != c.Nome) { <div class="muted sm">@c.RazaoSocial</div> }</td>
                <td>@c.Contato@if (!Sessao.Apresentacao && _ator.Pode(Perm.VerContatos)) { <div class="muted sm">@c.Telefone @c.Email</div> } else if (Sessao.Apresentacao) { <div class="muted sm">contato oculto</div> }</td>
                <td><button class="btn-link" @onclick="() => FiltrarPlantas(c.Id)">@np planta(s)</button></td>
                <td><span class="badge @(c.Ativo ? "st-pos" : "st-neutral")">@(c.Ativo ? "Ativo" : "Inativo")</span></td>
                <td class="right">@if (_pode) { <button class="row-act" title="Editar cliente" @onclick="() => EditarCliente(c)">@Icons.Svg("edit")</button> }</td>
            </tr>
        }
        </tbody>
    </table></div>
    @if (!ClientesFiltrados.Any()) { <div class="empty-state sm"><div class="ico">@Icons.Svg("customers")</div><h3>Nenhum cliente encontrado</h3></div> }
}
else if (_aba == "plantas")
{
    <div class="toolbar">
        <input class="field busca" placeholder="Buscar planta, cidade…" @bind="_buscaPl" @bind:event="oninput" aria-label="Buscar planta" />
        <select class="field w-auto" @bind="_fCli"><option value="">Todos os clientes</option>@foreach (var c in _clientes.OrderBy(c => c.Nome)) {<option value="@c.Id">@c.Nome</option>}</select>
        <select class="field w-auto" @bind="_fPais"><option value="">Todos os países</option>@foreach (var x in _plantas.Select(p => p.Pais).Distinct().OrderBy(x => x)) {<option>@x</option>}</select>
        <select class="field w-auto" @bind="_fGeo"><option value="">Qualquer localização</option><option value="ok">Localizada</option><option value="manual">Ajustada manualmente</option><option value="pendente">Localização pendente</option></select>
        <label class="chk-inline"><input type="checkbox" @bind="_soAtivosPl" />Somente ativas</label>
        <span class="grow"></span>
        @if (_pode)
        {
            @if (_plantas.Any(p => !p.TemCoord && p.GeoStatus != "manual") && Geo.Configurado)
            {
                <button class="btn-ghost" @onclick="LocalizarPendentes" disabled="@_localizando">@(_localizando ? "Localizando…" : $"Localizar pendentes ({_plantas.Count(p => !p.TemCoord)})")</button>
            }
            <button class="btn-primary" @onclick="NovaPlanta">@Icons.Svg("plus")Nova planta</button>
        }
    </div>
    @if (!string.IsNullOrEmpty(_msgGeo)) { <div class="alert-box alert-info">@Icons.Svg("info")<div>@_msgGeo</div></div> }
    <div class="table-wrap"><table class="grid-tbl">
        <thead><tr><th>Cliente</th><th>Planta / unidade</th><th>Local</th><th>Fuso</th><th>Localização</th><th>Situação</th><th></th></tr></thead>
        <tbody>
        @foreach (var p in PlantasFiltradas)
        {
            <tr>
                <td>@_clientes.FirstOrDefault(c => c.Id == p.ClienteId)?.Nome</td>
                <td><strong>@p.Nome</strong></td>
                <td>@p.Cidade@(string.IsNullOrEmpty(p.Estado) ? "" : "/" + p.Estado) · @p.Pais</td>
                <td class="muted sm">@p.FusoHorario</td>
                <td><GeoBadge P="p" /></td>
                <td><span class="badge @(p.Ativo ? "st-pos" : "st-neutral")">@(p.Ativo ? "Ativa" : "Inativa")</span></td>
                <td class="right nowrap">
                    <button class="row-act" title="@(_pode ? "Editar planta e corrigir localização" : "Ver planta")" @onclick="() => EditarPlanta(p)">@Icons.Svg(_pode ? "edit" : "eye")</button>
                </td>
            </tr>
        }
        </tbody>
    </table></div>
    @if (!PlantasFiltradas.Any()) { <div class="empty-state sm"><div class="ico">@Icons.Svg("pin")</div><h3>Nenhuma planta encontrada</h3><p>Cadastre uma planta ou importe uma planilha.</p></div> }
}
else if (_aba == "importar" && _pode)
{
    @* ---------------- importação ---------------- *@
    <div class="steps">
        @foreach (var (n, r) in new[] { (1, "Arquivo"), (2, "Colunas"), (3, "Prévia e validação"), (4, "Resultado") })
        { <span class="step @(_passo == n ? "on" : _passo > n ? "ok" : "")"><b>@n</b>@r</span> }
    </div>

    @if (_passo == 1)
    {
        <div class="panel">
            <div class="panel-head"><div class="panel-title">1. Escolha o arquivo</div></div>
            <p>Aceita <strong>.xlsx</strong> e <strong>.csv</strong> (até 10 MB e 5.000 linhas). Colunas principais: cliente, planta/unidade, rua, número, complemento, CEP, cidade, estado e país.</p>
            <div class="imp-acoes">
                <a class="btn-ghost" href="/modelo/plantas.xlsx" download>@Icons.Svg("download")Baixar planilha modelo</a>
                <label class="btn-primary file-btn">@Icons.Svg("upload")Selecionar arquivo<InputFile OnChange="AoArquivo" accept=".xlsx,.csv" class="sr-only" /></label>
            </div>
            @if (_lendo) { <p class="muted">@Icons.Svg("clock")Lendo o arquivo…</p> }
            @if (_errosImp is { Count: > 0 }) { <div class="alert-box alert-erro">@Icons.Svg("alert")<div>@foreach (var e in _errosImp) { <div>@e</div> }</div></div> }
        </div>
    }
    else if (_passo == 2 && _arq is not null)
    {
        <div class="panel">
            <div class="panel-head"><div class="panel-title">2. Mapeie as colunas</div><span class="tag">@_arq.Nome · @_arq.Linhas.Count linha(s)</span></div>
            <p class="muted">Conferimos os títulos do arquivo e sugerimos a correspondência. Ajuste o que estiver errado; colunas opcionais podem ficar sem mapeamento.</p>
            <div class="map-cols">
                @foreach (var c in Importador.Campos)
                {
                    <label class="fld">@c.Label @if (c.Obrigatorio) { <span class="neg">*</span> }
                        <select value="@(_map.TryGetValue(c.Key, out var ix) ? ix : -1)" @onchange="e => Mapear(c.Key, e.Value?.ToString())">
                            <option value="-1">— não importar —</option>
                            @for (var i = 0; i < _arq.Cabecalhos.Count; i++) { <option value="@i">@(string.IsNullOrWhiteSpace(_arq.Cabecalhos[i]) ? $"(coluna {i + 1})" : _arq.Cabecalhos[i])</option> }
                        </select></label>
                }
            </div>
            @if (_errosImp is { Count: > 0 }) { <div class="alert-box alert-erro">@Icons.Svg("alert")<div>@foreach (var e in _errosImp) { <div>@e</div> }</div></div> }
            <div class="modal-actions">
                <button class="btn-ghost" @onclick="ReiniciarImport">Voltar</button>
                <button class="btn-primary" @onclick="Analisar">Validar e ver prévia @Icons.Svg("arrow-right")</button>
            </div>
        </div>
    }
    else if (_passo == 3)
    {
        var rej = _linhas.Count(l => l.Rejeitada); var exist = _linhas.Count(l => l.Existente && !l.Rejeitada);
        var novas = _linhas.Count(l => !l.Existente && !l.Rejeitada); var avisos = _linhas.Count(l => l.Avisos.Count > 0 && !l.Rejeitada);
        <div class="panel">
            <div class="panel-head"><div class="panel-title">3. Prévia e validação</div><span class="tag">@_linhas.Count linha(s)</span></div>
            <div class="imp-resumo">
                <div class="imp-n pos"><b>@novas</b>novas</div>
                <div class="imp-n warn"><b>@exist</b>já cadastradas</div>
                <div class="imp-n neg"><b>@rej</b>com erro (serão rejeitadas)</div>
                <div class="imp-n"><b>@avisos</b>com aviso</div>
            </div>
            @if (exist > 0)
            {
                <div class="toolbar">
                    <span><strong>Plantas já cadastradas:</strong></span>
                    <select class="field w-auto" @onchange="e => AplicarPadrao(e.Value?.ToString())">
                        <option value="Atualizar">Atualizar o cadastro existente (somente campos preenchidos)</option>
                        <option value="Ignorar">Ignorar (manter o cadastro como está)</option>
                        <option value="Criar">Criar nova com nome diferenciado</option>
                    </select>
                    <span class="muted sm">Você pode mudar linha a linha abaixo. Nada é substituído sem aparecer aqui.</span>
                </div>
            }
            <div class="toolbar"><label class="chk-inline"><input type="checkbox" @bind="_soProblemas" />Mostrar só linhas com erro, aviso ou duplicidade</label></div>
            <div class="table-wrap prev-wrap"><table class="grid-tbl">
                <thead><tr><th>Linha</th><th>Cliente</th><th>Planta</th><th>Local</th><th>Situação</th><th>Ação</th></tr></thead>
                <tbody>
                @foreach (var l in _linhas.Where(l => !_soProblemas || l.Rejeitada || l.Existente || l.Avisos.Count > 0))
                {
                    <tr class="@(l.Rejeitada ? "lin-erro" : "")">
                        <td>@l.Numero</td><td>@l.Cliente</td><td>@l.Planta</td>
                        <td>@l.V["cidade"]@(string.IsNullOrEmpty(l.V["estado"]) ? "" : "/" + l.V["estado"]) · @l.V["pais"]</td>
                        <td>
                            @if (l.Rejeitada) { <span class="badge st-neg">@Icons.Svg("x", "bico")Erro</span> @foreach (var e in l.Erros) { <div class="sm neg">@e</div> } }
                            else if (l.Existente) { <span class="badge st-warn">@Icons.Svg("copy", "bico")Já cadastrada</span>
                                @if (l.Diferencas.Count > 0) { <ul class="difs">@foreach (var d in l.Diferencas) { <li>@d</li> }</ul> } }
                            else { <span class="badge st-pos">@Icons.Svg("plus", "bico")Nova</span> }
                            @foreach (var a in l.Avisos) { <div class="sm warn">@a</div> }
                        </td>
                        <td>
                            @if (l.Rejeitada) { <span class="muted">Rejeitada</span> }
                            else if (l.Existente)
                            {
                                <select class="field w-auto" @bind="l.Acao"><option value="@AcaoImport.Atualizar">Atualizar</option><option value="@AcaoImport.Ignorar">Ignorar</option><option value="@AcaoImport.Criar">Criar nova</option></select>
                            }
                            else { <span class="muted">Criar</span> }
                        </td>
                    </tr>
                }
                </tbody>
            </table></div>
            <div class="modal-actions">
                <button class="btn-ghost" @onclick="@(() => _passo = 2)">Voltar</button>
                <button class="btn-primary" @onclick="ConfirmarImport" disabled="@(_linhas.All(l => l.Rejeitada || l.Acao == AcaoImport.Ignorar))">@Icons.Svg("check")Confirmar importação</button>
            </div>
            @if (_errosImp is { Count: > 0 }) { <div class="alert-box alert-erro">@Icons.Svg("alert")<div>@foreach (var e in _errosImp) { <div>@e</div> }</div></div> }
        </div>
    }
    else if (_passo == 4 && _res is not null)
    {
        <div class="panel">
            <div class="panel-head"><div class="panel-title">4. Resultado da importação</div></div>
            <div class="imp-resumo">
                <div class="imp-n pos"><b>@_res.Importadas</b>importadas</div>
                <div class="imp-n info"><b>@_res.Atualizadas</b>atualizadas</div>
                <div class="imp-n"><b>@_res.Ignoradas</b>ignoradas</div>
                <div class="imp-n neg"><b>@_res.Rejeitadas.Count</b>rejeitadas</div>
                <div class="imp-n"><b>@_res.ClientesCriados</b>clientes novos</div>
            </div>
            @if (_res.Rejeitadas.Count > 0)
            {
                <h3 class="sec">@Icons.Svg("alert")Linhas rejeitadas e motivos</h3>
                <div class="table-wrap"><table class="grid-tbl"><thead><tr><th>Linha</th><th>Cliente</th><th>Planta</th><th>Motivo</th></tr></thead><tbody>
                    @foreach (var e in _res.Rejeitadas) { <tr><td>@e.linha</td><td>@e.cliente</td><td>@e.planta</td><td class="neg">@e.motivo</td></tr> }
                </tbody></table></div>
                <button class="btn-ghost mt8" @onclick="BaixarErros">@Icons.Svg("download")Baixar lista de erros (CSV)</button>
            }
            @if (_res.Avisos.Count > 0)
            {
                <h3 class="sec">@Icons.Svg("info")Avisos</h3>
                <ul class="difs">@foreach (var a in _res.Avisos) { <li>Linha @a.linha: @a.detalhe</li> }</ul>
            }
            <p class="muted mt16">As plantas novas ficam como <strong>localização pendente</strong> até serem localizadas pelo endereço ou posicionadas no mapa.</p>
            <div class="modal-actions">
                <button class="btn-ghost" @onclick="ReiniciarImport">Nova importação</button>
                <button class="btn-primary" @onclick="@(() => { _aba = "plantas"; _fGeo = ""; ReiniciarImport(); })">Ver plantas</button>
            </div>
        </div>
    }
}

@* ---------------- diálogos ---------------- *@
@if (_cli is not null)
{
    <Dialogo Titulo="@(string.IsNullOrEmpty(_cli.Id) ? "Novo cliente" : "Editar cliente")" OnFechar="@(() => _cli = null)" Erros="_erros">
        <div class="form-grid">
            <label class="fld full">Nome do cliente *<input @bind="_cli.Nome" /></label>
            <label class="fld">Razão social<input @bind="_cli.RazaoSocial" /></label>
            <label class="fld">Documento <span class="hint">opcional</span><input @bind="_cli.Documento" /></label>
            <label class="fld">Contato responsável<input @bind="_cli.Contato" /></label>
            <label class="fld">Telefone<input @bind="_cli.Telefone" /></label>
            <label class="fld full">E-mail<input type="email" @bind="_cli.Email" /></label>
            <label class="fld full">Observações<textarea @bind="_cli.Obs"></textarea></label>
            <label class="fld chk"><input type="checkbox" @bind="_cli.Ativo" />Cliente ativo</label>
        </div>
        <div class="modal-actions"><button class="btn-ghost" @onclick="@(() => _cli = null)">Cancelar</button><button class="btn-primary" @onclick="SalvarCliente">@Icons.Svg("check")Salvar</button></div>
    </Dialogo>
}

@if (_pl is not null)
{
    <Dialogo Titulo="@(string.IsNullOrEmpty(_pl.Id) ? "Nova planta / unidade" : _pode ? "Editar planta / unidade" : "Planta / unidade")" Largo="true" OnFechar="FecharPlanta" Erros="_erros">
        <fieldset disabled="@(!_pode)" class="semborda">
        <div class="pl-grid">
            <div>
                <div class="form-grid">
                    <label class="fld">Cliente *<select @bind="_pl.ClienteId"><option value="">— selecione —</option>@foreach (var c in _clientes.OrderBy(c => c.Nome)) {<option value="@c.Id">@c.Nome</option>}</select></label>
                    <label class="fld">Nome da planta / unidade *<input @bind="_pl.Nome" /></label>
                    <label class="fld">País *<input list="lista-paises" @bind="_pl.Pais" /></label>
                    <label class="fld">Estado / região<input @bind="_pl.Estado" /></label>
                    <label class="fld">Cidade<input @bind="_pl.Cidade" /></label>
                    <label class="fld">CEP / código postal<input @bind="_pl.Cep" /></label>
                    <label class="fld">Rua<input @bind="_pl.Rua" /></label>
                    <label class="fld">Número<input @bind="_pl.Numero" /></label>
                    <label class="fld full">Complemento<input @bind="_pl.Complemento" /></label>
                    <label class="fld full">Endereço completo <span class="hint">vazio = montado a partir dos campos acima; use para formatos internacionais</span><input @bind="_pl.EnderecoCompleto" placeholder="@Servicos.MontarEndereco(_pl)" /></label>
                    <label class="fld">Fuso horário *<select @bind="_pl.FusoHorario">@foreach (var f in Vocab.Fusos.Concat(new[] { _pl.FusoHorario }).Distinct()) {<option>@f</option>}</select></label>
                    <label class="fld">Contato local<input @bind="_pl.ContatoLocal" /></label>
                    <label class="fld full">Informações de acesso<input @bind="_pl.Acesso" placeholder="Portaria, EPIs, integração…" /></label>
                    <label class="fld full">Observações<textarea @bind="_pl.Obs"></textarea></label>
                    <label class="fld chk"><input type="checkbox" @bind="_pl.Ativo" />Planta ativa</label>
                </div>
                <datalist id="lista-paises">@foreach (var p in Vocab.Paises) {<option value="@p"></option>}</datalist>
            </div>
            <div>
                <div class="loc-estado"><GeoBadge P="_pl" /><span class="muted sm">@_pl.GeoFonte</span></div>
                <div class="form-grid mt8">
                    <label class="fld">Latitude<input type="number" step="0.000001" value="@_lat" @onchange="e => MudarCoord(e.Value?.ToString(), true)" /></label>
                    <label class="fld">Longitude<input type="number" step="0.000001" value="@_lon" @onchange="e => MudarCoord(e.Value?.ToString(), false)" /></label>
                </div>
                <div id="mapa-planta" class="mapa mapa-pl" role="application" aria-label="Mapa para posicionar a planta"></div>
                <p class="muted sm">Clique no mapa ou arraste o marcador para corrigir a posição. A posição corrigida fica gravada como <strong>ajustada manualmente</strong> e não é sobrescrita pela consulta de endereço.</p>
                @if (_pode)
                {
                    <button class="btn-ghost sm" @onclick="LocalizarEndereco" disabled="@(!Geo.Configurado || _localizando)" title="@(Geo.Configurado ? "Consulta o endereço e guarda as coordenadas" : Geo.Pendencia)">@Icons.Svg("search")Localizar pelo endereço</button>
                    @if (!Geo.Configurado) { <div class="alert-box alert-aviso mt8">@Icons.Svg("alert")<div>@Geo.Pendencia</div></div> }
                    @if (!string.IsNullOrEmpty(_msgGeoPl)) { <div class="alert-box alert-info mt8">@Icons.Svg("info")<div>@_msgGeoPl</div></div> }
                }
            </div>
        </div>
        </fieldset>
        <div class="modal-actions">
            <button class="btn-ghost" @onclick="FecharPlanta">@(_pode ? "Cancelar" : "Fechar")</button>
            @if (_pode) { <button class="btn-primary" @onclick="SalvarPlanta" disabled="@_salvando">@Icons.Svg("check")Salvar</button> }
        </div>
    </Dialogo>
}

@code {
    private Ator _ator = new(); private bool _pode;
    private List<Cliente> _clientes = new(); private List<Planta> _plantas = new();
    private string _aba = "plantas";
    private string _buscaCli = "", _buscaPl = "", _fCli = "", _fPais = "", _fGeo = ""; private bool _soAtivosCli, _soAtivosPl;
    private List<string>? _erros; private Cliente? _cli; private Planta? _pl; private bool _salvando, _localizando;
    private string? _msgGeo, _msgGeoPl; private string _lat = "", _lon = "";
    private DotNetObjectReference<Clientes>? _ref; private bool _mapaPlantaPronto; private string? _mapaPlantaId;

    protected override async Task OnInitializedAsync()
    {
        _ator = await Sessao.AtorAsync(); _pode = _ator.Pode(Perm.EditarClientes);
        _ref = DotNetObjectReference.Create(this);
        Sessao.Mudou += Ao;
        Carregar();
    }
    private void Ao() => InvokeAsync(StateHasChanged);

    private void Carregar()
    {
        _clientes = Db.Clientes.Todos(); _plantas = Db.Plantas.Todos();
    }

    private IEnumerable<Cliente> ClientesFiltrados => _clientes.Where(c => (!_soAtivosCli || c.Ativo) &&
        (string.IsNullOrWhiteSpace(_buscaCli) || DocEngine.Norm(c.Nome + " " + c.RazaoSocial).Contains(DocEngine.Norm(_buscaCli)))).OrderBy(c => c.Nome);

    private IEnumerable<Planta> PlantasFiltradas => _plantas.Where(p => (!_soAtivosPl || p.Ativo)
        && (string.IsNullOrEmpty(_fCli) || p.ClienteId == _fCli) && (string.IsNullOrEmpty(_fPais) || p.Pais == _fPais)
        && (string.IsNullOrEmpty(_fGeo) || (_fGeo == "pendente" ? !p.TemCoord : p.TemCoord && p.GeoStatus == _fGeo))
        && (string.IsNullOrWhiteSpace(_buscaPl) || DocEngine.Norm($"{p.Nome} {p.Cidade} {p.Estado} {p.Pais} {_clientes.FirstOrDefault(c => c.Id == p.ClienteId)?.Nome}").Contains(DocEngine.Norm(_buscaPl))))
        .OrderBy(p => _clientes.FirstOrDefault(c => c.Id == p.ClienteId)?.Nome).ThenBy(p => p.Nome);

    private void FiltrarPlantas(string cli) { _fCli = cli; _aba = "plantas"; }

    // ------------------------------------------------------ clientes
    private void NovoCliente() { _cli = new Cliente(); _erros = null; }
    private void EditarCliente(Cliente c) { _cli = c; _erros = null; }
    private void SalvarCliente()
    {
        try { Svc.SalvarCliente(_ator, _cli!); _cli = null; Carregar(); Sessao.Avisar("Cliente salvo."); }
        catch (Exception ex) { _erros = Ui.Erros(ex); }
    }

    // ------------------------------------------------------ plantas
    private void NovaPlanta()
    {
        _pl = new Planta { ClienteId = _fCli, Pais = "Brasil" }; _lat = _lon = ""; _erros = null; _msgGeoPl = null; _mapaPlantaPronto = false;
    }
    private void EditarPlanta(Planta p)
    {
        _pl = p; _lat = p.Lat?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? ""; _lon = p.Lon?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";
        _erros = null; _msgGeoPl = null; _mapaPlantaPronto = false;
    }
    private async Task FecharPlanta()
    {
        _pl = null; _mapaPlantaPronto = false;
        try { await JS.InvokeVoidAsync("app.mapa.destruir", "mapa-planta"); } catch { }
    }

    private static double? Num(string? s) =>
        double.TryParse((s ?? "").Replace(',', '.'), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : null;

    private async Task MudarCoord(string? v, bool lat)
    {
        if (lat) _lat = v ?? ""; else _lon = v ?? "";
        if (_pl is null) return;
        _pl.Lat = Num(_lat); _pl.Lon = Num(_lon);
        if (_pl.TemCoord) { _pl.GeoStatus = "manual"; _pl.GeoFonte = "Posição informada manualmente"; await JS.InvokeVoidAsync("app.mapa.definir", "mapa-planta", _pl.Lat, _pl.Lon); }
    }

    [JSInvokable]
    public async Task AoMover(double lat, double lon)
    {
        if (_pl is null) return;
        _pl.Lat = Math.Round(lat, 6); _pl.Lon = Math.Round(lon, 6); _pl.GeoStatus = "manual"; _pl.GeoFonte = "Posição corrigida manualmente no mapa";
        _lat = _pl.Lat.Value.ToString(System.Globalization.CultureInfo.InvariantCulture); _lon = _pl.Lon.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pl is not null && !_mapaPlantaPronto)
        {
            _mapaPlantaPronto = true;
            try
            {
                await JS.InvokeVoidAsync("app.mapa.escolher", "mapa-planta", _ref, _pl.Lat, _pl.Lon, new { centro = new[] { -15.0, -52.0 }, tileUrl = Cfg["Mapa:TileUrl"], atribuicao = Cfg["Mapa:Atribuicao"] });
            }
            catch { }
        }
    }

    private async Task LocalizarEndereco()
    {
        if (_pl is null) return;
        _localizando = true; _msgGeoPl = null; StateHasChanged();
        var end = string.IsNullOrWhiteSpace(_pl.EnderecoCompleto) ? Servicos.MontarEndereco(_pl) : _pl.EnderecoCompleto;
        var r = await Geo.BuscarAsync(end, _pl.Pais);
        _localizando = false;
        if (r.Ok)
        {
            _pl.Lat = r.Lat; _pl.Lon = r.Lon; _pl.GeoStatus = "ok"; _pl.GeoFonte = r.Fonte; _pl.GeoEm = DateTime.UtcNow;
            _lat = r.Lat!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture); _lon = r.Lon!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
            _msgGeoPl = $"Endereço localizado. Revise a posição no mapa. ({r.Mensagem})";
            await JS.InvokeVoidAsync("app.mapa.definir", "mapa-planta", _pl.Lat, _pl.Lon);
        }
        else _msgGeoPl = r.Mensagem + " Você pode salvar assim (localização pendente) ou posicionar manualmente no mapa.";
    }

    private async Task SalvarPlanta()
    {
        if (_pl is null) return;
        _salvando = true; _erros = null;
        try
        {
            var antes = Db.Plantas.Obter(_pl.Id);
            // o formulário já reflete a posição escolhida; só consulta endereço se algo mudou e não há posição manual
            await Svc.SalvarPlantaAsync(_ator, _pl, Geo);
            await FecharPlanta(); Carregar();
            Sessao.Avisar(_plantas.FirstOrDefault(p => p.Nome == _pl?.Nome) is null ? "Planta salva." : "Planta salva.");
        }
        catch (Exception ex) { _erros = Ui.Erros(ex); }
        _salvando = false;
    }

    private async Task LocalizarPendentes()
    {
        _localizando = true; _msgGeo = "Consultando endereços (1 por segundo)…"; StateHasChanged();
        try
        {
            var (ok, falhas) = await Svc.LocalizarPendentesAsync(_ator, Geo);
            _msgGeo = $"Localização concluída: {ok} localizada(s), {falhas} continuam pendentes (endereço não encontrado). Posicione-as manualmente no mapa.";
            Carregar();
        }
        catch (Exception ex) { _msgGeo = string.Join(" ", Ui.Erros(ex)); }
        _localizando = false;
    }

    // ------------------------------------------------------ importação
    private int _passo = 1; private ArquivoLido? _arq; private Dictionary<string, int> _map = new();
    private List<LinhaImport> _linhas = new(); private ResultadoImport? _res; private bool _lendo, _soProblemas;
    private List<string>? _errosImp;

    private async Task AoArquivo(InputFileChangeEventArgs e)
    {
        _errosImp = null; _lendo = true; StateHasChanged();
        try
        {
            await using var s = e.File.OpenReadStream(Importador.MaxBytes);
            using var ms = new MemoryStream(); await s.CopyToAsync(ms); ms.Position = 0;
            _arq = Importador.Ler(e.File.Name, ms);
            _map = Importador.SugerirMapeamento(_arq.Cabecalhos);
            _passo = 2;
        }
        catch (Exception ex) { _errosImp = Ui.Erros(ex); }
        _lendo = false;
    }

    private void Mapear(string key, string? v)
    {
        if (int.TryParse(v, out var i) && i >= 0) _map[key] = i; else _map.Remove(key);
    }

    private void Analisar()
    {
        _errosImp = null;
        try { _linhas = Imp.Analisar(_arq!, _map); _passo = 3; }
        catch (Exception ex) { _errosImp = Ui.Erros(ex); }
    }

    private void AplicarPadrao(string? acao)
    {
        var a = acao switch { "Ignorar" => AcaoImport.Ignorar, "Criar" => AcaoImport.Criar, _ => AcaoImport.Atualizar };
        foreach (var l in _linhas.Where(l => l.Existente && !l.Rejeitada)) l.Acao = a;
    }

    private void ConfirmarImport()
    {
        _errosImp = null;
        try { _res = Imp.Aplicar(_ator, _linhas); _passo = 4; Carregar(); Sessao.Avisar("Importação concluída."); }
        catch (Exception ex) { _errosImp = Ui.Erros(ex); }
    }

    private void ReiniciarImport() { _passo = 1; _arq = null; _linhas = new(); _res = null; _errosImp = null; _map = new(); }

    private async Task BaixarErros()
    {
        if (_res is null) return;
        await JS.InvokeVoidAsync("app.baixarTexto", "erros_importacao.csv", "text/csv;charset=utf-8", Importador.ErrosCsvTexto(_res), true);
    }

    public void Dispose() { Sessao.Mudou -= Ao; try { _ = JS.InvokeVoidAsync("app.mapa.destruir", "mapa-planta"); } catch { } _ref?.Dispose(); }
}
