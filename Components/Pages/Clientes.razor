@page "/clientes"
@attribute [Authorize]
@implements IDisposable
@inject Servicos Svc
@inject Db Db
@inject Importador Imp
@inject Geocoder Geo
@inject GeocodificacaoJob Job
@inject BuscaPlantas Busca
@inject Sessao Sessao
@inject IJSRuntime JS
@inject IConfiguration Cfg

<PageTitle>@L["Clientes e plantas"] · Controle Técnico</PageTitle>

<div class="page-head compacto">
    <div>
        <h1>@L["Clientes e plantas"]</h1>
        <p class="subtitle">@L["Cadastro dos clientes e das plantas/unidades de atendimento, com localização no mapa e importação por planilha."]</p>
    </div>
    <div class="momento-ctl">
        @if (!Geo.Configurado)
        {
            <span class="tag warn" title="@L[Geo.Pendencia]">@L["Geocodificação desativada"]</span>
        }
    </div>
</div>

<div class="tabs" role="tablist">
    <button role="tab" class="tab @(_aba == "plantas" ? "active" : "")" @onclick='() => _aba = "plantas"'>@L["Plantas / unidades"] <span class="tab-badge">@_plantas.Count</span></button>
    <button role="tab" class="tab @(_aba == "clientes" ? "active" : "")" @onclick='() => _aba = "clientes"'>@L["Clientes"] <span class="tab-badge">@_clientes.Count</span></button>
    @if (_pode)
    {
        <button role="tab" class="tab @(_aba == "importar" ? "active" : "")" @onclick='() => _aba = "importar"'>@L["Importar planilha"]</button>
    }
</div>

@if (_aba == "clientes")
{
    <div class="toolbar">
        <input class="field busca" placeholder="@L["Buscar cliente…"]" @bind="_buscaCli" @bind:event="oninput" aria-label="@L["Buscar cliente"]" />
        <label class="chk-inline"><input type="checkbox" @bind="_soAtivosCli" />@L["Somente ativos"]</label>
        <span class="grow"></span>
        @if (_pode) { <button class="btn-primary" @onclick="NovoCliente">@Icons.Svg("plus")@L["Novo cliente"]</button> }
    </div>
    <div class="table-wrap"><table class="grid-tbl">
        <thead><tr><th>@L["Cliente"]</th><th>@L["Contato"]</th><th>@L["Plantas"]</th><th>@L["Situação"]</th><th></th></tr></thead>
        <tbody>
        @foreach (var c in ClientesFiltrados)
        {
            var np = _plantas.Count(p => p.ClienteId == c.Id);
            <tr>
                <td><strong>@c.Nome</strong>@if (!string.IsNullOrEmpty(c.RazaoSocial) && c.RazaoSocial != c.Nome) { <div class="muted sm">@c.RazaoSocial</div> }</td>
                <td>@c.Contato@if (!Sessao.Apresentacao && _ator.Pode(Perm.VerContatos)) { <div class="muted sm">@c.Telefone @c.Email</div> } else if (Sessao.Apresentacao) { <div class="muted sm">@L["contato oculto"]</div> }</td>
                <td><button class="btn-link" @onclick="() => FiltrarPlantas(c.Id)">@L.F("{0} planta(s)", np)</button></td>
                <td><span class="badge @(c.Ativo ? "st-pos" : "st-neutral")">@(c.Ativo ? L["Ativo"] : L["Inativo"])</span></td>
                <td class="right">@if (_pode) { <button class="row-act" title="@L["Editar cliente"]" @onclick="() => EditarCliente(c)">@Icons.Svg("edit")</button> }</td>
            </tr>
        }
        </tbody>
    </table></div>
    @if (!ClientesFiltrados.Any()) { <div class="empty-state sm"><div class="ico">@Icons.Svg("customers")</div><h3>@L["Nenhum cliente encontrado"]</h3></div> }
}
else if (_aba == "plantas")
{
    <div class="pl-topo">
        <div class="pl-busca">
            @Icons.Svg("search")
            <input id="busca-plantas" placeholder="@L.F("Buscar entre {0} plantas: nome, cidade, estado, país, cliente ou endereço…", _plantas.Count.ToString("N0"))" @bind="_buscaPl" @bind:event="oninput" @bind:after="Refiltrar" aria-label="@L["Buscar planta"]" autocomplete="off" />
            @if (!string.IsNullOrEmpty(_buscaPl)) { <button class="sel-x" @onclick="@(() => { _buscaPl = ""; Refiltrar(); })" aria-label="@L["Limpar busca"]">@Icons.Svg("x")</button> }
            <kbd title="@L["Atalho: tecla / para buscar"]">/</kbd>
        </div>
        <div class="pl-acoes">
            @if (_pode)
            {
                @if (Geo.Configurado && !Job.Rodando && _plantas.Any(p => !p.TemCoord && p.GeoStatus != "manual"))
                {
                    <button class="btn-ghost" @onclick="IniciarJob">@Icons.Svg("pin")@L["Localizar pendentes"] (@_plantas.Count(p => !p.TemCoord && p.GeoStatus != "manual"))</button>
                }
                @if (Geo.Configurado && !Job.Rodando && Job.Aproximadas() is > 0 and var nAp)
                {
                    <button class="btn-ghost" @onclick="ReconferirJob" title="@L["Busca de novo o endereço exato das plantas posicionadas só pela cidade (não piora nenhuma)"]">@Icons.Svg("refresh")@L["Reconferir aproximadas"] (@nAp)</button>
                }
                <button class="btn-primary" @onclick="NovaPlanta">@Icons.Svg("plus")@L["Nova planta"]</button>
            }
        </div>
    </div>
    <div class="pl-chips">
        @foreach (var (k, r, ic) in Chips)
        {
            <button class="pl-chip @(_chip == k ? "on" : "") c-@(k == "" ? "todas" : k)" @onclick="() => { _chip = k; _pagPl = 0; Refiltrar(); }">@Icons.Svg(ic)@L[r] <b>@_cont.GetValueOrDefault(k).ToString("N0")</b></button>
        }
        <span class="grow"></span>
        <label class="chk-inline"><input type="checkbox" @bind="_soAtivosPl" @bind:after="Refiltrar" />@L["Somente ativas"]</label>
    </div>
    <div class="pl-filtros">
        <label class="flt"><span class="flt-label">@L["Cliente"]</span><SeletorLista Itens="@(_clientes.OrderBy(c => c.Nome).Select(c => new SeletorLista.ItemSel(c.Id, c.Nome)))" Value="@_fCli" ValueChanged="@(async (string v) => { _fCli = v; Refiltrar(); })" Placeholder="@L["Todos"]" /></label>
        <label class="flt"><span class="flt-label">@L["País"]</span><CampoLista Value="@_fPais" ValueChanged="@((string v) => { _fPais = v; Refiltrar(); })" Opcoes="@(_paises)" Placeholder="@L["Todos"]" Class="field" /></label>
        <label class="flt"><span class="flt-label">@L["Estado"]</span><CampoLista Value="@_fUf" ValueChanged="@((string v) => { _fUf = v; Refiltrar(); })" Opcoes="@(_ufs)" Placeholder="@L["Todos"]" Class="field" /></label>
        <label class="flt"><span class="flt-label">@L["Ordenar por"]</span><select @bind="_ordem" @bind:after="Refiltrar"><option value="nome">@L["Nome"]</option><option value="cidade">@L["Cidade"]</option><option value="pais">@L["País"]</option><option value="geo">@L["Localização"]</option></select></label>
        <label class="flt"><span class="flt-label">@L["Por página"]</span><select @bind="_tam" @bind:after="@(() => _pagPl = 0)"><option value="50">50</option><option value="100">100</option><option value="200">200</option></select></label>
        @if (_fCli != "" || _fPais != "" || _fUf != "" || _chip != "" || _buscaPl != "") { <button class="btn-link" @onclick="LimparFiltros">@Icons.Svg("x")@L["Limpar tudo"]</button> }
        <span class="grow"></span>
        <span class="muted sm"><strong>@_lista.Count.ToString("N0")</strong> @L["resultado(s)"]</span>
    </div>
    @PainelJob()
    @if (Job.AutomaticoLigado && !Job.Rodando && _plantas.Any(p => !p.TemCoord && p.GeoStatus != "manual"))
    {
        <div class="muted sm geo-auto">@Icons.Svg("info")@L["As plantas sem localização são procuradas"] <strong>@L["automaticamente"]</strong> @(L["em segundo plano (primeiro as usadas em viagens e compromissos, 1 consulta por segundo). Passe o mouse sobre \"Sem localização\" para ver o motivo."])</div>
    }
    @if (!string.IsNullOrEmpty(_msgGeo)) { <div class="alert-box alert-info">@Icons.Svg("info")<div>@L[_msgGeo]</div></div> }
    <div class="table-wrap"><table class="grid-tbl pl-tbl">
        <thead><tr><th>@L["Planta"]</th><th>@L["Local"]</th><th>@L["País"]</th><th>@L["Localização no mapa"]</th><th></th></tr></thead>
        <tbody>
        @foreach (var p in _lista.Skip(PagPl * _tam).Take(_tam))
        {
            <tr class="@(p.Ativa ? "" : "inativa")" @onclick="() => AbrirPlanta(p.Id)" tabindex="0" @onkeydown="e => TeclaLinha(e, p.Id)">
                <td><div class="pl-nome">@RealceBusca(p.Nome)</div>@if (!string.IsNullOrEmpty(p.Cliente)) { <div class="muted sm">@p.Cliente</div> }@if (!p.Ativa) { <span class="tag">@L["inativa"]</span> }</td>
                <td>@if (string.IsNullOrWhiteSpace(p.Cidade)) { <span class="badge st-warn">@L["sem cidade"]</span> } else { <span>@p.Cidade@(string.IsNullOrEmpty(p.Estado) ? "" : ", " + p.Estado)</span> }@if (!string.IsNullOrWhiteSpace(p.Rua)) { <div class="muted sm">@Ui.Corte(p.Rua, 60)</div> }</td>
                <td>@p.Pais</td>
                <td>@GeoChip(p.Geo, p.GeoMotivo)</td>
                <td class="right nowrap"><span class="row-act" aria-hidden="true">@Icons.Svg(_pode ? "edit" : "eye")</span></td>
            </tr>
        }
        </tbody>
    </table></div>
    @PaginacaoLista()
    @if (_lista.Count == 0) { <div class="empty-state sm"><div class="ico">@Icons.Svg("pin")</div><h3>@L["Nenhuma planta encontrada"]</h3><p>@(_plantas.Count == 0 ? L["Cadastre uma planta ou importe uma planilha."] : L["Tente outras palavras ou limpe os filtros."])</p></div> }
}
else if (_aba == "importar" && _pode)
{
    @* ---------------- importação ---------------- *@
    <div class="steps">
        @foreach (var (n, r) in new[] { (1, "Arquivo"), (2, "Colunas"), (3, "Prévia e validação"), (4, "Resultado") })
        { <span class="step @(_passo == n ? "on" : _passo > n ? "ok" : "")"><b>@n</b>@L[r]</span> }
    </div>

    @if (_passo == 1)
    {
        <div class="panel">
            <div class="panel-head"><div class="panel-title">@L["1. Escolha o arquivo"]</div></div>
            <p>@L["Aceita"] <strong>.xlsx</strong> @L["e"] <strong>.csv</strong> @L["(até 25 MB e 20.000 linhas). Colunas:"] <strong>Account</strong> @L["(nome da planta),"] <strong>Country</strong>, <strong>City</strong>, <strong>State</strong> @L["e"] <strong>Address1</strong>. @L["Só o nome da planta é obrigatório."]</p>
            <div class="imp-acoes">
                <a class="btn-ghost" href="/modelo/plantas.xlsx" download>@Icons.Svg("download")@L["Baixar planilha modelo"]</a>
                <label class="btn-primary file-btn">@Icons.Svg("upload")@L["Selecionar arquivo"]<InputFile OnChange="AoArquivo" accept=".xlsx,.csv" class="sr-only" /></label>
            </div>
            @if (_lendo) { <p class="muted">@Icons.Svg("clock")@L["Lendo o arquivo…"]</p> }
            @if (_errosImp is { Count: > 0 }) { <div class="alert-box alert-erro">@Icons.Svg("alert")<div>@foreach (var e in _errosImp) { <div>@L[e]</div> }</div></div> }
        </div>
    }
    else if (_passo == 2 && _arq is not null)
    {
        <div class="panel">
            <div class="panel-head"><div class="panel-title">@L["2. Mapeie as colunas"]</div><span class="tag">@_arq.Nome · @L.F("{0} linha(s)", _arq.Linhas.Count)</span></div>
            <p class="muted">@L["Conferimos os títulos do arquivo e sugerimos a correspondência. Ajuste o que estiver errado; colunas opcionais podem ficar sem mapeamento."]</p>
            <div class="map-cols">
                @foreach (var c in Importador.Campos)
                {
                    <label class="fld">@c.Label @if (c.Obrigatorio) { <span class="neg">*</span> }
                        <select value="@(_map.TryGetValue(c.Key, out var ix) ? ix : -1)" @onchange="e => Mapear(c.Key, e.Value?.ToString())">
                            <option value="-1">@L["— não importar —"]</option>
                            @for (var i = 0; i < _arq.Cabecalhos.Count; i++) { <option value="@i">@(string.IsNullOrWhiteSpace(_arq.Cabecalhos[i]) ? L.F("(coluna {0})", i + 1) : _arq.Cabecalhos[i])</option> }
                        </select></label>
                }
            </div>
            @if (_errosImp is { Count: > 0 }) { <div class="alert-box alert-erro">@Icons.Svg("alert")<div>@foreach (var e in _errosImp) { <div>@L[e]</div> }</div></div> }
            <div class="modal-actions">
                <button class="btn-ghost" @onclick="ReiniciarImport">@L["Voltar"]</button>
                <button class="btn-primary" @onclick="Analisar" disabled="@_lendo">@(_lendo ? L["Validando…"] : L["Validar e ver prévia"])@Icons.Svg("arrow-right")</button>
            </div>
        </div>
    }
    else if (_passo == 3)
    {
        var rej = _linhas.Count(l => l.Rejeitada); var exist = _linhas.Count(l => l.Existente && !l.Rejeitada);
        var novas = _linhas.Count(l => !l.Existente && !l.Rejeitada); var avisos = _linhas.Count(l => l.Avisos.Count > 0 && !l.Rejeitada);
        <div class="panel">
            <div class="panel-head"><div class="panel-title">@L["3. Prévia e validação"]</div><span class="tag">@L.F("{0} linha(s)", _linhas.Count)</span></div>
            <div class="imp-resumo">
                <div class="imp-n pos"><b>@novas</b>@L["novas"]</div>
                <div class="imp-n warn"><b>@exist</b>@L["já cadastradas"]</div>
                <div class="imp-n neg"><b>@rej</b>@L["com erro (serão rejeitadas)"]</div>
                <div class="imp-n"><b>@avisos</b>@L["com aviso"]</div>
            </div>
            @if (exist > 0)
            {
                <div class="toolbar">
                    <span><strong>@L["Plantas já cadastradas:"]</strong></span>
                    <select class="field w-auto" @onchange="e => AplicarPadrao(e.Value?.ToString())">
                        <option value="Atualizar">@L["Atualizar o cadastro existente (somente campos preenchidos)"]</option>
                        <option value="Ignorar">@L["Ignorar (manter o cadastro como está)"]</option>
                        <option value="Criar">@L["Criar nova com nome diferenciado"]</option>
                    </select>
                    <span class="muted sm">@L["Você pode mudar linha a linha abaixo. Nada é substituído sem aparecer aqui."]</span>
                </div>
            }
            <div class="toolbar"><label class="chk-inline"><input type="checkbox" @bind="_soProblemas" @bind:after="@(() => _pagPrev = 0)" />@L["Mostrar só linhas com erro, aviso ou duplicidade"]</label><span class="muted sm">@L.F("{0} linha(s) lidas; a tabela é paginada, mas a importação vale para todas.", _linhas.Count.ToString("N0"))</span></div>
            <div class="table-wrap prev-wrap"><table class="grid-tbl">
                <thead><tr><th>@L["Linha"]</th><th>@L["Cliente"]</th><th>@L["Planta"]</th><th>@L["Local"]</th><th>@L["Situação"]</th><th>@L["Ação"]</th></tr></thead>
                <tbody>
                @foreach (var l in LinhasPrev.Skip(_pagPrev * TamPag).Take(TamPag))
                {
                    <tr class="@(l.Rejeitada ? "lin-erro" : "")">
                        <td>@l.Numero</td><td>@l.Cliente</td><td>@l.Planta</td>
                        <td>@l.V["cidade"]@(string.IsNullOrEmpty(l.V["estado"]) ? "" : "/" + l.V["estado"]) · @l.V["pais"]</td>
                        <td>
                            @if (l.Rejeitada) { <span class="badge st-neg">@Icons.Svg("x", "bico")@L["Erro"]</span> @foreach (var e in l.Erros) { <div class="sm neg">@L[e]</div> } }
                            else if (l.Existente) { <span class="badge st-warn">@Icons.Svg("copy", "bico")@L["Já cadastrada"]</span>
                                @if (l.Diferencas.Count > 0) { <ul class="difs">@foreach (var d in l.Diferencas) { <li>@L[d]</li> }</ul> } }
                            else { <span class="badge st-pos">@Icons.Svg("plus", "bico")@L["Nova"]</span> }
                            @foreach (var a in l.Avisos) { <div class="sm warn">@L[a]</div> }
                        </td>
                        <td>
                            @if (l.Rejeitada) { <span class="muted">@L["Rejeitada"]</span> }
                            else if (l.Existente)
                            {
                                <select class="field w-auto" @bind="l.Acao"><option value="@AcaoImport.Atualizar">@L["Atualizar"]</option><option value="@AcaoImport.Ignorar">@L["Ignorar"]</option><option value="@AcaoImport.Criar">@L["Criar nova"]</option></select>
                            }
                            else { <span class="muted">@L["Criar"]</span> }
                        </td>
                    </tr>
                }
                </tbody>
            </table></div>
            @Paginacao(LinhasPrev.Count(), _pagPrev, n => _pagPrev = n)
            <div class="modal-actions">
                <button class="btn-ghost" @onclick="@(() => _passo = 2)">@L["Voltar"]</button>
                <button class="btn-primary" @onclick="ConfirmarImport" disabled="@(_importando || _linhas.All(l => l.Rejeitada || l.Acao == AcaoImport.Ignorar))">@Icons.Svg(_importando ? "clock" : "check")@(_importando ? L["Importando… aguarde"] : L["Confirmar importação"])</button>
            </div>
            @if (_errosImp is { Count: > 0 }) { <div class="alert-box alert-erro">@Icons.Svg("alert")<div>@foreach (var e in _errosImp) { <div>@L[e]</div> }</div></div> }
        </div>
    }
    else if (_passo == 4 && _res is not null)
    {
        <div class="panel">
            <div class="panel-head"><div class="panel-title">@L["4. Resultado da importação"]</div></div>
            <div class="imp-resumo">
                <div class="imp-n pos"><b>@_res.Importadas</b>@L["importadas"]</div>
                <div class="imp-n info"><b>@_res.Atualizadas</b>@L["atualizadas"]</div>
                <div class="imp-n"><b>@_res.Ignoradas</b>@L["ignoradas"]</div>
                <div class="imp-n neg"><b>@_res.Rejeitadas.Count</b>@L["rejeitadas"]</div>
                <div class="imp-n"><b>@_res.ClientesCriados</b>@L["clientes novos"]</div>
            </div>
            @if (_res.Rejeitadas.Count > 0)
            {
                <h3 class="sec">@Icons.Svg("alert")@L["Linhas rejeitadas e motivos"]</h3>
                <div class="table-wrap"><table class="grid-tbl"><thead><tr><th>@L["Linha"]</th><th>@L["Cliente"]</th><th>@L["Planta"]</th><th>@L["Motivo"]</th></tr></thead><tbody>
                    @foreach (var e in _res.Rejeitadas) { <tr><td>@e.linha</td><td>@e.cliente</td><td>@e.planta</td><td class="neg">@L[e.motivo]</td></tr> }
                </tbody></table></div>
                <button class="btn-ghost mt8" @onclick="BaixarErros">@Icons.Svg("download")@L["Baixar lista de erros (CSV)"]</button>
            }
            @if (_res.Avisos.Count > 0)
            {
                <h3 class="sec">@Icons.Svg("info")@L["Avisos"]</h3>
                <ul class="difs">@foreach (var a in _res.Avisos) { <li>@L.F("Linha {0}:", a.linha) @L[a.detalhe]</li> }</ul>
            }
            <p class="muted mt16">@L["As plantas novas ficam como"] <strong>@L["localização pendente"]</strong> @L["até serem localizadas. A busca é em cascata: tenta o endereço; se não achar, para na cidade; depois no estado; depois no país."]</p>
            @PainelJob()
            @if (Geo.Configurado && !Job.Rodando) { <button class="btn-primary" @onclick="IniciarJob">@Icons.Svg("pin")@L.F("Localizar no mapa as {0} plantas pendentes", _plantas.Count(p => !p.TemCoord && p.GeoStatus != "manual"))</button> }
            else if (!Geo.Configurado) { <div class="alert-box alert-aviso">@Icons.Svg("alert")<div>@L[Geo.Pendencia]</div></div> }

            <div class="modal-actions">
                <button class="btn-ghost" @onclick="ReiniciarImport">@L["Nova importação"]</button>
                <button class="btn-primary" @onclick="@(() => { _aba = "plantas"; _chip = ""; ReiniciarImport(); Refiltrar(); })">@L["Ver plantas"]</button>
            </div>
        </div>
    }
}

@* ---------------- diálogos ---------------- *@
@if (_cli is not null)
{
    <Dialogo Titulo="@(string.IsNullOrEmpty(_cli.Id) ? L["Novo cliente"] : L["Editar cliente"])" OnFechar="@(() => _cli = null)" Erros="_erros">
        <div class="form-grid">
            <label class="fld full">@L["Nome do cliente *"]<input @bind="_cli.Nome" /></label>
            <label class="fld">@L["Razão social"]<input @bind="_cli.RazaoSocial" /></label>
            <label class="fld">@L["Documento"] <span class="hint">@L["opcional"]</span><input @bind="_cli.Documento" /></label>
            <label class="fld">@L["Contato responsável"]<input @bind="_cli.Contato" /></label>
            <label class="fld">@L["Telefone"]<input @bind="_cli.Telefone" /></label>
            <label class="fld full">@L["E-mail"]<input type="email" @bind="_cli.Email" /></label>
            <label class="fld full">@L["Observações"]<textarea @bind="_cli.Obs"></textarea></label>
            <label class="fld chk"><input type="checkbox" @bind="_cli.Ativo" />@L["Cliente ativo"]</label>
        </div>
        <div class="modal-actions"><button class="btn-ghost" @onclick="@(() => _cli = null)">@L["Cancelar"]</button><button class="btn-primary" @onclick="SalvarCliente">@Icons.Svg("check")@L["Salvar"]</button></div>
    </Dialogo>
}

@if (_pl is not null)
{
    <Dialogo Titulo="@(string.IsNullOrEmpty(_pl.Id) ? L["Nova planta / unidade"] : _pode ? L["Editar planta / unidade"] : L["Planta / unidade"])" Largo="true" OnFechar="FecharPlanta" Erros="_erros">
        <fieldset disabled="@(!_pode)" class="semborda">
        <div class="pl-grid">
            <div>
                <div class="form-grid">
                    <label class="fld">@L["Cliente"] <span class="hint">@L["opcional"]</span><SeletorLista Itens="@(_clientes.OrderBy(c => c.Nome).Select(c => new SeletorLista.ItemSel(c.Id, c.Nome)))" Value="@_pl.ClienteId" ValueChanged="@(async (string v) => { _pl.ClienteId = v; })" Placeholder="@L["— sem cliente —"]" Criar="CriarCli" RotuloCriar="@L["cliente"]" /></label>
                    <label class="fld">@L["Nome da planta / unidade *"]<input @bind="_pl.Nome" /></label>
                    <label class="fld">@L["País"]<input list="lista-paises" @bind="_pl.Pais" /></label>
                    <label class="fld">@L["Estado / região"]<input @bind="_pl.Estado" /></label>
                    <label class="fld">@L["Cidade"] <span class="hint">@L["mínimo para localizar no mapa"]</span><input @bind="_pl.Cidade" /></label>
                    <label class="fld">@L["CEP / código postal"]<input @bind="_pl.Cep" /></label>
                    <label class="fld">@L["Endereço (Address 1)"]<input @bind="_pl.Rua" /></label>
                    <label class="fld">@L["Número"]<input @bind="_pl.Numero" /></label>
                    <label class="fld full">@L["Complemento"]<input @bind="_pl.Complemento" /></label>
                    <label class="fld full">@L["Endereço completo"] <span class="hint">@L["vazio = montado a partir dos campos acima; use para formatos internacionais"]</span><input @bind="_pl.EnderecoCompleto" placeholder="@Servicos.MontarEndereco(_pl)" /></label>
                    <label class="fld">@L["Fuso horário *"]<CampoLista Value="@_pl.FusoHorario" ValueChanged="@((string v) => { _pl.FusoHorario = v; })" Opcoes="@(Vocab.Fusos)" Placeholder="" /></label>
                    <label class="fld">@L["Contato local"]<input @bind="_pl.ContatoLocal" /></label>
                    <label class="fld full">@L["Informações de acesso"]<input @bind="_pl.Acesso" placeholder="@L["Portaria, EPIs, integração…"]" /></label>
                    <label class="fld full">@L["Observações"]<textarea @bind="_pl.Obs"></textarea></label>
                    <label class="fld chk"><input type="checkbox" @bind="_pl.Ativo" />@L["Planta ativa"]</label>
                </div>
                <datalist id="lista-paises">@foreach (var p in Vocab.Paises) {<option value="@p"></option>}</datalist>
            </div>
            <div>
                <div class="loc-estado"><GeoBadge P="_pl" /><span class="muted sm">@L[_pl.GeoFonte]</span></div>
                <div class="form-grid mt8">
                    <label class="fld">@L["Latitude"]<input type="number" step="0.000001" value="@_lat" @onchange="e => MudarCoord(e.Value?.ToString(), true)" /></label>
                    <label class="fld">@L["Longitude"]<input type="number" step="0.000001" value="@_lon" @onchange="e => MudarCoord(e.Value?.ToString(), false)" /></label>
                </div>
                <div class="px-link mt8"><input @bind="_linkPl" placeholder="@L["Cole o link do Google Maps ou as coordenadas da planta"]" aria-label="@L["Link do Google Maps"]" />
                    <button type="button" class="btn-primary sm" @onclick="UsarLinkPlanta" disabled="@string.IsNullOrWhiteSpace(_linkPl)">@Icons.Svg("check")@L["Usar"]</button></div>
                <div id="mapa-planta" class="mapa mapa-pl" role="application" aria-label="@L["Mapa para posicionar a planta"]"></div>
                <p class="muted sm">@L["Clique no mapa ou arraste o marcador para corrigir a posição. A posição corrigida fica gravada como"] <strong>@L["ajustada manualmente"]</strong> @L["e não é sobrescrita pela consulta de endereço."]</p>
                @if (_pode)
                {
                    <button class="btn-ghost sm" @onclick="LocalizarEndereco" disabled="@(!Geo.Configurado || _localizando)" title="@(Geo.Configurado ? L["Consulta o endereço e guarda as coordenadas"] : L[Geo.Pendencia])">@Icons.Svg("search")@L["Localizar pelo endereço"]</button>
                    @if (!Geo.Configurado) { <div class="alert-box alert-aviso mt8">@Icons.Svg("alert")<div>@L[Geo.Pendencia]</div></div> }
                    @if (!string.IsNullOrEmpty(_msgGeoPl)) { <div class="alert-box alert-info mt8">@Icons.Svg("info")<div>@L[_msgGeoPl]</div></div> }
                }
            </div>
        </div>
        </fieldset>
        <div class="modal-actions">
            <button class="btn-ghost" @onclick="FecharPlanta">@(_pode ? L["Cancelar"] : L["Fechar"])</button>
            @if (_pode) { <button class="btn-primary" @onclick="SalvarPlanta" disabled="@_salvando">@Icons.Svg("check")@L["Salvar"]</button> }
        </div>
    </Dialogo>
}

@code {
    private Task<string?> CriarCli(string nome) { var c = Svc.CriarClienteRapido(_ator, nome); Carregar(); return Task.FromResult<string?>(c.Id); }
    private Ator _ator = new(); private bool _pode;
    private List<Cliente> _clientes = new(); private List<Planta> _plantas = new();
    private string _aba = "plantas";
    private string _buscaCli = "", _buscaPl = "", _fCli = "", _fPais = ""; private bool _soAtivosCli, _soAtivosPl;
    private List<string>? _erros; private Cliente? _cli; private Planta? _pl; private bool _salvando, _localizando;
    private string? _msgGeo, _msgGeoPl; private string _lat = "", _lon = "";
    private DotNetObjectReference<Clientes>? _ref; private bool _mapaPlantaPronto; private string? _mapaPlantaId;

    protected override async Task OnInitializedAsync()
    {
        _ator = await Sessao.AtorAsync(); _pode = _ator.Pode(Perm.EditarClientes);
        _ref = DotNetObjectReference.Create(this);
        Sessao.Mudou += Ao; Job.Mudou += AoJob;
        Carregar();
    }
    private void Ao() => InvokeAsync(StateHasChanged);

    private void Carregar()
    {
        _clientes = Db.Clientes.Todos(); _plantas = Db.Plantas.Todos(); Refiltrar();
    }

    private IEnumerable<Cliente> ClientesFiltrados => _clientes.Where(c => (!_soAtivosCli || c.Ativo) &&
        (string.IsNullOrWhiteSpace(_buscaCli) || DocEngine.Norm(c.Nome + " " + c.RazaoSocial).Contains(DocEngine.Norm(_buscaCli)))).OrderBy(c => c.Nome);

    // ---- lista de plantas (milhares): busca por índice, filtros e contagens calculados uma vez por alteração ----
    private string _chip = "", _fUf = "", _ordem = "nome"; private int _tam = 100;
    private List<PlantaItem> _lista = new(); private Dictionary<string, int> _cont = new(); private List<string> _paises = new(), _ufs = new();
    private static readonly (string, string, string)[] Chips =
        { ("", "Todas", "layers"), ("ok", "Endereço exato", "check"), ("aprox", "Aproximadas", "pin"), ("pendente", "Sem localização", "alert"), ("semcidade", "Sem cidade", "help") };

    private void Refiltrar()
    {
        var baseQ = Busca.Buscar(_buscaPl, _soAtivosPl).Where(i => (_fCli == "" || i.ClienteId == _fCli) && (_fPais == "" || Ui.Contem(i.Pais, _fPais)) && (_fUf == "" || Ui.Contem(i.Estado, _fUf))).ToList();
        _cont = new() { [""] = baseQ.Count, ["ok"] = baseQ.Count(i => i.Geo is "ok" or "manual"), ["aprox"] = baseQ.Count(i => i.Geo == "aprox"),
                        ["pendente"] = baseQ.Count(i => i.Geo == "pendente"), ["semcidade"] = baseQ.Count(i => string.IsNullOrWhiteSpace(i.Cidade)) };
        IEnumerable<PlantaItem> q = _chip switch
        {
            "ok" => baseQ.Where(i => i.Geo is "ok" or "manual"), "aprox" => baseQ.Where(i => i.Geo == "aprox"), "pendente" => baseQ.Where(i => i.Geo == "pendente"),
            "semcidade" => baseQ.Where(i => string.IsNullOrWhiteSpace(i.Cidade)), _ => baseQ,
        };
        if (string.IsNullOrWhiteSpace(_buscaPl) || _ordem != "nome")   // com texto digitado vale a relevância; senão a ordem escolhida
            q = _ordem switch
            {
                "cidade" => q.OrderBy(i => i.Cidade, StringComparer.OrdinalIgnoreCase).ThenBy(i => i.Nome, StringComparer.OrdinalIgnoreCase),
                "pais" => q.OrderBy(i => i.Pais, StringComparer.OrdinalIgnoreCase).ThenBy(i => i.Estado).ThenBy(i => i.Nome, StringComparer.OrdinalIgnoreCase),
                "geo" => q.OrderBy(i => i.Geo == "pendente" ? 0 : i.Geo == "aprox" ? 1 : 2).ThenBy(i => i.Nome, StringComparer.OrdinalIgnoreCase),
                _ => q,
            };
        _lista = q.ToList(); _pagPl = 0;
        var todas = Busca.Itens();
        _paises = todas.Select(i => i.Pais).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x).ToList();
        _ufs = todas.Where(i => _fPais == "" || i.Pais == _fPais).Select(i => i.Estado).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x).ToList();
    }

    private void LimparFiltros() { _fCli = _fPais = _fUf = _chip = _buscaPl = ""; Refiltrar(); }

    private void TeclaLinha(KeyboardEventArgs e, string id) { if (e.Key == "Enter") AbrirPlanta(id); }

    private void AbrirPlanta(string id) { if (Db.Plantas.Obter(id) is { } p) EditarPlanta(p); }

    private RenderFragment GeoChip(string g, string motivo = "") => __builder =>
    {
        var (txt, css) = g switch { "ok" => ("Endereço exato", "st-pos"), "manual" => ("Exata (marcada)", "st-pos"), "aprox" => ("Aproximada", "st-warn"), _ => ("Sem localização", "st-neutral") };
        <span class="badge @css" title="@L[motivo]">@Icons.Svg("pin", "bico")@L[txt]</span>
        @if (g == "pendente" && !string.IsNullOrEmpty(motivo)) { <div class="muted xs geo-motivo">@Ui.Corte(L[motivo], 90)</div> }
    };

    private MarkupString RealceBusca(string nome)
    {
        var enc = System.Net.WebUtility.HtmlEncode(nome);
        var w = DocEngine.Norm(_buscaPl).Split(' ', StringSplitOptions.RemoveEmptyEntries).OrderByDescending(x => x.Length).FirstOrDefault();
        var n = DocEngine.Norm(nome);
        if (string.IsNullOrEmpty(w) || n.Length != nome.Length) return new MarkupString(enc);
        var i = n.IndexOf(w, StringComparison.Ordinal);
        return i < 0 ? new MarkupString(enc) : new MarkupString(System.Net.WebUtility.HtmlEncode(nome[..i]) + "<mark>" + System.Net.WebUtility.HtmlEncode(nome.Substring(i, w.Length)) + "</mark>" + System.Net.WebUtility.HtmlEncode(nome[(i + w.Length)..]));
    }

    private RenderFragment PaginacaoLista() => __builder =>
    {
        var paginas = Math.Max(1, (int)Math.Ceiling(_lista.Count / (double)_tam));
        if (paginas <= 1) return;
        <div class="paginacao">
            <button class="btn-ghost sm" disabled="@(PagPl <= 0)" @onclick="() => _pagPl = 0" title="@L["Primeira"]">«</button>
            <button class="btn-ghost sm" disabled="@(PagPl <= 0)" @onclick="() => _pagPl = PagPl - 1">@Icons.Svg("chevron-left")</button>
            <span>@L["Página"] <strong>@(PagPl + 1)</strong> @L.F("de {0}", paginas.ToString("N0")) · @(PagPl * _tam + 1)–@Math.Min(_lista.Count, (PagPl + 1) * _tam) @L.F("de {0}", _lista.Count.ToString("N0"))</span>
            <button class="btn-ghost sm" disabled="@(PagPl >= paginas - 1)" @onclick="() => _pagPl = PagPl + 1">@Icons.Svg("chevron-right")</button>
            <button class="btn-ghost sm" disabled="@(PagPl >= paginas - 1)" @onclick="() => _pagPl = paginas - 1" title="@L["Última"]">»</button>
        </div>
    };

    private void FiltrarPlantas(string cli) { _fCli = cli; _aba = "plantas"; Refiltrar(); }

    // ------------------------------------------------------ clientes
    private void NovoCliente() { _cli = new Cliente(); _erros = null; }
    private void EditarCliente(Cliente c) { _cli = c; _erros = null; }
    private void SalvarCliente()
    {
        try { Svc.SalvarCliente(_ator, _cli!); _cli = null; Carregar(); Sessao.Avisar(L["Cliente salvo."]); }
        catch (Exception ex) { _erros = Ui.Erros(ex); }
    }

    // ------------------------------------------------------ plantas
    private void NovaPlanta()
    {
        _pl = new Planta { ClienteId = _fCli, Pais = "Brasil" }; _lat = _lon = ""; _erros = null; _msgGeoPl = null; _mapaPlantaPronto = false;
    }
    private void EditarPlanta(Planta p)
    {
        _pl = p; _lat = p.Lat?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? ""; _lon = p.Lon?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";
        _erros = null; _msgGeoPl = null; _mapaPlantaPronto = false;
    }
    private async Task FecharPlanta()
    {
        _pl = null; _mapaPlantaPronto = false;
        try { await JS.InvokeVoidAsync("app.mapa.destruir", "mapa-planta"); } catch { }
    }

    private static double? Num(string? s) =>
        double.TryParse((s ?? "").Replace(',', '.'), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : null;

    private async Task MudarCoord(string? v, bool lat)
    {
        if (lat) _lat = v ?? ""; else _lon = v ?? "";
        if (_pl is null) return;
        _pl.Lat = Num(_lat); _pl.Lon = Num(_lon);
        if (_pl.TemCoord) { _pl.GeoStatus = "manual"; _pl.GeoFonte = "Posição informada manualmente"; await JS.InvokeVoidAsync("app.mapa.definir", "mapa-planta", _pl.Lat, _pl.Lon); }
    }

    private string _linkPl = "";
    private async Task UsarLinkPlanta()
    {
        var c = await Geo.CoordenadasDoLinkAsync(_linkPl);
        if (c is null) { _msgGeoPl = "Não encontrei coordenadas nesse texto. Cole o link do Google Maps (Compartilhar → Copiar link) ou as coordenadas, ex.: -23.5505, -46.6333."; return; }
        await AoMover(c.Value.lat, c.Value.lon); _pl!.GeoFonte = "Posição exata pelo link/coordenadas"; _linkPl = ""; _msgGeoPl = null;
        try { await JS.InvokeVoidAsync("app.mapa.definir", "mapa-planta", _pl.Lat, _pl.Lon); } catch { }
    }

    [JSInvokable]
    public async Task AoMover(double lat, double lon)
    {
        if (_pl is null) return;
        _pl.Lat = Math.Round(lat, 6); _pl.Lon = Math.Round(lon, 6); _pl.GeoStatus = "manual"; _pl.GeoFonte = "Posição corrigida manualmente no mapa";
        _lat = _pl.Lat.Value.ToString(System.Globalization.CultureInfo.InvariantCulture); _lon = _pl.Lon.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pl is not null && !_mapaPlantaPronto)
        {
            _mapaPlantaPronto = true;
            try
            {
                await JS.InvokeVoidAsync("app.mapa.escolher", "mapa-planta", _ref, _pl.Lat, _pl.Lon, new { centro = new[] { -15.0, -52.0 }, tileUrl = Cfg["Mapa:TileUrl"], atribuicao = Cfg["Mapa:Atribuicao"] });
            }
            catch { }
        }
    }

    private async Task LocalizarEndereco()
    {
        if (_pl is null) return;
        _localizando = true; _msgGeoPl = null; StateHasChanged();
        var rua = string.Join(" ", new[] { _pl.Rua, _pl.Numero }.Where(x => !string.IsNullOrWhiteSpace(x)));
        var r = await Geo.BuscarHierarquicoAsync(_pl.Pais, _pl.Estado, _pl.Cidade, rua, string.IsNullOrWhiteSpace(_pl.Cidade) && string.IsNullOrWhiteSpace(_pl.Estado) ? _pl.EnderecoCompleto : null);
        _localizando = false;
        if (r.Ok)
        {
            _pl.Lat = r.Lat; _pl.Lon = r.Lon; _pl.GeoStatus = "ok"; _pl.GeoNivel = r.Nivel; _pl.GeoEm = DateTime.UtcNow;
            _pl.GeoFonte = r.Nivel == "endereco" ? r.Fonte : $"{r.Fonte} · aproximada ao nível de {r.Nivel}";
            _lat = r.Lat!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture); _lon = r.Lon!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
            _msgGeoPl = r.Nivel == "endereco" ? "Endereço localizado. Revise a posição no mapa." : r.Mensagem;
            await JS.InvokeVoidAsync("app.mapa.definir", "mapa-planta", _pl.Lat, _pl.Lon);
        }
        else _msgGeoPl = L.F("{0} Você pode salvar assim (localização pendente) ou posicionar manualmente no mapa.", L[r.Mensagem]);
    }

    private async Task SalvarPlanta()
    {
        if (_pl is null) return;
        _salvando = true; _erros = null;
        try
        {
            var antes = Db.Plantas.Obter(_pl.Id);
            // o formulário já reflete a posição escolhida; só consulta endereço se algo mudou e não há posição manual
            await Svc.SalvarPlantaAsync(_ator, _pl, Geo);
            await FecharPlanta(); Carregar();
            Sessao.Avisar(L["Planta salva."]);
        }
        catch (Exception ex) { _erros = Ui.Erros(ex); }
        _salvando = false;
    }

    private const int TamPag = 100;
    private int _pagPl, _pagPrev;
    private int PagPl => Math.Min(_pagPl, Math.Max(0, (int)Math.Ceiling(_lista.Count / (double)_tam) - 1));
    private IEnumerable<LinhaImport> LinhasPrev => _linhas.Where(l => !_soProblemas || l.Rejeitada || l.Existente || l.Avisos.Count > 0);

    private RenderFragment Paginacao(int total, int pag, Action<int> ir) => __builder =>
    {
        var paginas = Math.Max(1, (int)Math.Ceiling(total / (double)TamPag));
        if (paginas <= 1) return;
        <div class="paginacao">
            <button class="btn-ghost sm" disabled="@(pag <= 0)" @onclick="() => ir(pag - 1)">@Icons.Svg("chevron-left")</button>
            <span>@L.F("Página {0} de {1} · {2} registros", pag + 1, paginas, total.ToString("N0"))</span>
            <button class="btn-ghost sm" disabled="@(pag >= paginas - 1)" @onclick="() => ir(pag + 1)">@Icons.Svg("chevron-right")</button>
        </div>
    };

    private RenderFragment PainelJob() => __builder =>
    {
        if (!Job.Rodando && Job.Inicio is null) return;
        <div class="alert-box @(Job.Erro is not null ? "alert-aviso" : Job.Rodando ? "alert-info" : "alert-ok") job-painel">
            @Icons.Svg(Job.Rodando ? "clock" : "pin")
            <div>
                @if (Job.Rodando)
                {
                    <strong>@(Job.Automatico ? L["Localização automática em segundo plano…"] : L["Localizando plantas no mapa…"]) @L.F("{0} de {1}", Job.Feitas.ToString("N0"), Job.Total.ToString("N0"))</strong>
                    <div class="barra"><i style="width:@((Job.Total == 0 ? 0 : 100.0 * Job.Feitas / Job.Total).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></i></div>
                    <div class="sm">@L.F("{0} localizadas · {1} sem localização", Job.Localizadas.ToString("N0"), Job.Pendentes.ToString("N0")) · @Job.Atual@(Job.Restante is { } r ? " · " + L.F("faltam ≈ {0}", Tempo.Duracao(r)) : "")</div>
                    <div class="sm muted">@L["Roda no servidor: pode fechar esta página. Plantas que dividem a mesma cidade reaproveitam a consulta."]</div>
                    <button class="btn-ghost sm mt8" @onclick="Job.Parar">@L["Parar"]</button>
                }
                else
                {
                    <strong>@L.F(Job.Erro is null ? (Job.Automatico ? "Localização automática concluída: {0} localizada(s), {1} sem localização (de {2})" : "Localização concluída: {0} localizada(s), {1} sem localização (de {2})") : Job.Automatico ? "Localização automática pausada: {0} localizada(s), {1} sem localização (de {2})" : "Localização interrompida: {0} localizada(s), {1} sem localização (de {2})", Job.Localizadas.ToString("N0"), Job.Pendentes.ToString("N0"), Job.Total.ToString("N0"))</strong>
                    @if (Job.Erro is not null) { <div class="sm">@L[Job.Erro]</div> }
                    <div class="sm muted">@L.F("Consultas ao serviço de mapas: {0} (evitadas pelo cache: {1}).", Geo.ConsultasRealizadas.ToString("N0"), Geo.ConsultasEmCache.ToString("N0"))</div>
                }
            </div>
        </div>
    };

    private void ReconferirJob()
    {
        try { Job.Iniciar(_ator, reconferirAproximadas: true); } catch (Exception ex) { Sessao.Avisar(string.Join(" ", Ui.Erros(ex).Select(x => L[x])), true); }
    }

    private void IniciarJob()
    {
        try { Job.Iniciar(_ator); }
        catch (Exception ex) { Sessao.Avisar(string.Join(" ", Ui.Erros(ex).Select(x => L[x])), true); }
    }

    private void AoJob() => InvokeAsync(() => { if (!Job.Rodando) Carregar(); StateHasChanged(); });

    private async Task LocalizarPendentes()
    {
        _localizando = true; _msgGeo = L["Consultando endereços (1 por segundo)…"]; StateHasChanged();
        try
        {
            var prog = new Progress<string>(m => { _msgGeo = m; InvokeAsync(StateHasChanged); });
            var (ok, falhas) = await Svc.LocalizarPendentesAsync(_ator, Geo, prog);
            _msgGeo = L.F("Localização concluída: {0} localizada(s) (ao nível mais preciso encontrado: endereço, cidade, estado ou país); {1} continuam pendentes (sem dados suficientes ou não encontradas). Posicione-as manualmente no mapa.", ok, falhas);
            Carregar();
        }
        catch (Exception ex) { _msgGeo = string.Join(" ", Ui.Erros(ex).Select(x => L[x])); }
        _localizando = false;
    }

    // ------------------------------------------------------ importação
    private int _passo = 1; private ArquivoLido? _arq; private Dictionary<string, int> _map = new();
    private List<LinhaImport> _linhas = new(); private ResultadoImport? _res; private bool _lendo, _soProblemas;
    private List<string>? _errosImp;

    private async Task AoArquivo(InputFileChangeEventArgs e)
    {
        _errosImp = null; _lendo = true; StateHasChanged();
        try
        {
            await using var s = e.File.OpenReadStream(Importador.MaxBytes);
            using var ms = new MemoryStream(); await s.CopyToAsync(ms); ms.Position = 0;
            _arq = Importador.Ler(e.File.Name, ms);
            _map = Importador.SugerirMapeamento(_arq.Cabecalhos);
            _passo = 2;
        }
        catch (Exception ex) { _errosImp = Ui.Erros(ex); }
        _lendo = false;
    }

    private void Mapear(string key, string? v)
    {
        if (int.TryParse(v, out var i) && i >= 0) _map[key] = i; else _map.Remove(key);
    }

    private async Task Analisar()
    {
        _errosImp = null; _lendo = true; StateHasChanged();
        try { _linhas = await Task.Run(() => Imp.Analisar(_arq!, _map)); _passo = 3; _pagPrev = 0; _soProblemas = _linhas.Count > 300; }
        catch (Exception ex) { _errosImp = Ui.Erros(ex); }
        _lendo = false;
    }

    private void AplicarPadrao(string? acao)
    {
        var a = acao switch { "Ignorar" => AcaoImport.Ignorar, "Criar" => AcaoImport.Criar, _ => AcaoImport.Atualizar };
        foreach (var l in _linhas.Where(l => l.Existente && !l.Rejeitada)) l.Acao = a;
    }

    private bool _importando;
    private async Task ConfirmarImport()
    {
        _errosImp = null; _importando = true; StateHasChanged();
        try { _res = await Task.Run(() => Imp.Aplicar(_ator, _linhas)); _passo = 4; Carregar(); Sessao.Avisar(L["Importação concluída."]); }
        catch (Exception ex) { _errosImp = Ui.Erros(ex); }
        _importando = false;
    }

    private void ReiniciarImport() { _passo = 1; _arq = null; _linhas = new(); _res = null; _errosImp = null; _map = new(); }

    private async Task BaixarErros()
    {
        if (_res is null) return;
        await JS.InvokeVoidAsync("app.baixarTexto", "erros_importacao.csv", "text/csv;charset=utf-8", Importador.ErrosCsvTexto(_res), true);
    }

    public void Dispose() { Sessao.Mudou -= Ao; Job.Mudou -= AoJob; try { _ = JS.InvokeVoidAsync("app.mapa.destruir", "mapa-planta"); } catch { } _ref?.Dispose(); }
}
