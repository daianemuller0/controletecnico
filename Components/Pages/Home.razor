@page "/"
@attribute [Authorize]
@implements IDisposable
@inject Servicos Svc
@inject Db Db
@inject Sessao Sessao
@inject IJSRuntime JS
@inject IConfiguration Cfg

<PageTitle>Visão operacional · Controle Técnico</PageTitle>

<div class="page-head compacto">
    <div>
        <h1>Visão operacional</h1>
        <p class="subtitle">Onde cada técnico está, o que está fazendo e quando fica disponível.</p>
    </div>
    <div class="momento-ctl">
        <span class="momento-chip @ClasseMomento" title="@TituloMomento">@TextoMomento</span>
        <label class="flt-data">@Icons.Svg("calendar")
            <input type="datetime-local" value="@_dataStr" @onchange="AoMudarData" aria-label="Data e hora da visualização" />
        </label>
        <button class="btn-ghost sm" @onclick="VoltarAgora" disabled="@_agora">@Icons.Svg("clock")Agora</button>
        <button class="btn-ghost sm" @onclick="@(() => Recarregar(true))" title="Recarregar dados">@Icons.Svg("refresh")</button>
        <button class="btn-primary sm" @onclick="IniciarAuto" title="Apresentação automática em tela cheia: mapa e indicadores, um por vez">@Icons.Svg("monitor")Modo automático</button>
    </div>
</div>

@if (_carregando)
{
    <div class="kpi-linha">@for (var i = 0; i < 8; i++) { <div class="kpi-tile skeleton" style="height:78px"></div> }</div>
    <div class="state-box">@Icons.Svg("clock")<div>Carregando a situação da equipe…</div></div>
}
else if (_erro is not null)
{
    <div class="state-box state-err">@Icons.Svg("alert")<div><strong>Não foi possível carregar os dados.</strong><div class="muted">@_erro</div></div><button class="btn-ghost" @onclick="@(() => Recarregar(true))">Tentar de novo</button></div>
}
else
{
    <div class="kpi-linha" role="group" aria-label="Indicadores">
        @Kpi("disponivel", "Disponíveis", _kDisp.Count, "check", "#1f9254", "Técnicos sem compromisso neste momento (inclui quem não tem programação)")
        @Kpi("atendimento", "Em atendimento", _kAtend.Count, "customers", "#0369a1", "Na planta do cliente")
        @Kpi("viagem", "Em viagem", _kViag.Count, "plane", "#d9822b", "Em deslocamento")
        @Kpi("ferias", "Em férias", _kFer.Count, "sun", "#7b4fc0", "Férias vigentes")
        @Kpi("viagens", "Viagens previstas", _kViagensPrev.Count, "route", "#004785", "Viagens ainda não iniciadas (rascunho, planejada ou confirmada)")
        @Kpi("conflitos", "Conflitos", _kConf.Count, "alert", "#c0392b", "Técnicos com sobreposição ou deslocamento a verificar")
        @Kpi("docs", "Docs a vencer", _kDocs.Count, "clock", "#b7791f", "Técnicos com documento próximo do vencimento ou vencido")
        @Kpi("pend", "Pendências docs", _kPend.Count, "shield", "#c0392b", "Técnicos escalados sem todos os requisitos documentais")
    </div>
    <div class="kpi-aux muted">
        <span>@Icons.Svg("ban")@_kInd.Count indisponível(is)</span>
        <span class="sep">·</span>
        <span>@_estados.Count técnico(s) ativos @(_estados.Count == 0 ? "" : "na visão")</span>
    </div>

    <div class="filterbar op-filtros" role="search">
        <label class="flt"><span class="flt-label">Técnico</span>
            <SeletorLista Itens="@(_snap.Tecnicos.Values.Where(t => t.Ativo && _ator.VeTecnico(t.Id)).OrderBy(t => t.Nome).Select(t => new SeletorLista.ItemSel(t.Id, t.Nome)))" Value="@FTec" ValueChanged="@(async (string v) => { FTec = v; Aplicar(); })" Placeholder="Todos" /></label>
        <label class="flt"><span class="flt-label">Especialidade</span>
            <SeletorLista Itens="@(_snap.Especialidades.Values.OrderBy(e => e.Nome).Select(e => new SeletorLista.ItemSel(e.Id, e.Nome)))" Value="@FEsp" ValueChanged="@(async (string v) => { FEsp = v; Aplicar(); })" Placeholder="Todas" /></label>
        <label class="flt"><span class="flt-label">Status</span>
            <select @bind="FStatus" @bind:after="Aplicar"><option value="">Todos</option>@foreach (var s in Vocab.StatusOp.Where(x => x.Key != Vocab.OpSemProg)) {<option value="@s.Key">@s.Label</option>}</select></label>
        <label class="flt"><span class="flt-label">Cliente</span>
            <SeletorLista Itens="@(_snap.Clientes.Values.OrderBy(c => c.Nome).Select(c => new SeletorLista.ItemSel(c.Id, c.Nome)))" Value="@FCli" ValueChanged="@(async (string v) => { FCli = v; Aplicar(); })" Placeholder="Todos" /></label>
        <div class="flt flt-planta"><span class="flt-label">Planta</span><SeletorPlanta Value="@FPlanta" ValueChanged="id => { FPlanta = id ?? string.Empty; Aplicar(); }" Vazio="Todas as plantas" Placeholder="Todas" SoAtivas="false" /></div>
        <label class="flt" title="Do local previsto (planta) ou, sem local, da cidade de residência"><span class="flt-label">País</span>
            <CampoLista Value="@FPais" ValueChanged="@((string v) => { FPais = v; Aplicar(); })" Opcoes="@(Paises)" Placeholder="Todos" Class="field" /></label>
        <label class="flt" title="Do local previsto (planta) ou, sem local, da cidade de residência"><span class="flt-label">Estado</span>
            <CampoLista Value="@FUf" ValueChanged="@((string v) => { FUf = v; Aplicar(); })" Opcoes="@(Estados)" Placeholder="Todos" Class="field" /></label>
        <label class="flt" title="Do local previsto (planta) ou, sem local, da cidade de residência"><span class="flt-label">Cidade</span>
            <CampoLista Value="@FCidade" ValueChanged="@((string v) => { FCidade = v; Aplicar(); })" Opcoes="@(Cidades)" Placeholder="Todas" Class="field" /></label>
        <label class="flt" title="Técnicos com compromisso no período"><span class="flt-label">Período de</span>
            <input type="date" class="flt-date" value="@Ui.DataInput(FDe)" @onchange="e => { FDe = Ui.DoDataInput(e.Value?.ToString()); Aplicar(); }" /></label>
        <label class="flt"><span class="flt-label">até</span>
            <input type="date" class="flt-date" value="@Ui.DataInput(FAte)" @onchange="e => { FAte = Ui.DoDataInput(e.Value?.ToString()); Aplicar(); }" /></label>
        @if (TemFiltro) { <button class="btn-link" @onclick="Limpar">@Icons.Svg("x")Limpar filtros</button> }
    </div>
    @if (!string.IsNullOrEmpty(_kpi))
    {
        <div class="chips-ativos">Indicador: <span class="chip active">@NomeKpi(_kpi) <button class="chip-x" @onclick="@(() => { _kpi = ""; Aplicar(); })" aria-label="Remover filtro do indicador">×</button></span></div>
    }

    @if (_kpi == "viagens")
    {
        <section class="panel" aria-label="Viagens previstas" style="margin-bottom:12px">
            <div class="panel-head"><div class="panel-title">Viagens previstas <span class="hint">@_kViagensPrev.Count viagem(ns) — a lista de técnicos abaixo pode ter menos linhas, pois um técnico pode ter várias viagens</span></div></div>
            <div class="table-wrap"><table class="grid-tbl">
                <thead><tr><th>Viagem</th><th>Destino</th><th>Início</th><th>Técnicos</th><th>Status</th></tr></thead>
                <tbody>
                @foreach (var v in _kViagensPrev.Select(id => _snap.Viagem(id)).Where(v => v is not null).OrderBy(v => _prevIni[v!.Id]))
                {
                    var nomes = Ui.Ids(v!.TecnicoIds).Select(t => _snap.Tecnicos.TryGetValue(t, out var tc) ? tc.Nome : "?").ToList();
                    <tr><td><a href="/viagens/@v.Id">@v.Codigo</a></td><td>@(string.IsNullOrEmpty(v.Destino) ? "—" : v.Destino)</td><td>@Ui.Hora(_prevIni[v.Id], _snap.FusoPadrao, _snap)</td>
                        <td>@(nomes.Count == 0 ? "sem técnico" : string.Join(", ", nomes))</td><td>@(Vocab.StatusViagem.FirstOrDefault(x => x.Key == v.Status)?.Label ?? v.Status)</td></tr>
                }
                </tbody></table></div>
        </section>
    }

    <div class="op-grid">
        <section class="op-lista panel" aria-label="Técnicos">
            <div class="panel-head"><div class="panel-title">Equipe <span class="hint">@_visiveis.Count de @_estados.Count</span></div></div>
            @if (_visiveis.Count == 0)
            {
                <div class="empty-state sm"><div class="ico">@Icons.Svg("search")</div><h3>Nenhum técnico encontrado</h3><p>Ajuste ou limpe os filtros.</p></div>
            }
            <div class="cards-tec">
                @foreach (var e in _visiveis)
                {
                    var it = Ui.Op(e.Status);
                    <button class="card-tec @(_sel == e.Tecnico.Id ? "sel" : "")" @onclick="() => AbrirTecnico(e.Tecnico.Id)">
                        <Avatar Nome="@e.Tecnico.Nome" FotoId="@e.Tecnico.FotoAnexoId" Cor="@it.Color" />
                        <div class="ct-corpo">
                            <div class="ct-nome">@e.Tecnico.Nome</div>
                            <StatusBadge Item="@it" />
                            <div class="ct-linha">@Icons.Svg("pin")<span>@LinhaLocal(e)</span></div>
                            @if (e.Atual is { } at && e.Status == Vocab.OpAtendimento)
                            {
                                <div class="ct-linha muted">@Icons.Svg("wrench")<span>@at.Titulo · até @Ui.Hora(at.Fim, at.Fuso, _snap)</span></div>
                            }
                            else if (e.Proximo is { } nx)
                            {
                                <div class="ct-linha muted">@Icons.Svg("calendar")<span>Próx.: @Ui.Corte(nx.Titulo, 34) · @Ui.Hora(nx.Ini, nx.Fuso, _snap)</span></div>
                            }
                        </div>
                    </button>
                }
            </div>
        </section>

        <section class="op-mapa panel" aria-label="Mapa">
            <div class="mapa-leg">
                <span class="leg"><i class="mk-amostra conf"></i>Localização confirmada</span>
                <span class="leg"><i class="mk-amostra prev"></i>Localização prevista (agenda)</span>
                <span class="leg"><i class="mk-amostra rota"></i>Deslocamento (origem → destino; sem rastreamento)</span>
                @foreach (var s in Vocab.StatusOp.Where(x => x.Key != Vocab.OpSemProg)) { <span class="leg"><i class="cor" style="background:@s.Color"></i>@s.Label</span> }
            </div>
            <div id="mapa-op" class="mapa" role="application" aria-label="Mapa de localização da equipe" tabindex="0"></div>
            @if (_auto)
            {
                <div class="auto-ctl">
                    <button class="btn-ghost sm" @onclick="@(() => _autoPausa = !_autoPausa)">@Icons.Svg(_autoPausa ? "play" : "clock")@(_autoPausa ? "Continuar" : "Pausar")</button>
                    <span class="auto-vel" role="group" aria-label="Velocidade">
                        @foreach (var v in new[] { ("lenta", "Lenta"), ("normal", "Normal"), ("rapida", "Rápida") }) { <button class="@(_autoVel == v.Item1 ? "on" : "")" @onclick="@(() => _autoVel = v.Item1)">@v.Item2</button> }
                    </span>
                    <button class="btn-ghost sm" @onclick="PararAuto">@Icons.Svg("x")Parar (Esc)</button>
                </div>
                <div class="auto-card" style="--c:@_autoCor" aria-live="polite">
                    <div class="auto-topo"><span class="auto-ico">@Icons.Svg(_autoIcone)</span><div><div class="auto-tit">@_autoTitulo</div><div class="auto-sub">@_autoSub</div></div></div>
                    @if (_autoMostraQtd) { <div class="auto-qtd">@_autoQtd</div> }
                    <ul class="auto-lista">
                        @for (var i = 0; i < _autoItens.Count; i++)
                        {
                            var it = _autoItens[i];
                            <li class="@(i == 0 ? "novo" : "")"><i style="background:@it.cor"></i><div><strong>@it.nome</strong>@if (!string.IsNullOrEmpty(it.det)) { <span>@it.det</span> }</div></li>
                        }
                        @if (_autoMostraQtd && _autoItens.Count == 0) { <li class="vazio">Nenhum no momento</li> }
                    </ul>
                </div>
                <div class="auto-passos">@for (var i = 0; i < _etapas.Length; i++) { <span class="@(i == _autoEtapa ? "on" : i < _autoEtapa ? "ok" : "")" title="@_etapas[i].titulo"><i style="background:@_etapas[i].cor"></i>@_etapas[i].curto</span> }</div>
            }
            @if (_semMapa.Count > 0)
            {
                <div class="sem-mapa">
                    @Icons.Svg("help")<strong>@_semMapa.Count sem localização no mapa:</strong>
                    @foreach (var e in _semMapa) { <button class="chip" @onclick="() => AbrirTecnico(e.Tecnico.Id)">@e.Tecnico.Nome</button> }
                </div>
            }
            <div class="mapa-nota muted">
                Posições <strong>previstas</strong> vêm da agenda e não são rastreamento por GPS. Durante a viagem só se mostram origem, destino e período.
                @if (!Geo.Configurado) { <span class="cfg-pend"> Geocodificação desativada: plantas sem coordenadas ficam "localização pendente".</span> }
            </div>
        </section>
    </div>
}

<PainelGerencial Snap="@_snap" Estados="@_estados" Eventos="@_eventos" Instante="@_instante" />

@if (_grupo is not null)
{
    <div class="modal-backdrop" @onclick="@(() => _grupo = null)">
        <div class="modal" @onclick:stopPropagation="true" role="dialog" aria-label="Técnicos no local">
            <div class="modal-topo"><h2>@_grupo.Titulo</h2><button class="icon-btn" @onclick="@(() => _grupo = null)" aria-label="Fechar">@Icons.Svg("x")</button></div>
            <p class="muted">@_grupo.Estados.Count técnico(s) neste local — escolha um para ver os detalhes.</p>
            <div class="cards-tec">
                @foreach (var e in _grupo.Estados)
                {
                    var it = Ui.Op(e.Status);
                    <button class="card-tec" @onclick="() => { _grupo = null; AbrirTecnico(e.Tecnico.Id); }">
                        <Avatar Nome="@e.Tecnico.Nome" FotoId="@e.Tecnico.FotoAnexoId" Cor="@it.Color" />
                        <div class="ct-corpo"><div class="ct-nome">@e.Tecnico.Nome</div><StatusBadge Item="@it" />
                            <div class="ct-linha muted">@(e.ConfirmacaoVigente ? "Localização confirmada" : "Localização prevista")</div></div>
                    </button>
                }
            </div>
        </div>
    </div>
}

@if (_painel is not null)
{
    <PainelTecnico E="@_painel" Snap="@_snap" Eventos="@_eventos" Ator="@_ator" Instante="@_instante" OnFechar="FecharPainel" OnConfirmar="AbrirConfirmar" />
}

@if (_confirmando is not null)
{
    <Dialogo Titulo="@($"Confirmar localização · {_confirmando.Nome}")" OnFechar="@(() => _confirmando = null)" Erros="_errosConf">
        <p class="muted">Registra onde o técnico <strong>está agora</strong>. Fica separado da localização prevista pela agenda e mostra data, hora e quem informou.</p>
        <div class="form-grid">
            <div class="fld full">Planta<SeletorPlanta Value="@_confPlanta" ValueChanged="id => _confPlanta = id ?? string.Empty" Vazio="— outro local (descrever abaixo) —" Placeholder="— outro local (descrever abaixo) —" /></div>
            <label class="fld full">Descrição do local (opcional se escolheu uma planta)
                <input class="field" @bind="_confTexto" placeholder="Ex.: Hotel Central, Calama" /></label>
            <label class="fld full">Observação
                <input class="field" @bind="_confObs" /></label>
        </div>
        <p class="muted sm">Sem planta, a confirmação fica registrada em texto e não aparece no mapa (não há coordenadas).</p>
        <div class="modal-actions">
            <button class="btn-ghost" @onclick="@(() => _confirmando = null)">Cancelar</button>
            <button class="btn-primary" @onclick="SalvarConfirmacao">@Icons.Svg("check")Confirmar</button>
        </div>
    </Dialogo>
}

@code {
    [Inject] private Geocoder Geo { get; set; } = default!;

    private Ator _ator = new();
    private Snapshot _snap = new();
    private List<Evento> _eventos = new();
    private List<Conflito> _conflitos = new();
    private List<Estado> _estados = new();
    private List<Estado> _visiveis = new();
    private List<Estado> _semMapa = new();
    private bool _carregando = true; private string? _erro;
    private Dictionary<string, DateTime> _prevIni = new();
    private DateTime _instante = DateTime.UtcNow; private bool _agora = true; private string _dataStr = "";

    public string FTec { get; set; } = ""; public string FEsp { get; set; } = ""; public string FStatus { get; set; } = "";
    public string FCli { get; set; } = ""; public string FPlanta { get; set; } = ""; public string FPais { get; set; } = "";
    public string FUf { get; set; } = ""; public string FCidade { get; set; } = "";
    public DateTime? FDe { get; set; } public DateTime? FAte { get; set; }
    private string _kpi = "";

    private HashSet<string> _kDisp = new(), _kAtend = new(), _kViag = new(), _kFer = new(), _kInd = new(), _kSem = new(),
        _kViagensPrev = new(), _kConf = new(), _kDocs = new(), _kPend = new();
    private Dictionary<string, HashSet<string>> _viagensPrevPorTec = new();

    private string? _sel; private Estado? _painel;
    private sealed record GrupoMapa(string Chave, string Titulo, List<Estado> Estados);
    private Dictionary<string, GrupoMapa> _grupos = new();
    private GrupoMapa? _grupo;
    private Tecnico? _confirmando; private string _confPlanta = "", _confTexto = "", _confObs = ""; private List<string>? _errosConf;
    private DotNetObjectReference<Home>? _ref; private bool _mapaPronto; private bool _redesenhar;

    private IEnumerable<string> Paises => PaisesLista();
    private IEnumerable<string> Estados => _snap.Plantas.Values.Select(p => p.Estado).Concat(_snap.Tecnicos.Values.Select(t => t.Estado)).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x);
    private IEnumerable<string> Cidades => _snap.Plantas.Values.Select(p => p.Cidade).Concat(_snap.Tecnicos.Values.Select(t => t.Cidade)).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x);
    private IEnumerable<string> PaisesLista() => _snap.Plantas.Values.Select(p => p.Pais).Concat(_snap.Tecnicos.Values.Select(t => t.Pais)).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x);

    private bool TemFiltro => new[] { FTec, FEsp, FStatus, FCli, FPlanta, FPais, FUf, FCidade }.Any(x => !string.IsNullOrEmpty(x)) || FDe.HasValue || FAte.HasValue || !string.IsNullOrEmpty(_kpi);

    protected override async Task OnInitializedAsync()
    {
        _ator = await Sessao.AtorAsync();
        Sessao.Mudou += AoMudarSessao;
        _ref = DotNetObjectReference.Create(this);
        await Recarregar(false);
    }

    private void AoMudarSessao() => InvokeAsync(StateHasChanged);

    private async Task Recarregar(bool aviso)
    {
        _carregando = _estados.Count == 0; _erro = null;
        try
        {
            _snap = Svc.Foto();
            _eventos = AgendaEngine.Eventos(_snap);
            _conflitos = AgendaEngine.Conflitos(_snap, _eventos);
            if (_agora) _instante = DateTime.UtcNow;
            _dataStr = Ui.ParaInput(_instante, _snap.FusoPadrao);
            Calcular();
            if (_painel is not null) _painel = _estados.FirstOrDefault(x => x.Tecnico.Id == _painel.Tecnico.Id);
            if (aviso) Sessao.Avisar("Dados atualizados.");
        }
        catch (Exception ex) { _erro = ex.Message; }
        _carregando = false; _redesenhar = true;
    }

    private void Calcular()
    {
        var agora = DateTime.UtcNow;
        _estados = _snap.Tecnicos.Values.Where(t => t.Ativo && _ator.VeTecnico(t.Id))
            .Select(t => AgendaEngine.EstadoEm(_snap, _eventos, t, _instante, agora)).ToList();
        var ids = _estados.Select(e => e.Tecnico.Id).ToHashSet();
        HashSet<string> De(string st) => _estados.Where(e => e.Status == st).Select(e => e.Tecnico.Id).ToHashSet();
        _kDisp = De(Vocab.OpDisponivel); _kAtend = De(Vocab.OpAtendimento); _kViag = De(Vocab.OpViagem);
        _kFer = De(Vocab.OpFerias); _kInd = De(Vocab.OpIndisponivel); _kSem = De(Vocab.OpSemProg);

        // viagens previstas: ainda não iniciadas
        _viagensPrevPorTec = new(); _prevIni = new();
        var prev = new HashSet<string>();
        foreach (var v in _snap.Viagens.Values.Where(v => v.Status is Vocab.ViagemRascunho or Vocab.ViagemPlanejada or Vocab.ViagemConfirmada))
        {
            var ini = _eventos.Where(e => e.ViagemId == v.Id).Select(e => (DateTime?)e.Ini).Min();
            if (ini is null || ini < _instante) continue;
            prev.Add(v.Id); _prevIni[v.Id] = ini.Value;
            foreach (var t in Ui.Ids(v.TecnicoIds).Where(ids.Contains))
            { if (!_viagensPrevPorTec.TryGetValue(t, out var l)) _viagensPrevPorTec[t] = l = new(); l.Add(v.Id); }
        }
        _kViagensPrev = prev;

        // conflitos
        _kConf = _conflitos.Where(c => c.B.Fim >= _instante && ids.Contains(c.TecnicoId)).Select(c => c.TecnicoId).ToHashSet();

        // documentos a vencer / vencidos
        var hoje = DocEngine.Hoje(_snap.FusoPadrao);
        _kDocs = DocEngine.Vencimentos(_snap, hoje).Where(l => l.Status is Vocab.DocProximo or Vocab.DocVencido && ids.Contains(l.Doc.TecnicoId))
            .Select(l => l.Doc.TecnicoId).ToHashSet();

        // pendências documentais p/ atendimentos programados
        _kPend = new();
        foreach (var a in _snap.Atendimentos.Where(a => a.FimPrev >= _instante))
        {
            var v = _snap.Viagem(a.ViagemId);
            if (v?.Status == Vocab.ViagemCancelada || (v is null && a.Status == Vocab.ViagemCancelada)) continue;
            var tecs = Ui.Ids(a.TecnicoIds); if (tecs.Length == 0 && v is not null) tecs = Ui.Ids(v.TecnicoIds);
            var serv = string.IsNullOrEmpty(a.ServicoId) ? v?.ServicoId : a.ServicoId;
            var reqs = DocEngine.RequisitosDe(_snap, new[] { serv }, new[] { a.PlantaId });
            foreach (var tid in tecs.Where(ids.Contains))
                if (DocEngine.Avaliar(_snap, _snap.Tecnicos[tid], reqs, a.IniPrev, a.FimPrev, hoje, _snap.Planta(a.PlantaId)?.FusoHorario).Pendencias.Count > 0)
                    _kPend.Add(tid);
        }
        Aplicar();
    }

    private (string cid, string uf, string pais) LocalGeo(Estado e)
    {
        var p = e.Planta;
        return p is not null ? (p.Cidade, p.Estado, p.Pais) : (e.Tecnico.Cidade, e.Tecnico.Estado, e.Tecnico.Pais);
    }

    private void Aplicar()
    {
        IEnumerable<Estado> q = _estados;
        if (!string.IsNullOrEmpty(FTec)) q = q.Where(e => e.Tecnico.Id == FTec);
        if (!string.IsNullOrEmpty(FEsp)) q = q.Where(e => Ui.Ids(e.Tecnico.EspecialidadeIds).Contains(FEsp));
        if (!string.IsNullOrEmpty(FStatus)) q = q.Where(e => e.Status == FStatus);
        if (!string.IsNullOrEmpty(FCli)) q = q.Where(e => Assoc(e)?.ClienteId == FCli || EventosDe(e).Any(x => x.ClienteId == FCli && x.Fim >= _instante));
        if (!string.IsNullOrEmpty(FPlanta)) q = q.Where(e => Assoc(e)?.PlantaId == FPlanta || EventosDe(e).Any(x => x.PlantaId == FPlanta && x.Fim >= _instante));
        if (!string.IsNullOrEmpty(FPais)) q = q.Where(e => Ui.Contem(LocalGeo(e).pais, FPais));
        if (!string.IsNullOrEmpty(FUf)) q = q.Where(e => Ui.Contem(LocalGeo(e).uf, FUf));
        if (!string.IsNullOrEmpty(FCidade)) q = q.Where(e => Ui.Contem(LocalGeo(e).cid, FCidade));
        if (FDe.HasValue || FAte.HasValue)
        {
            var de = FDe.HasValue ? Tempo.ParaUtc(FDe.Value, _snap.FusoPadrao) : DateTime.MinValue;
            var ate = FAte.HasValue ? Tempo.ParaUtc(FAte.Value.AddDays(1), _snap.FusoPadrao) : DateTime.MaxValue;
            q = q.Where(e => EventosDe(e).Any(x => (x.Bloqueia || x.Provisorio) && x.Cruza(de, ate)));
        }
        q = _kpi switch
        {
            "disponivel" => q.Where(e => _kDisp.Contains(e.Tecnico.Id)),
            "atendimento" => q.Where(e => _kAtend.Contains(e.Tecnico.Id)),
            "viagem" => q.Where(e => _kViag.Contains(e.Tecnico.Id)),
            "ferias" => q.Where(e => _kFer.Contains(e.Tecnico.Id)),
            "viagens" => q.Where(e => _viagensPrevPorTec.ContainsKey(e.Tecnico.Id)),
            "conflitos" => q.Where(e => _kConf.Contains(e.Tecnico.Id)),
            "docs" => q.Where(e => _kDocs.Contains(e.Tecnico.Id)),
            "pend" => q.Where(e => _kPend.Contains(e.Tecnico.Id)),
            _ => q,
        };
        _visiveis = q.OrderBy(e => Ui.PesoOp(e.Status)).ThenBy(e => e.Tecnico.Nome).ToList();
        MontarGrupos();
        _redesenhar = true;
    }

    private Evento? Assoc(Estado e) => e.Atual ?? e.Proximo;
    private IEnumerable<Evento> EventosDe(Estado e) => _eventos.Where(x => x.TecnicoId == e.Tecnico.Id && x.Status != "cancelado");

    // posição de cada técnico no mapa: confirmada vigente > prevista
    private (double lat, double lon, bool conf, string texto)? Posicao(Estado e)
    {
        if (e.ConfirmacaoVigente && e.Confirmacao is { Lat: { } la, Lon: { } lo } c) return (la, lo, true, c.Texto);
        if (e.TemLocalMapa) return (e.Lat!.Value, e.Lon!.Value, false, e.LocalTexto);
        return null;
    }

    private void MontarGrupos()
    {
        _grupos = new(); _semMapa = new();
        foreach (var g in _visiveis.Select(e => (e, p: Posicao(e))).GroupBy(x => x.p is null ? "" : $"{Math.Round(x.p.Value.lat, 3):0.000}|{Math.Round(x.p.Value.lon, 3):0.000}"))
        {
            if (g.Key == "") { _semMapa.AddRange(g.Select(x => x.e)); continue; }
            var primeiro = g.First();
            var titulo = primeiro.e.Planta is not null ? _snap.NomePlanta(primeiro.e.Planta.Id) : (string.IsNullOrWhiteSpace(primeiro.p!.Value.texto) ? "Local" : primeiro.p.Value.texto);
            if (primeiro.e.Status == Vocab.OpViagem && primeiro.e.Atual is { } at) titulo = $"A caminho: {at.LocalFim}";
            _grupos[g.Key] = new GrupoMapa(g.Key, titulo, g.Select(x => x.e).ToList());
        }
    }

    private object DadosMapa()
    {
        var grupos = new List<object>(); var rotas = new List<object>();
        var todos = _grupos.Values.ToList(); var lista = _revelar is int rv ? todos.Take(rv).ToList() : todos;
        var extras = _revelar is null ? new List<double[]>() : todos.Select(g => Posicao(g.Estados[0])!.Value).Select(p => new[] { p.lat, p.lon }).ToList();
        var vis = lista.SelectMany(g => g.Estados).Select(e => e.Tecnico.Id).ToHashSet();
        foreach (var g in lista)
        {
            var pos = Posicao(g.Estados[0])!.Value;
            var cores = g.Estados.Select(e => Ui.Op(e.Status).Color).Distinct().ToList();
            var todosConf = g.Estados.All(e => Posicao(e)!.Value.conf);
            var viagem = g.Estados.All(e => e.Status == Vocab.OpViagem);
            grupos.Add(new
            {
                chave = g.Chave, lat = pos.lat, lon = pos.lon, titulo = g.Titulo, novo = _revelar is int r2 && g == lista[^1] && r2 > 0,
                cor = cores.Count == 1 ? cores[0] : "#004785", tracejado = !todosConf, viagem,
                iniciais = Avatar.Iniciais(g.Estados[0].Tecnico.Nome),
                rotulo = viagem ? "Em deslocamento (posição no trajeto não rastreada)" : todosConf ? "Localização confirmada" : "Localização prevista pela agenda",
                tecnicos = g.Estados.Select(e => new { nome = $"{e.Tecnico.Nome} — {Ui.Op(e.Status).Label} ({(Posicao(e)!.Value.conf ? "confirmada" : "prevista")})", cor = Ui.Op(e.Status).Color }),
            });
        }
        foreach (var e in _visiveis.Where(e => vis.Contains(e.Tecnico.Id) && e.Status == Vocab.OpViagem && e.Atual is { LatIni: not null, LonIni: not null, LatFim: not null, LonFim: not null }))
        {
            var a = e.Atual!;
            rotas.Add(new { de = new[] { a.LatIni!.Value, a.LonIni!.Value }, para = new[] { a.LatFim!.Value, a.LonFim!.Value }, cor = Ui.Op(e.Status).Color,
                titulo = $"{e.Tecnico.Nome}: {a.LocalIni} → {a.LocalFim} · {Ui.Periodo(a.Ini, a.Fim, a.Fuso, _snap)}" });
        }
        return new { grupos, rotas, ajustar = _autoAjustar, extras };
    }

    // ---------------------------------------------------------------- modo automático
    private bool _auto, _autoPausa, _apresAntes, _autoMostraQtd, _autoAjustar = true; private string _autoVel = "normal";
    private int? _revelar; private int _autoEtapa, _autoQtd; private CancellationTokenSource? _autoCts;
    private string _autoTitulo = "", _autoSub = "", _autoCor = "#004785", _autoIcone = "map";
    private List<(string nome, string det, string cor)> _autoItens = new();
    private static readonly (string chave, string titulo, string curto, string cor, string icone, string sub)[] _etapas =
    {
        ("mapa", "Onde está cada técnico", "Mapa", "#004785", "map", "A equipe aparece no mapa, um local por vez"),
        ("disponivel", "Disponíveis", "Disponíveis", "#1f9254", "check", "Sem compromisso neste momento (inclui quem não tem programação)"),
        ("atendimento", "Em atendimento", "Atendimento", "#0369a1", "customers", "Na planta do cliente"),
        ("viagem", "Em viagem", "Viagem", "#d9822b", "plane", "Em deslocamento"),
        ("ferias", "Em férias", "Férias", "#7b4fc0", "sun", "Férias vigentes"),
        ("viagens", "Viagens previstas", "Previstas", "#004785", "route", "Viagens ainda não iniciadas"),
        ("conflitos", "Conflitos de agenda", "Conflitos", "#c0392b", "alert", "Sobreposição ou deslocamento a verificar"),
        ("docs", "Documentos a vencer / vencidos", "Docs", "#b7791f", "clock", "Técnicos com documento próximo do vencimento ou vencido"),
        ("pend", "Pendências documentais", "Pendências", "#c0392b", "shield", "Escalados sem todos os requisitos para o atendimento programado"),
    };

    private async Task IniciarAuto()
    {
        if (_auto || _carregando) return;
        _apresAntes = Sessao.Apresentacao; Sessao.Apresentacao = true;
        try { await JS.InvokeVoidAsync("app.apresentacao", true); await JS.InvokeVoidAsync("app.autoTela", true, _ref); } catch { }
        if (!_agora) VoltarAgora();
        Limpar(); _auto = true; _autoPausa = false; _autoCts = new CancellationTokenSource();
        StateHasChanged(); _ = LoopAuto(_autoCts.Token);
    }

    [JSInvokable] public Task PararAutoJs() => InvokeAsync(PararAuto);

    private async Task PararAuto()
    {
        if (!_auto) return;
        _autoCts?.Cancel(); _auto = false; _revelar = null; _autoAjustar = true; _kpi = ""; _autoItens = new();
        Aplicar();
        try
        {
            await JS.InvokeVoidAsync("app.autoTela", false, _ref);
            if (!_apresAntes) { Sessao.Apresentacao = false; await JS.InvokeVoidAsync("app.apresentacao", false); }
        }
        catch { }
        StateHasChanged();
    }

    private async Task Espera(int ms, CancellationToken ct)
    {
        var rest = ms * (_autoVel switch { "lenta" => 1.7, "rapida" => 0.55, _ => 1.0 });
        while (rest > 0) { await Task.Delay(100, ct); if (!_autoPausa) rest -= 100; }
    }

    private void Etapa(int i)
    {
        _autoEtapa = i; var e = _etapas[i]; _autoTitulo = e.titulo; _autoCor = e.cor; _autoIcone = e.icone; _autoSub = e.sub;
    }

    private async Task LoopAuto(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                if (_agora) await Recarregar(false);
                await EtapaMapa(ct);
                for (var i = 1; i < _etapas.Length; i++) await EtapaIndicador(i, ct);
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { Sessao.Avisar("Modo automático interrompido: " + ex.Message, true); await PararAuto(); }
    }

    private async Task EtapaMapa(CancellationToken ct)
    {
        Etapa(0); _kpi = ""; Aplicar(); _autoMostraQtd = false; _autoItens = new();
        var grupos = _grupos.Values.ToList(); var n = grupos.Count;
        _revelar = 0; _autoAjustar = true; _redesenhar = true; StateHasChanged();
        await Espera(1500, ct);
        var passo = n > 20 ? 800 : 1500;
        for (var i = 1; i <= n; i++)
        {
            var g = grupos[i - 1]; _revelar = i; _autoAjustar = false; _redesenhar = true;
            foreach (var e in g.Estados)
            {
                var it = Ui.Op(e.Status);
                _autoItens.Insert(0, (e.Tecnico.Nome, $"{it.Label} · {Ui.Corte(g.Titulo, 40)}", it.Color));
            }
            if (_autoItens.Count > 14) _autoItens = _autoItens.Take(14).ToList();
            _autoSub = $"Local {i} de {n} · {g.Titulo}";
            StateHasChanged(); await Espera(passo, ct);
        }
        _revelar = null; _redesenhar = true;
        _autoSub = $"{_visiveis.Count} técnico(s) em {n} local(is)" + (_semMapa.Count > 0 ? $" · {_semMapa.Count} sem localização" : "");
        foreach (var e in _semMapa) _autoItens.Insert(0, (e.Tecnico.Nome, "Sem localização no mapa", "#8793a6"));
        StateHasChanged(); await Espera(2500, ct);
    }

    private async Task EtapaIndicador(int idx, CancellationToken ct)
    {
        Etapa(idx); var chave = _etapas[idx].chave;
        _revelar = null; _autoAjustar = true; _kpi = chave; Aplicar();
        _autoItens = ItensDe(chave); _autoMostraQtd = true;
        _autoQtd = chave == "viagens" ? _kViagensPrev.Count : _visiveis.Count;
        StateHasChanged();
        await Espera(_autoItens.Count == 0 ? 3000 : 4200 + Math.Min(_autoItens.Count, 10) * 500, ct);
    }

    private List<(string nome, string det, string cor)> ItensDe(string chave)
    {
        var cor = _etapas.First(x => x.chave == chave).cor;
        if (chave == "viagens")
            return _kViagensPrev.Select(id => _snap.Viagem(id)).Where(v => v is not null).OrderBy(v => _prevIni[v!.Id])
                .Select(v => ($"{v!.Codigo} · {(string.IsNullOrEmpty(v.Destino) ? "—" : v.Destino)}",
                    $"{string.Join(", ", Ui.Ids(v.TecnicoIds).Select(t => _snap.Tecnicos.TryGetValue(t, out var tc) ? tc.Nome : "?"))} · {Ui.Hora(_prevIni[v.Id], _snap.FusoPadrao, _snap)}", cor)).ToList();
        var hoje = DocEngine.Hoje(_snap.FusoPadrao);
        return _visiveis.Select(e =>
        {
            var det = chave switch
            {
                "disponivel" => e.Proximo is { } nx ? $"Próx.: {Ui.Corte(nx.Titulo, 38)} · {Ui.Hora(nx.Ini, nx.Fuso, _snap)}" : LinhaLocal(e),
                "atendimento" => e.Atual is { } a ? $"{Ui.Corte(a.Titulo, 40)} · até {Ui.Hora(a.Fim, a.Fuso, _snap)}" : "",
                "viagem" => e.Atual is { } v ? $"A caminho: {Ui.Corte(v.LocalFim, 40)} · chega {Ui.Hora(v.Fim, v.Fuso, _snap)}" : "",
                "ferias" => e.Atual is { } f ? $"Até {Ui.Hora(f.Fim, f.Fuso, _snap)}" : "",
                "conflitos" => _conflitos.Where(c => c.TecnicoId == e.Tecnico.Id && c.B.Fim >= _instante).Select(c => c.Motivo).FirstOrDefault() ?? "Conflito de agenda",
                "docs" => string.Join("; ", DocEngine.Vencimentos(_snap, hoje).Where(l => l.Doc.TecnicoId == e.Tecnico.Id && l.Status is Vocab.DocProximo or Vocab.DocVencido)
                    .Select(l => $"{l.Doc.Nome} ({(l.Status == Vocab.DocVencido ? "vencido" : "vence " + (l.Doc.Vencimento?.ToString("dd/MM/yyyy") ?? ""))})").Take(3)),
                "pend" => "Atendimento programado com requisito pendente",
                _ => "",
            };
            return (e.Tecnico.Nome, det, Ui.Op(e.Status).Color);
        }).ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_carregando || _erro is not null) return;
        try
        {
            if (!_mapaPronto)
            {
                _mapaPronto = await JS.InvokeAsync<bool>("app.mapa.iniciar", "mapa-op", _ref, new
                {
                    centro = new[] { -15.0, -52.0 }, zoom = 4,
                    tileUrl = Cfg["Mapa:TileUrl"], atribuicao = Cfg["Mapa:Atribuicao"],
                });
                _redesenhar = true;
            }
            if (_mapaPronto && _redesenhar)
            {
                _redesenhar = false;
                await JS.InvokeVoidAsync("app.mapa.desenhar", "mapa-op", DadosMapa());
            }
        }
        catch (JSDisconnectedException) { }
        catch (Exception) { /* mapa indisponível: a lista continua funcionando */ }
    }

    [JSInvokable]
    public async Task AoClicarGrupo(string chave)
    {
        if (!_grupos.TryGetValue(chave, out var g)) return;
        if (g.Estados.Count == 1) AbrirTecnico(g.Estados[0].Tecnico.Id); else _grupo = g;
        await InvokeAsync(StateHasChanged);
    }

    private void AbrirTecnico(string id)
    {
        _sel = id; _painel = _estados.FirstOrDefault(e => e.Tecnico.Id == id);
        if (_painel is not null && Posicao(_painel) is { } p) _ = JS.InvokeVoidAsync("app.mapa.foco", "mapa-op", p.lat, p.lon, 9);
    }
    private void FecharPainel() { _painel = null; _sel = null; }

    private string LinhaLocal(Estado e)
    {
        if (e.LocalFonte == "nenhum") return "Sem localização definida";
        var tipo = e.ConfirmacaoVigente ? "confirmada" : "prevista";
        return $"{Ui.Corte(e.ConfirmacaoVigente && e.Confirmacao is { } c ? c.Texto : e.LocalTexto, 40)} ({tipo})";
    }

    // ---- data/hora ----
    private void AoMudarData(ChangeEventArgs e)
    {
        var d = Ui.DoInput(e.Value?.ToString(), _snap.FusoPadrao);
        if (d is null) return;
        _instante = d.Value; _agora = false; _dataStr = e.Value!.ToString()!;
        Calcular();
    }
    private void VoltarAgora() { _agora = true; _instante = DateTime.UtcNow; _dataStr = Ui.ParaInput(_instante, _snap.FusoPadrao); Calcular(); }

    private bool Futuro => _instante > DateTime.UtcNow.AddMinutes(5);
    private bool Passado => _instante < DateTime.UtcNow.AddMinutes(-5);
    private string ClasseMomento => Futuro ? "m-fut" : Passado ? "m-pas" : "m-now";
    private string TextoMomento => Futuro ? "Previsão futura" : Passado ? "Período passado" : "Momento atual";
    private string TituloMomento => Futuro ? "Distribuição prevista a partir da agenda, não é situação real"
        : Passado ? "Reconstituído a partir dos registros atuais da agenda" : "Situação neste instante";

    // ---- indicadores ----
    private RenderFragment Kpi(string chave, string rotulo, int n, string icone, string cor, string dica) => __b =>
    {
        var ativo = _kpi == chave;
        __b.OpenElement(0, "button");
        __b.AddAttribute(1, "class", "kpi-tile" + (ativo ? " ativo" : ""));
        __b.AddAttribute(2, "style", $"--c:{cor}");
        __b.AddAttribute(3, "title", dica + " · clique para filtrar");
        __b.AddAttribute(4, "aria-pressed", ativo ? "true" : "false");
        __b.AddAttribute(5, "onclick", EventCallback.Factory.Create(this, () => { _kpi = ativo ? "" : chave; Aplicar(); }));
        __b.AddMarkupContent(6, $"<span class=\"kpi-ico\">{Icons.Svg(icone)}</span><span class=\"kpi-v\">{n}</span><span class=\"kpi-r\">{rotulo}</span>");
        __b.CloseElement();
    };

    private static string NomeKpi(string k) => k switch
    {
        "disponivel" => "Disponíveis", "atendimento" => "Em atendimento", "viagem" => "Em viagem", "ferias" => "Em férias",
        "viagens" => "Viagens previstas", "conflitos" => "Conflitos de agenda", "docs" => "Documentos a vencer / vencidos",
        "pend" => "Pendências para atendimentos programados", _ => k,
    };

    private void Limpar()
    {
        FTec = FEsp = FStatus = FCli = FPlanta = FPais = FUf = FCidade = ""; FDe = FAte = null; _kpi = "";
        Aplicar();
    }

    // ---- confirmar localização ----
    private void AbrirConfirmar()
    {
        if (_painel is null) return;
        _confirmando = _painel.Tecnico; _confPlanta = ""; _confTexto = ""; _confObs = ""; _errosConf = null;
    }

    private async Task SalvarConfirmacao()
    {
        if (_confirmando is null) return;
        try
        {
            Svc.ConfirmarLocal(_ator, _confirmando.Id, _confPlanta, _confTexto, null, null, _confObs);
            _confirmando = null;
            Sessao.Avisar("Localização confirmada.");
            await Recarregar(false);
        }
        catch (Exception ex) { _errosConf = Ui.Erros(ex); }
    }

    public void Dispose()
    {
        Sessao.Mudou -= AoMudarSessao;
        _autoCts?.Cancel();
        if (_auto) { try { _ = JS.InvokeVoidAsync("app.autoTela", false, null); } catch { } }
        try { _ = JS.InvokeVoidAsync("app.mapa.destruir", "mapa-op"); } catch { }
        _ref?.Dispose();
    }
