@page "/viagens/{Id}"
@attribute [Authorize]
@implements IDisposable
@inject Servicos Svc
@inject Db Db
@inject Geocoder Geo
@inject Sessao Sessao
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IConfiguration Cfg

<PageTitle>@(_novo ? "Nova viagem" : _v.Codigo) · Controle Técnico</PageTitle>
<div class="breadcrumbs"><a href="/viagens">Controladoria e viagens</a><span class="sep">/</span><span class="strong" style="color:var(--text-2)">@(_novo ? "Nova viagem" : _v.Codigo)</span></div>

@if (!_ok)
{
    <div class="state-box state-err">@Icons.Svg("lock")<div><strong>Viagem não encontrada ou sem permissão.</strong></div><a class="btn-ghost" href="/viagens">Voltar</a></div>
}
else
{
<div class="page-head compacto">
    <div>
        <h1>@(_novo ? "Nova viagem" : $"Viagem {_v.Codigo}") @if (!string.IsNullOrWhiteSpace(_v.Projeto)) { <span class="proj-tag">Proj. @_v.Projeto</span> } <StatusBadge Item="@Ui.StViagem(_v.Status)" /></h1>
    </div>
    @if (_pode)
    {
        <div class="momento-ctl">
            <button class="btn-ghost" @onclick="@(() => Salvar(null))">@Icons.Svg("check")Salvar</button>
            @if (_v.Status is Vocab.ViagemRascunho) { <button class="btn-ghost" @onclick="@(() => Salvar(Vocab.ViagemPlanejada))">Salvar como planejada</button> }
            @if (_v.Status is Vocab.ViagemRascunho or Vocab.ViagemPlanejada) { <button class="btn-primary" @onclick="@(() => Salvar(Vocab.ViagemConfirmada))" disabled="@(!_res.PodeConfirmar)" title="@(_res.PodeConfirmar ? "" : "Há pendências que impedem a confirmação")">@Icons.Svg("check")Confirmar</button> }
            <button class="btn-ghost os-btn" @onclick="AbrirEmail" title="@(_v.OsGeradoEm is { } og ? $"Último: {Ui.Hora(og, null, _snap)} por {_v.OsGeradoPor}" : "Montar o e-mail para os técnicos com os documentos")">@Icons.Svg("mail")<span>E-mail da OS</span>@if (_v.OsGeradoEm is not null) { <span class="tag ok">enviado</span> }</button>
            @if (_v.Status == Vocab.ViagemConfirmada) { <button class="btn-ghost" @onclick="@(() => Salvar(Vocab.ViagemAndamento))">@Icons.Svg("play")Iniciar</button> }
            @if (_v.Status == Vocab.ViagemAndamento) { <button class="btn-primary" @onclick="@(() => Salvar(Vocab.ViagemConcluida))">@Icons.Svg("flag")Concluir</button> }
            @if (!_novo && _v.Status != Vocab.ViagemCancelada && _v.Status != Vocab.ViagemConcluida) { <button class="btn-danger-ghost" @onclick="@(() => _cancelando = true)">@Icons.Svg("x")Cancelar viagem</button> }
            @if (!_novo && _v.Status == Vocab.ViagemCancelada) { <button class="btn-ghost" @onclick="@(() => Salvar(Vocab.ViagemRascunho))">Reabrir</button> }
        </div>
    }
</div>
@if (_v.Status == Vocab.ViagemCancelada) { <div class="alert-box alert-erro">@Icons.Svg("x")<div><strong>Cancelada:</strong> saiu da agenda e do mapa e não bloqueia a disponibilidade.</div></div> }
@if (_erros is { Count: > 0 }) { <div class="alert-box alert-erro" role="alert">@Icons.Svg("alert")<div>@foreach (var e in _erros) { <div>@e</div> }</div></div> }

@if (true)
{
    <div class="tabs vg-abas" role="tablist">
        <button role="tab" class="tab @(_abaV != "historico" ? "active" : "")" @onclick="@(() => _abaV = "viagem")">@Icons.Svg("plane")Viagem</button>
        <button role="tab" class="tab @(_abaV == "historico" ? "active" : "")" @onclick="@(() => _abaV = "historico")">@Icons.Svg("history")Histórico da viagem <span class="tab-n">@_nNotas</span></button>
    </div>
}
<div class="vs-grid" style="@(_abaV == "historico" ? "display:none" : "")">
<fieldset class="semborda vs-form" disabled="@(!_pode)">

    <div class="panel">
        <div class="form-grid">
            <label class="fld">Nº do projeto *<CampoLista Value="@_v.Projeto" ValueChanged="@((string x) => { _v.Projeto = x; })" Opcoes="@Ui.ProjetosUsados(_snap)" Placeholder="Ex.: 4500123456" /></label>
            <div class="fld full"><span>Equipamentos <span class="hint">um ou mais</span></span><CampoEquipamentos Value="@_v.Equipamentos" ValueChanged="@((string x) => { _v.Equipamentos = x; })" Sugestoes="@Ui.EquipamentosUsados(_snap)" Disabled="@(!_pode)" /></div>
            <label class="fld">Responsável da viagem <span class="hint">equipe de controle</span>
                <select value="@_v.ResponsavelLogin" @onchange="AoResponsavel">
                    <option value="">— sem responsável —</option>
                    @foreach (var u in _equipe) { <option value="@u.Id">@(string.IsNullOrWhiteSpace(u.Nome) ? u.Id : u.Nome)</option> }
                    @if (!string.IsNullOrEmpty(_v.ResponsavelLogin) && !_equipe.Any(u => u.Id == _v.ResponsavelLogin)) { <option value="@_v.ResponsavelLogin">@_v.Responsavel</option> }
                </select>
                @if (_equipe.Count == 0) { <span class="hint">Marque as usuárias da equipe de controle em Administração → Usuários.</span> }</label>
            <div class="fld">Cliente (contratante) <span class="hint">opcional · quem comprou, quando não é o cliente final</span>
                <SeletorPlanta Value="@_v.ContratantePlantaId" ValueChanged="@((string? id) => { _v.ContratantePlantaId = id ?? string.Empty; })" Vazio="— mesmo do cliente final —" Placeholder="— mesmo do cliente final —" /></div>
            <div class="fld">Cliente final (planta) * <span class="hint">onde o técnico vai</span><SeletorPlanta Value="@_v.PlantaId" ValueChanged="AoPlantaValor" Placeholder="Buscar planta por nome, cidade, estado, país…" /></div>
            <label class="fld">Serviço
                <SeletorLista Itens="@(_snap.Servicos.Values.Where(s => s.Ativo).OrderBy(s => s.Nome).Select(s => new SeletorLista.ItemSel(s.Id, s.Nome)))" Value="@_v.ServicoId" ValueChanged="@(async (string v) => { _v.ServicoId = v; Validar(); })" Placeholder="— selecione —" Criar="CriarServ" RotuloCriar="serviço" /></label>
            <div class="fld full"><span>Técnicos</span>
                <div class="chips-tec">@foreach (var t in _snap.Tecnicos.Values.Where(t => t.Ativo || _tecs.Contains(t.Id)).OrderBy(t => Vocab.SempreDisponivel(t.Perfil) ? 0 : 1).ThenBy(t => t.Nome)) {
                    <label class="chk-inline"><input type="checkbox" checked="@_tecs.Contains(t.Id)" @onchange="e => AlternarTec(t.Id, (bool)e.Value!)" />@t.Nome@if (!Vocab.SempreDisponivel(t.Perfil)) { <span class="tag perfil-tag">@Vocab.PerfilRotulo(t.Perfil)</span> }</label> }</div></div>
        </div>
    </div>

    <div class="diarias">
        @Bloco("ida", "Deslocamento de ida", "plane", "#d9822b", _ida, _fusoOrigem, _fusoPlanta, Dias(_ida.Ini, _ida.Fim), true)
        @Bloco("serv", "Serviço", "customers", "#0369a1", _serv, _fusoPlanta, _fusoPlanta, Dias(_serv.Ini, _serv.Fim), false)
        @foreach (var x in _extras)
        {
            @BlocoExtra(x)
        }
        @if (_pode)
        {
            <div class="translado-add">
                <button type="button" class="btn-ghost sm" @onclick="AdicionarTranslado">@Icons.Svg("plus")Adicionar translado (opcional)</button>
                <span class="muted sm">Ex.: o técnico volta para casa no meio da viagem e depois retorna à planta. O serviço é pausado nesse intervalo.</span>
            </div>
        }
        @Bloco("volta", "Deslocamento de volta", "plane", "#c26a14", _volta, _fusoPlanta, _fusoOrigem, Dias(_volta.Ini, _volta.Fim), true)
    </div>

    <DocumentosViagem ViagemId="@(_novo ? "" : Id)" Pendentes="_docsPend" Ator="@_ator" Pode="@_pode" VerAnexos="@_verAnexos" />

    <details class="mais" open="@_maisAberto">
        <summary @onclick="@(() => _maisAberto = !_maisAberto)" @onclick:preventDefault>Mais opções @Icons.Svg("chevron-right")</summary>
        <div class="form-grid mt8">
            <label class="fld">Status<select @bind="_v.Status" @bind:after="Validar">@foreach (var s in Vocab.StatusViagem) {<option value="@s.Key">@s.Label</option>}</select></label>
            <label class="fld">Horas de serviço previstas <span class="hint">opcional</span><input type="number" step="0.5" min="0" @bind="_horasPrev" /></label>
            <label class="fld">Horas de serviço realizadas <span class="hint">opcional</span><input type="number" step="0.5" min="0" @bind="_horasReal" /></label>
            <label class="fld full">Observações<textarea @bind="_v.Obs"></textarea></label>
        </div>
    </details>
</fieldset>

<aside class="vs-lado">
    @if (true) { <ChecklistViagem ViagemId="@(_novo ? "" : Id)" Itens="@Checklist.Ler(_v.Checklist)" Pode="@_pode" Sessao_Fuso="@_snap.FusoPadrao" OnMudou="AoChecklist" /> }
    <div class="panel mt16">
        <div class="panel-head"><div class="panel-title">Onde vai estar</div>@if (_planta is not null) { <GeoBadge P="_planta" /> }</div>
        <div class="vs-mapa-wrap">
            <div id="mapa-viagem" class="mapa vs-mapa" role="application" aria-label="Mapa do local do serviço"></div>
            @if (_planta is null) { <div class="vs-mapa-aviso">Selecione a planta para ver no mapa onde o técnico vai estar.</div> }
            else if (!_planta.TemCoord) { <div class="vs-mapa-aviso">@Icons.Svg("pin")<span>Esta planta ainda não tem localização no mapa.</span>
                @if (string.IsNullOrWhiteSpace(_planta.Cidade)) { <button class="btn-primary sm" @onclick="() => _pedirCidade = _planta.Id">Informar cidade</button> }
                else if (_localizando) { <span class="sm">Localizando pelo endereço…</span> }
                else if (Geo.Configurado) { <button class="btn-primary sm" @onclick="LocalizarAgora">Tentar localizar de novo</button> @if (!string.IsNullOrEmpty(_planta.GeoFonte)) { <span class="sm">@_planta.GeoFonte</span> } }
                else { <span class="sm">@Geo.Pendencia</span> }</div> }
        </div>
        @if (_planta is not null)
        {
            <div class="vs-local"><strong>@_snap.NomePlanta(_planta.Id)</strong>
                <div class="muted sm">@string.Join(", ", new[] { _planta.Rua, _planta.Cidade, _planta.Estado, _planta.Pais }.Where(x => !string.IsNullOrWhiteSpace(x)))</div>
                @if (_planta.TemCoord && !string.IsNullOrEmpty(_planta.GeoNivel) && _planta.GeoNivel != "endereco") { <div class="sm warn">Posição aproximada ao nível de @(_planta.GeoNivel == "pais" ? "país" : _planta.GeoNivel): o endereço exato não foi encontrado.</div> }</div>
        }
    </div>

    <div class="panel mt16">
        <div class="panel-head"><div class="panel-title">Diárias</div></div>
        <table class="tempos">
            <tr><th>Deslocamento de ida</th><td>@Diar(Dias(_ida.Ini, _ida.Fim))</td></tr>
            <tr><th>Serviço</th><td>@Diar(Dias(_serv.Ini, _serv.Fim))</td></tr>
            @foreach (var x in _extras) { <tr><th>@TituloExtra(x)</th><td>@Diar(Dias(x.Ini, x.Fim))</td></tr> }
            <tr><th>Deslocamento de volta</th><td>@Diar(Dias(_volta.Ini, _volta.Fim))</td></tr>
            <tr class="tot"><th>Total da viagem</th><td>@Diar(TotalDias())</td></tr>
        </table>
        <p class="muted sm">Diária = cada dia do calendário em que o técnico está naquela etapa (primeiro e último dia contam).</p>
    </div>

    <div class="panel mt16">
        <div class="panel-head"><div class="panel-title">Verificação</div></div>
        @if (!Tocou) { <p class="muted sm">Escolha a planta, os técnicos e as datas: a verificação de conflitos e de documentos aparece aqui.</p> }
        else {
        @if (_res.Erros.Count == 0 && _res.Conflitos.Count == 0 && _res.Avisos.Count == 0 && _res.Aptidoes.All(a => a.Apto) && _tecs.Count > 0 && _planta is not null) { <div class="alert-box alert-ok">@Icons.Svg("check")<div>Tudo certo: sem conflitos e sem pendências documentais.</div></div> }
        @foreach (var e in _res.Erros) { <div class="alert-box alert-erro">@Icons.Svg("x")<div>@e</div></div> }
        @foreach (var pid in _res.PlantasSemCidade) { <button class="btn-ghost sm mb8" @onclick="() => _pedirCidade = pid">@Icons.Svg("pin")Informar a cidade de @_snap.Planta(pid)?.Nome</button> }
        @foreach (var c in _res.Conflitos) { <div class="alert-box @(c.Erro ? "alert-erro" : "alert-aviso")">@Icons.Svg("alert")<div><strong>@(_snap.Tecnico(c.TecnicoId)?.Nome):</strong> @c.Motivo</div></div> }
        @foreach (var ap in _res.Aptidoes.Where(a => !a.Apto))
        { foreach (var p in ap.Pendencias) { <div class="alert-box @(p.Bloqueia ? "alert-erro" : "alert-aviso")">@Icons.Svg("shield")<div><strong>@ap.Tecnico.Nome</strong> — @p.Motivo <span class="sm">@(p.Bloqueia ? "Bloqueia a confirmação." : "Apenas alerta.")</span></div></div> } }
        @foreach (var w in _res.Avisos) { <div class="alert-box alert-aviso">@Icons.Svg("info")<div>@w</div></div> }
        }
    </div>
</aside>
</div>

@if (_abaV == "historico") { <HistoricoViagem ViagemId="@(_novo ? "" : Id)" Pendentes="_notasPend" Ator="@_ator" Pode="@_pode" Fuso="@_snap.FusoPadrao" OnContagem="@((int n) => _nNotas = n)" /> }
@if (_email) { <EmailOsDialogo ViagemId="@Id" Ator="@_ator" OnFechar="@(() => _email = false)" OnGerado="AoEmail" /> }
@if (_pedirCidade is not null) { <CidadePlanta PlantaId="@_pedirCidade" Ator="@_ator" OnSalvo="CidadeSalva" OnFechar="@(() => _pedirCidade = null)" /> }
@if (_cancelando)
{
    <Dialogo Titulo="Cancelar viagem" OnFechar="@(() => _cancelando = false)">
        <p>A viagem sai da agenda e do mapa e a disponibilidade dos técnicos é liberada. O registro e o histórico são mantidos.</p>
        <label class="fld">Motivo <input @bind="_motivo" /></label>
        <div class="modal-actions"><button class="btn-ghost" @onclick="@(() => _cancelando = false)">Voltar</button><button class="btn-danger" @onclick="Cancelar">@Icons.Svg("x")Cancelar viagem</button></div>
    </Dialogo>
}
}

@code {
    [Parameter] public string Id { get; set; } = "";

    /// <summary>Sentido (só translados extras): "casa" = da planta para casa no meio da viagem; "planta" = de casa de volta à planta.</summary>
    private sealed class Faixa { public string Ini = "", Fim = "", Modal = Vocab.ModalAviao, Sentido = ""; public Trecho? T; public Atendimento? A; }
    private List<Faixa> _extras = new();
    /// <summary>Partes do serviço além da primeira (o serviço é dividido nas pausas em casa).</summary>
    private List<Atendimento> _servPartes = new();

    private Task<string?> CriarServ(string nome) { var s = Svc.CriarServicoRapido(_ator, nome); _snap = Svc.Foto(); return Task.FromResult<string?>(s.Id); }
    private Task<string?> CriarCli(string nome) { var c = Svc.CriarClienteRapido(_ator, nome); _snap = Svc.Foto(); return Task.FromResult<string?>(c.Id); }
    private Ator _ator = new(); private Snapshot _snap = new(); private bool _ok, _novo, _pode, _verAnexos, _maisAberto, _cancelando, _localizando;
    private Viagem _v = new(); private HashSet<string> _tecs = new(); private Faixa _ida = new(), _serv = new(), _volta = new();
    private double? _horasPrev, _horasReal; private ResultadoViagem _res = new(); private List<string>? _erros; private Planta? _planta;
    private string? _motivo, _pedirCidade; private string _fusoOrigem = "", _fusoPlanta = "";
    private DotNetObjectReference<ViagemSimples>? _ref; private bool _mapaPronto, _redesenhar, _email;
    private string _abaV = "viagem"; private int _nNotas;
    // ---- itens preparados antes de salvar a viagem nova: documentos e histórico
    private List<DocumentosViagem.Pendente> _docsPend = new(); private List<NotaViagem> _notasPend = new();
    [SupplyParameterFromQuery(Name = "email")] public bool? EmailQuery { get; set; }
    private async Task GravarPendentes(string viagemId)
    {
        var falhas = new List<string>();
        foreach (var d in _docsPend)
            try { await Svc.AnexarAsync(_ator, "viagem", viagemId, d.Nome, new MemoryStream(d.Dados), d.Categoria); } catch (Exception ex) { falhas.Add($"{d.Nome}: {string.Join(" ", Ui.Erros(ex))}"); }
        foreach (var n in _notasPend.OrderBy(n => n.Quando))
            try { n.ViagemId = viagemId; n.Id = ""; Svc.SalvarNota(_ator, n); } catch (Exception ex) { falhas.Add(string.Join(" ", Ui.Erros(ex))); }
        _docsPend.Clear(); _notasPend.Clear();
        if (falhas.Count > 0) Sessao.Avisar("Viagem salva, mas: " + string.Join(" | ", falhas), true);
    }
    private bool _emailAberto;
    private Task AbrirEmail() { if (_novo) return Salvar(null, abrirEmail: true); _email = true; return Task.CompletedTask; }

    private int ContarNotas() { try { return Svc.NotasDaViagem(_ator, Id).Count; } catch { return 0; } }
    private List<Usuario> _equipe = new();

    private void AoChecklist(List<Checklist.Item> l) { _v.Checklist = Checklist.Gravar(l); }
    private void AoEmail() { var v = Svc.Foto().Viagem(Id); if (v is not null) { _v.Checklist = v.Checklist; _v.OsGeradoEm = v.OsGeradoEm; _v.OsGeradoPor = v.OsGeradoPor; } }
    private void AoResponsavel(ChangeEventArgs e)
    {
        var login = e.Value?.ToString() ?? "";
        if (_novo) { _v.ResponsavelLogin = login; _v.Responsavel = _equipe.FirstOrDefault(u => u.Id == login)?.Nome ?? ""; return; }
        try { var v = Svc.DefinirResponsavel(_ator, Id, login); _v.ResponsavelLogin = v.ResponsavelLogin; _v.Responsavel = v.Responsavel; Sessao.Avisar(string.IsNullOrEmpty(v.Responsavel) ? "Viagem sem responsável." : $"Responsável: {v.Responsavel}."); }
        catch (Exception ex) { _erros = Ui.Erros(ex); }
    }

    protected override async Task OnParametersSetAsync()
    {
        _ator = await Sessao.AtorAsync();
        Sessao.Mudou -= Ao; Sessao.Mudou += Ao; _ref ??= DotNetObjectReference.Create(this);
        Carregar();
    }
    private void Ao() => InvokeAsync(StateHasChanged);

    private void Carregar()
    {
        _snap = Svc.Foto(); _erros = null; _novo = Id == "novo"; _pode = _ator.Pode(Perm.EditarViagens);
        _verAnexos = (_ator.Pode(Perm.VerAnexosViagem) || _ator.Papel == Roles.Tecnico) && !Sessao.Apresentacao;
        _ida = new Faixa { Modal = Vocab.ModalAviao }; _serv = new Faixa(); _volta = new Faixa { Modal = Vocab.ModalAviao }; _horasPrev = _horasReal = null;
        _extras = new(); _servPartes = new();
        _equipe = Svc.EquipeControle();
        if (_novo) { _ok = _pode; _v = new Viagem { Checklist = Checklist.Gravar(Checklist.Novo()) }; _nNotas = 0; if (_equipe.Any(u => u.Id == _ator.Login)) { _v.ResponsavelLogin = _ator.Login; _v.Responsavel = _ator.Nome; } _tecs = new(); }
        else
        {
            var v = _snap.Viagem(Id);
            if (v is null || !(_ator.VeTodaEquipe || (_ator.Papel == Roles.Tecnico && Ui.Ids(v.TecnicoIds).Contains(_ator.TecnicoId)))) { _ok = false; return; }
            var trs = _snap.Trechos.Where(t => t.ViagemId == Id).OrderBy(t => t.Ordem).ToList(); var ats = _snap.Atendimentos.Where(a => a.ViagemId == Id).ToList();
            var todos = Ui.Ids(v.TecnicoIds).ToHashSet();
            bool paraTodos(string ids) => ids == "" || Ui.Ids(ids).ToHashSet().SetEquals(todos);      // vale para todos os técnicos da viagem
            // viagem com itinerário complexo (vários trechos/atendimentos, trechos por técnico, entre plantas): usa o modo avançado, sem perder nada
            // idas/voltas a mais (translados no meio da viagem) e o serviço dividido nessas pausas continuam no modo simples
            var simples = trs.All(t => t.Tipo != Vocab.TrechoEntre && paraTodos(t.TecnicoIds))
                          && ats.All(a => paraTodos(a.TecnicoIds) && (a.PlantaId == v.PlantaId || v.PlantaId == "")) && ats.Select(a => a.ServicoId).Distinct().Count() <= 1;
            if (!simples) { Nav.NavigateTo($"/viagens/{Id}/avancado", replace: true); return; }
            _ok = true; _v = v.Copia<Viagem>(); _tecs = Ui.Ids(v.TecnicoIds).ToHashSet(); _nNotas = ContarNotas();
            if (EmailQuery == true && !_emailAberto) { _email = true; _emailAberto = true; }
            AtualizarPlanta();
            // a primeira ida e a última volta são os deslocamentos principais; o que sobrar são translados no meio da viagem
            var porData = trs.OrderBy(t => t.PartidaPrev ?? t.ChegadaPrev ?? DateTime.MaxValue).ThenBy(t => t.Ordem).ToList();
            var ti = porData.FirstOrDefault(t => t.Tipo == Vocab.TrechoIda); var tr = porData.LastOrDefault(t => t.Tipo == Vocab.TrechoRetorno);
            if (ti is not null) _ida = new Faixa { T = ti.Copia<Trecho>(), Modal = ti.Modal, Ini = Ui.ParaInput(ti.PartidaPrev, _fusoOrigem), Fim = Ui.ParaInput(ti.ChegadaPrev, _fusoPlanta) };
            if (tr is not null) _volta = new Faixa { T = tr.Copia<Trecho>(), Modal = tr.Modal, Ini = Ui.ParaInput(tr.PartidaPrev, _fusoPlanta), Fim = Ui.ParaInput(tr.ChegadaPrev, _fusoOrigem) };
            foreach (var x in porData.Where(t => t != ti && t != tr))
            {
                var paraCasa = x.Tipo == Vocab.TrechoRetorno;
                _extras.Add(new Faixa { T = x.Copia<Trecho>(), Modal = x.Modal, Sentido = paraCasa ? "casa" : "planta",
                    Ini = Ui.ParaInput(x.PartidaPrev, paraCasa ? _fusoPlanta : _fusoOrigem), Fim = Ui.ParaInput(x.ChegadaPrev, paraCasa ? _fusoOrigem : _fusoPlanta) });
            }
            var atsOrd = ats.OrderBy(a => a.IniPrev).ToList();
            if (atsOrd.Count > 0)
            {
                var at = atsOrd[0];
                _serv = new Faixa { A = at.Copia<Atendimento>(), Ini = Ui.ParaInput(at.IniPrev, _fusoPlanta), Fim = Ui.ParaInput(atsOrd.Max(a => a.FimPrev), _fusoPlanta) };
                _servPartes = atsOrd.Skip(1).Select(a => a.Copia<Atendimento>()).ToList();
                _horasPrev = atsOrd.Any(a => a.HorasPrev.HasValue) ? atsOrd.Sum(a => a.HorasPrev ?? 0) : null;
                _horasReal = atsOrd.Any(a => a.HorasReal.HasValue) ? atsOrd.Sum(a => a.HorasReal ?? 0) : null;
            }
        }
        AtualizarPlanta(); Validar(); _redesenhar = true;
    }

    private void AtualizarPlanta()
    {
        _planta = _snap.Planta(_v.PlantaId);
        _fusoPlanta = _planta?.FusoHorario ?? _snap.FusoPadrao;
        _fusoOrigem = _tecs.Select(t => _snap.Tecnico(t)?.FusoHorario).FirstOrDefault(f => !string.IsNullOrEmpty(f)) ?? _snap.FusoPadrao;
    }

    private string OrigemTexto()
    {
        var t = _tecs.Select(x => _snap.Tecnico(x)).FirstOrDefault(x => x is not null);
        return t is null ? "Origem" : !string.IsNullOrWhiteSpace(t.OrigemHabitual) ? t.OrigemHabitual : string.IsNullOrWhiteSpace(t.Cidade) ? t.Nome : t.Cidade;
    }

    private (double?, double?) OrigemCoord()
    {
        var t = _tecs.Select(x => _snap.Tecnico(x)).FirstOrDefault(x => x?.OrigemLat is not null);
        return (t?.OrigemLat, t?.OrigemLon);
    }

    private (Viagem v, List<Trecho> tr, List<Atendimento> at) Montar()
    {
        var v = _v.Copia<Viagem>(); v.TecnicoIds = Servicos.Csv(_tecs);
        if (_planta is not null) { v.ClienteId = _planta.ClienteId; v.Destino = _snap.NomePlanta(_planta.Id); }
        v.Origem = OrigemTexto(); v.HorasPrevistas = _horasPrev; v.HorasRealizadas = _horasReal;
        var tr = new List<Trecho>(); var at = new List<Atendimento>();
        var (olat, olon) = OrigemCoord(); var nomeP = _planta is null ? "Destino" : _snap.NomePlanta(_planta.Id);

        var ini = Ui.DoInput(_ida.Ini, _fusoOrigem); var fim = Ui.DoInput(_ida.Fim, _fusoPlanta);
        if (ini.HasValue || fim.HasValue)
        {
            var t = (_ida.T ?? new Trecho()).Copia<Trecho>();
            t.Tipo = Vocab.TrechoIda; t.Modal = _ida.Modal; t.Origem = OrigemTexto(); t.Destino = nomeP; t.DestPlantaId = _v.PlantaId; t.OrigemPlantaId = "";
            t.FusoOrigem = _fusoOrigem; t.FusoDestino = _fusoPlanta; t.PartidaPrev = ini; t.ChegadaPrev = fim; t.OrigemLat = olat; t.OrigemLon = olon;
            t.DestLat = _planta?.Lat; t.DestLon = _planta?.Lon; t.TecnicoIds = "";
            if (ini.HasValue && fim.HasValue) { t.DuracaoMin = (int)(fim.Value - ini.Value).TotalMinutes; t.DuracaoFonte = "horarios"; }
            tr.Add(t);
        }
        // translados no meio da viagem (ex.: volta para casa e retorno à planta)
        var pausas = new List<(DateTime de, DateTime? ate)>(); var extrasTr = new List<Trecho>();
        foreach (var x in _extras)
        {
            var paraCasa = x.Sentido == "casa";
            var fIni = paraCasa ? _fusoPlanta : _fusoOrigem; var fFim = paraCasa ? _fusoOrigem : _fusoPlanta;
            var xi = Ui.DoInput(x.Ini, fIni); var xf = Ui.DoInput(x.Fim, fFim);
            if (!xi.HasValue && !xf.HasValue) continue;                 // translado opcional ainda em branco: ignora
            var t = (x.T ?? new Trecho()).Copia<Trecho>();
            t.Modal = x.Modal; t.TecnicoIds = ""; t.FusoOrigem = fIni; t.FusoDestino = fFim; t.PartidaPrev = xi; t.ChegadaPrev = xf;
            if (paraCasa)
            {
                t.Tipo = Vocab.TrechoRetorno; t.Origem = nomeP; t.OrigemPlantaId = _v.PlantaId; t.Destino = OrigemTexto(); t.DestPlantaId = "";
                t.OrigemLat = _planta?.Lat; t.OrigemLon = _planta?.Lon; t.DestLat = olat; t.DestLon = olon;
            }
            else
            {
                t.Tipo = Vocab.TrechoIda; t.Origem = OrigemTexto(); t.OrigemPlantaId = ""; t.Destino = nomeP; t.DestPlantaId = _v.PlantaId;
                t.OrigemLat = olat; t.OrigemLon = olon; t.DestLat = _planta?.Lat; t.DestLon = _planta?.Lon;
            }
            if (xi.HasValue && xf.HasValue) { t.DuracaoMin = (int)(xf.Value - xi.Value).TotalMinutes; t.DuracaoFonte = "horarios"; }
            tr.Add(t); extrasTr.Add(t);
        }
        // pausa no serviço: da saída para casa até a chegada de volta à planta (o técnico não está no serviço nesse intervalo)
        var exOrd = extrasTr.OrderBy(t => t.PartidaPrev ?? t.ChegadaPrev).ToList();
        foreach (var casa in exOrd.Where(t => t.Tipo == Vocab.TrechoRetorno))
        {
            var de = (casa.PartidaPrev ?? casa.ChegadaPrev)!.Value;
            var retorno = exOrd.FirstOrDefault(t => t.Tipo == Vocab.TrechoIda && (t.PartidaPrev ?? t.ChegadaPrev) > de);
            pausas.Add((de, retorno?.ChegadaPrev ?? retorno?.PartidaPrev));
        }
        var si = Ui.DoInput(_serv.Ini, _fusoPlanta); var sf = Ui.DoInput(_serv.Fim, _fusoPlanta);
        if (si.HasValue || sf.HasValue)
        {
            // divide o serviço nas pausas em casa (cada parte vira um atendimento; as horas ficam na primeira)
            var partes = new List<(DateTime? ini, DateTime? fim)> { (si, sf) };
            if (si.HasValue && sf.HasValue)
                foreach (var (de, ate) in pausas.OrderBy(p => p.de))
                {
                    var ult = partes[^1];
                    if (de <= ult.ini!.Value || de >= ult.fim!.Value) continue;
                    partes[^1] = (ult.ini, de);
                    if (ate is { } a2 && a2 < ult.fim!.Value) partes.Add((a2, ult.fim)); else break;
                }
            for (var i = 0; i < partes.Count; i++)
            {
                var a = (i == 0 ? _serv.A : i - 1 < _servPartes.Count ? _servPartes[i - 1] : null)?.Copia<Atendimento>() ?? new Atendimento();
                a.PlantaId = _v.PlantaId; a.ServicoId = _v.ServicoId; a.ClienteId = _v.ClienteId; a.IniPrev = partes[i].ini ?? default; a.FimPrev = partes[i].fim ?? default; a.TecnicoIds = "";
                a.HorasPrev = i == 0 ? _horasPrev : null; a.HorasReal = i == 0 ? _horasReal : null; a.ViagemId = _v.Id;
                at.Add(a);
            }
        }
        var vi = Ui.DoInput(_volta.Ini, _fusoPlanta); var vf = Ui.DoInput(_volta.Fim, _fusoOrigem);
        if (vi.HasValue || vf.HasValue)
        {
            var t = (_volta.T ?? new Trecho()).Copia<Trecho>();
            t.Tipo = Vocab.TrechoRetorno; t.Modal = _volta.Modal; t.Origem = nomeP; t.OrigemPlantaId = _v.PlantaId; t.Destino = OrigemTexto(); t.DestPlantaId = "";
            t.FusoOrigem = _fusoPlanta; t.FusoDestino = _fusoOrigem; t.PartidaPrev = vi; t.ChegadaPrev = vf; t.OrigemLat = _planta?.Lat; t.OrigemLon = _planta?.Lon;
            t.DestLat = olat; t.DestLon = olon; t.TecnicoIds = "";
            if (vi.HasValue && vf.HasValue) { t.DuracaoMin = (int)(vf.Value - vi.Value).TotalMinutes; t.DuracaoFonte = "horarios"; }
            tr.Add(t);
        }
        return (v, tr, at);
    }

    private void Validar()
    {
        try { var (v, tr, at) = Montar(); _res = Svc.Validar(v, tr, at); }
        catch (Exception ex) { _res = new ResultadoViagem(); _res.Erros.Add(ex.Message); }
    }

    // ---- diárias ----
    private int? Dias(string ini, string fim)
    {
        if (!DateTime.TryParse(ini, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var a) ||
            !DateTime.TryParse(fim, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var b) || b < a) return null;
        return (int)(b.Date - a.Date).TotalDays + 1;
    }
    private int? TotalDias()
    {
        var todos = new[] { _ida, _serv, _volta }.Concat(_extras).SelectMany(f => new[] { f.Ini, f.Fim }).Where(x => DateTime.TryParse(x, out _)).Select(x => DateTime.Parse(x, System.Globalization.CultureInfo.InvariantCulture).Date).ToList();
        return todos.Count < 2 ? null : (int)(todos.Max() - todos.Min()).TotalDays + 1;
    }
    private bool Tocou => !_novo || !string.IsNullOrEmpty(_v.PlantaId) || _tecs.Count > 0 || new[] { _ida, _serv, _volta }.Concat(_extras).Any(f => f.Ini != "" || f.Fim != "");
    private static string Diar(int? d) => d is null ? "—" : d == 1 ? "1 diária" : $"{d} diárias";

    private RenderFragment Bloco(string chave, string titulo, string icone, string cor, Faixa f, string fusoIni, string fusoFim, int? dias, bool transporte) => __builder =>
    {
        <div class="diaria" style="--c:@cor">
            <div class="diaria-cab"><span class="ev-selo sm" style="background:@cor">@Icons.Svg(icone)</span><strong>@titulo</strong><span class="grow"></span><span class="badge diar-n">@Diar(dias)</span></div>
            <div class="form-grid">
                <label class="fld">@(transporte ? "Saída" : "Início") <span class="hint">@Tempo.Offset(fusoIni, DateTime.UtcNow)</span><input type="datetime-local" value="@f.Ini" @onchange="e => { f.Ini = e.Value?.ToString() ?? string.Empty; Validar(); }" /></label>
                <label class="fld">@(transporte ? "Chegada" : "Fim") <span class="hint">@Tempo.Offset(fusoFim, DateTime.UtcNow)</span><input type="datetime-local" value="@f.Fim" @onchange="e => { f.Fim = e.Value?.ToString() ?? string.Empty; Validar(); }" /></label>
                @if (transporte) { <label class="fld">Transporte<select value="@f.Modal" @onchange="e => f.Modal = e.Value?.ToString() ?? Vocab.ModalCarro"><option value="aviao">Avião</option><option value="carro">Carro</option><option value="outro">Outro</option></select></label> }
            </div>
        </div>
    };

    // ---- translados no meio da viagem (opcionais) ----
    private void AdicionarTranslado()
    {
        _extras.Add(new Faixa { Sentido = "casa", Modal = Vocab.ModalAviao });
        _extras.Add(new Faixa { Sentido = "planta", Modal = Vocab.ModalAviao });
    }
    private void RemoverTranslado(Faixa x) { _extras.Remove(x); Validar(); }
    private static string TituloExtra(Faixa x) => x.Sentido == "casa" ? "Translado: volta para casa" : "Translado: retorno à planta";

    private RenderFragment BlocoExtra(Faixa x) => __builder =>
    {
        var paraCasa = x.Sentido == "casa"; var cor = paraCasa ? "#8a6d3b" : "#b7791f";
        <div class="diaria translado" style="--c:@cor">
            <div class="diaria-cab"><span class="ev-selo sm" style="background:@cor">@Icons.Svg(paraCasa ? "user" : "plane")</span><strong>@TituloExtra(x)</strong><span class="tag">opcional</span>
                <span class="grow"></span><span class="badge diar-n">@Diar(Dias(x.Ini, x.Fim))</span>
                @if (_pode) { <button type="button" class="icon-btn perigo xs" title="Remover este translado" aria-label="Remover translado" @onclick="() => RemoverTranslado(x)">@Icons.Svg("trash")</button> }</div>
            <div class="form-grid">
                <label class="fld">Sentido<select value="@x.Sentido" @onchange="@(e => { x.Sentido = e.Value?.ToString() ?? "casa"; Validar(); })"><option value="casa">Da planta para casa</option><option value="planta">De casa para a planta</option></select></label>
                <label class="fld">Saída <span class="hint">@Tempo.Offset(paraCasa ? _fusoPlanta : _fusoOrigem, DateTime.UtcNow)</span><input type="datetime-local" value="@x.Ini" @onchange="e => { x.Ini = e.Value?.ToString() ?? string.Empty; Validar(); }" /></label>
                <label class="fld">Chegada <span class="hint">@Tempo.Offset(paraCasa ? _fusoOrigem : _fusoPlanta, DateTime.UtcNow)</span><input type="datetime-local" value="@x.Fim" @onchange="e => { x.Fim = e.Value?.ToString() ?? string.Empty; Validar(); }" /></label>
                <label class="fld">Transporte<select value="@x.Modal" @onchange="e => x.Modal = e.Value?.ToString() ?? Vocab.ModalCarro"><option value="aviao">Avião</option><option value="carro">Carro</option><option value="outro">Outro</option></select></label>
            </div>
        </div>
    };

    // ---- planta / mapa ----
    private async Task AoPlantaValor(string id) { _v.PlantaId = id ?? ""; await AoPlanta(); }

    private async Task AoPlanta()
    {
        AtualizarPlanta(); Validar(); _redesenhar = true;
        if (_planta is null) return;
        if (string.IsNullOrWhiteSpace(_planta.Cidade) && _ator.Pode(Perm.EditarClientes)) _pedirCidade = _planta.Id;
        // tem endereço mas ainda não foi localizada: busca na hora (endereço → cidade → estado → país) e grava no cadastro
        else if (!_planta.TemCoord && _planta.GeoStatus != "manual" && Geo.Configurado && _ator.Pode(Perm.EditarClientes)) await LocalizarAgora();
    }
    private void AlternarTec(string id, bool on) { if (on) _tecs.Add(id); else _tecs.Remove(id); AtualizarPlanta(); Validar(); _redesenhar = true; }
    private void CidadeSalva() { _pedirCidade = null; _snap = Svc.Foto(); AtualizarPlanta(); Validar(); _redesenhar = true; Sessao.Avisar("Cidade gravada no cadastro da planta."); }

    private async Task LocalizarAgora()
    {
        if (_planta is null) return;
        _localizando = true; StateHasChanged();
        try { await Svc.SalvarPlantaAsync(_ator, Db.Plantas.Obter(_planta.Id)!, Geo, forcarGeocodificar: true); _snap = Svc.Foto(); AtualizarPlanta(); _redesenhar = true; Validar(); }
        catch (Exception ex) { _erros = Ui.Erros(ex); }
        _localizando = false; StateHasChanged();
    }

    [JSInvokable] public Task AoClicarGrupo(string chave) => Task.CompletedTask;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_ok) return;
        try
        {
            if (!_mapaPronto)
            {
                _mapaPronto = await JS.InvokeAsync<bool>("app.mapa.iniciar", "mapa-viagem", _ref, new { centro = new[] { -15.0, -52.0 }, zoom = 4, tileUrl = Cfg["Mapa:TileUrl"], atribuicao = Cfg["Mapa:Atribuicao"] });
                _redesenhar = true;
            }
            if (_mapaPronto && _redesenhar)
            {
                _redesenhar = false;
                var grupos = new List<object>(); var rotas = new List<object>();
                if (_planta is { TemCoord: true } p)
                {
                    var nomes = _tecs.Select(t => _snap.Tecnico(t)?.Nome).Where(n => n != null).Select(n => new { nome = n!, cor = "#0369a1" }).ToList();
                    grupos.Add(new { chave = p.Id, lat = p.Lat!.Value, lon = p.Lon!.Value, titulo = _snap.NomePlanta(p.Id), cor = "#0369a1", tracejado = p.GeoNivel is "cidade" or "estado" or "pais",
                        viagem = false, iniciais = "📍", rotulo = p.GeoNivel is "cidade" or "estado" or "pais" ? $"Posição aproximada ({p.GeoNivel})" : "Local do serviço", tecnicos = nomes.Count == 0 ? new[] { new { nome = "Técnico(s) a definir", cor = "#8793a6" } }.ToList() : nomes });
                    var (la, lo) = OrigemCoord();
                    if (la.HasValue) rotas.Add(new { de = new[] { la.Value, lo!.Value }, para = new[] { p.Lat!.Value, p.Lon!.Value }, cor = "#d9822b", titulo = $"{OrigemTexto()} → {_snap.NomePlanta(p.Id)} (deslocamento)" });
                }
                await JS.InvokeVoidAsync("app.mapa.desenhar", "mapa-viagem", new { grupos, rotas, ajustar = true });
            }
        }
        catch (JSDisconnectedException) { }
        catch { }
    }

    // ---- salvar ----
    private async Task Salvar(string? status, bool abrirEmail = false)
    {
        _erros = null;
        try
        {
            Ui.ExigirProjeto(_v.Projeto); _v.Projeto = _v.Projeto.Trim();
            if (status is not null) _v.Status = status;
            var (v, tr, at) = Montar();
            var salvo = Svc.SalvarViagem(_ator, v, tr, at);
            Sessao.Avisar(status == Vocab.ViagemConfirmada ? "Viagem confirmada." : "Viagem salva.");
            if (_novo) { await GravarPendentes(salvo.Id); Nav.NavigateTo($"/viagens/{salvo.Id}" + (abrirEmail ? "?email=true" : "")); }
            else { Id = salvo.Id; Carregar(); }
        }
        catch (Exception ex) { _erros = Ui.Erros(ex); if (status is not null && !_novo) _v.Status = _snap.Viagem(Id)?.Status ?? _v.Status; }
    }

    private void Cancelar()
    {
        try { Svc.AlterarStatusViagem(_ator, Id, Vocab.ViagemCancelada, _motivo); _cancelando = false; Carregar(); Sessao.Avisar("Viagem cancelada; agenda e mapa atualizados."); }
        catch (Exception ex) { _cancelando = false; _erros = Ui.Erros(ex); }
    }

    public void Dispose() { Sessao.Mudou -= Ao; try { _ = JS.InvokeVoidAsync("app.mapa.destruir", "mapa-viagem"); } catch { } _ref?.Dispose(); }
}
