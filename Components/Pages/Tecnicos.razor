@page "/tecnicos"
@attribute [Authorize]
@implements IDisposable
@inject Servicos Svc
@inject Db Db
@inject Sessao Sessao
@inject ImportadorTecnicos Imp
@inject IJSRuntime JS

<PageTitle>Técnicos · Controle Técnico</PageTitle>

<div class="page-head compacto">
    <div>
        <h1>Técnicos</h1>
        <p class="subtitle">Equipe, vencimentos de documentos e treinamentos, e quem está livre e apto para cada planta ou serviço.</p>
    </div>
    <div class="momento-ctl">
        @if (_ator.Pode(Perm.EditarTecnicos)) { <a class="btn-primary" href="/tecnicos/novo">@Icons.Svg("plus")Novo técnico</a> }
    </div>
</div>

<div class="tabs" role="tablist">
    <button role="tab" class="tab @(_aba == "equipe" ? "active" : "")" @onclick='() => _aba = "equipe"'>Equipe <span class="tab-badge">@_tecs.Count</span></button>
    @if (_ator.Pode(Perm.EditarTecnicos))
    {
        <button role="tab" class="tab @(_aba == "imp" ? "active" : "")" @onclick='() => _aba = "imp"'>Importar planilha</button>
    }
    @if (_ator.Pode(Perm.VerDocsStatus))
    {
        <button role="tab" class="tab @(_aba == "venc" ? "active" : "")" @onclick='() => _aba = "venc"'>Vencimentos <span class="tab-badge">@_venc.Count(v => v.Status is Vocab.DocProximo or Vocab.DocVencido)</span></button>
    }
    @if (_ator.VeTodaEquipe)
    {
        <button role="tab" class="tab @(_aba == "apt" ? "active" : "")" @onclick='() => _aba = "apt"'>Requisitos e aptidão</button>
    }
</div>

@if (_aba == "equipe")
{
    <div class="toolbar">
        <input class="field busca" placeholder="Buscar técnico, cidade…" @bind="_busca" @bind:event="oninput" aria-label="Buscar técnico" />
        <select class="field w-auto" @bind="_fEsp"><option value="">Todas as especialidades</option>@foreach (var e in _snap.Especialidades.Values.OrderBy(e => e.Nome)) {<option value="@e.Id">@e.Nome</option>}</select>
        <label class="chk-inline"><input type="checkbox" @bind="_soAtivos" />Somente ativos</label>
    </div>
    <div class="table-wrap"><table class="grid-tbl">
        <thead><tr><th>Técnico</th><th>Status agora</th><th>Onde mora</th><th>Especialidades</th><th>Próximo período disponível</th><th>Documentos</th></tr></thead>
        <tbody>
        @foreach (var t in Filtrados)
        {
            var e = _estados.GetValueOrDefault(t.Id); var it = Ui.Op(e?.Status ?? Vocab.OpSemProg);
            var venc = _venc.Where(v => v.Doc.TecnicoId == t.Id).ToList();
            var nv = venc.Count(v => v.Status == Vocab.DocVencido); var np = venc.Count(v => v.Status == Vocab.DocProximo);
            var livre = e is null ? null : AgendaEngine.ProximoLivre(_snap, _eventos, t, DateTime.UtcNow);
            <tr>
                <td><a class="lnk-tec" href="/tecnicos/@t.Id"><Avatar Nome="@t.Nome" FotoId="@t.FotoAnexoId" Cor="@it.Color" Tam="sm" /><strong>@t.Nome</strong></a>@if (!t.Ativo) { <span class="tag neg">inativo</span> }</td>
                <td><StatusBadge Item="@it" /></td>
                <td>@t.Cidade@(string.IsNullOrEmpty(t.Estado) ? "" : "/" + t.Estado)</td>
                <td>@string.Join(", ", Ui.Ids(t.EspecialidadeIds).Select(i => _snap.Especialidades.GetValueOrDefault(i)?.Nome).Where(n => n != null))</td>
                <td>@(livre is { } l ? (l.fim is null ? $"a partir de {l.ini:dd/MM}" : $"{l.ini:dd/MM} a {l.fim:dd/MM}") : "—")</td>
                <td>@if (nv > 0) { <span class="badge st-neg">@Icons.Svg("alert", "bico")@nv vencido(s)</span> } @if (np > 0) { <span class="badge st-warn">@Icons.Svg("clock", "bico")@np a vencer</span> } @if (nv + np == 0) { <span class="badge st-pos">@Icons.Svg("check", "bico")Em dia</span> }</td>
            </tr>
        }
        </tbody>
    </table></div>
    @if (!Filtrados.Any()) { <div class="empty-state sm"><div class="ico">@Icons.Svg("users")</div><h3>Nenhum técnico encontrado</h3></div> }
}
else if (_aba == "imp" && _ator.Pode(Perm.EditarTecnicos))
{
    <div class="steps">
        @foreach (var (n, r) in new[] { (1, "Arquivo"), (2, "Colunas"), (3, "Prévia e validação"), (4, "Resultado") })
        { <span class="step @(_passo == n ? "on" : _passo > n ? "ok" : "")"><b>@n</b>@r</span> }
    </div>
    @if (_passo == 1)
    {
        <div class="panel">
            <div class="panel-head"><div class="panel-title">1. Escolha o arquivo</div></div>
            <p>Aceita <strong>.xlsx</strong> e <strong>.csv</strong> (até 25 MB e 20.000 linhas). Importe <strong>somente os nomes</strong> (uma coluna). Cidade, contatos, especialidades, jornada e demais dados são preenchidos depois, na ficha de cada técnico.</p>
            <div class="imp-acoes">
                <a class="btn-ghost" href="/modelo/tecnicos.xlsx" download>@Icons.Svg("download")Baixar planilha modelo</a>
                <label class="btn-primary file-btn">@Icons.Svg("upload")Selecionar arquivo<InputFile OnChange="AoArquivo" accept=".xlsx,.csv" class="sr-only" /></label>
            </div>
            @if (_lendo) { <p class="muted">Lendo o arquivo…</p> }
            @if (_errosImp is { Count: > 0 }) { <div class="alert-box alert-erro">@Icons.Svg("alert")<div>@foreach (var e in _errosImp) { <div>@e</div> }</div></div> }
        </div>
    }
    else if (_passo == 2 && _arq is not null)
    {
        <div class="panel">
            <div class="panel-head"><div class="panel-title">2. Mapeie as colunas</div><span class="tag">@_arq.Nome · @_arq.Linhas.Count linha(s)</span></div>
            <div class="map-cols">
                @foreach (var c in ImportadorTecnicos.Campos)
                {
                    <label class="fld">@c.Label @if (c.Obrigatorio) { <span class="neg">*</span> }
                        <select value="@(_map.TryGetValue(c.Key, out var ix) ? ix : -1)" @onchange="e => Mapear(c.Key, e.Value?.ToString())">
                            <option value="-1">— não importar —</option>
                            @for (var i = 0; i < _arq.Cabecalhos.Count; i++) { <option value="@i">@(string.IsNullOrWhiteSpace(_arq.Cabecalhos[i]) ? $"(coluna {i + 1})" : _arq.Cabecalhos[i])</option> }
                        </select></label>
                }
            </div>
            @if (_errosImp is { Count: > 0 }) { <div class="alert-box alert-erro">@Icons.Svg("alert")<div>@foreach (var e in _errosImp) { <div>@e</div> }</div></div> }
            <div class="modal-actions"><button class="btn-ghost" @onclick="ReiniciarImport">Voltar</button><button class="btn-primary" @onclick="AnalisarImp">Validar e ver prévia @Icons.Svg("arrow-right")</button></div>
        </div>
    }
    else if (_passo == 3)
    {
        var rej = _linhas.Count(l => l.Rejeitada); var exist = _linhas.Count(l => l.Existente && !l.Rejeitada); var novas = _linhas.Count(l => !l.Existente && !l.Rejeitada);
        <div class="panel">
            <div class="panel-head"><div class="panel-title">3. Prévia e validação</div><span class="tag">@_linhas.Count linha(s)</span></div>
            <div class="imp-resumo"><div class="imp-n pos"><b>@novas</b>novos</div><div class="imp-n warn"><b>@exist</b>já cadastrados</div><div class="imp-n neg"><b>@rej</b>com erro (rejeitados)</div></div>
            @if (exist > 0)
            {
                <div class="toolbar"><strong>Técnicos já cadastrados:</strong>
                    <select class="field w-auto" @onchange="e => AplicarPadrao(e.Value?.ToString())"><option value="Ignorar">Ignorar (já cadastrado)</option><option value="Criar">Criar homônimo</option></select>
                    <span class="muted sm">Ajuste linha a linha abaixo. Nada é alterado sem aparecer aqui.</span></div>
            }
            <div class="toolbar"><label class="chk-inline"><input type="checkbox" @bind="_soProblemas" />Mostrar só linhas com erro, aviso ou já cadastradas</label></div>
            <div class="table-wrap prev-wrap"><table class="grid-tbl">
                <thead><tr><th>Linha</th><th>Nome</th><th>Situação</th><th>Ação</th></tr></thead>
                <tbody>
                @foreach (var l in _linhas.Where(l => !_soProblemas || l.Rejeitada || l.Existente || l.Avisos.Count > 0))
                {
                    <tr class="@(l.Rejeitada ? "lin-erro" : "")">
                        <td>@l.Numero</td><td>@l.V["nome"]</td>
                        <td>@if (l.Rejeitada) { <span class="badge st-neg">@Icons.Svg("x", "bico")Erro</span> @foreach (var e in l.Erros) { <div class="sm neg">@e</div> } }
                            else if (l.Existente) { <span class="badge st-warn">@Icons.Svg("copy", "bico")Já cadastrado</span> @if (l.Diferencas.Count > 0) { <ul class="difs">@foreach (var d in l.Diferencas) { <li>@d</li> }</ul> } }
                            else { <span class="badge st-pos">@Icons.Svg("plus", "bico")Novo</span> }
                            @foreach (var a in l.Avisos) { <div class="sm warn">@a</div> }</td>
                        <td>@if (l.Rejeitada) { <span class="muted">Rejeitado</span> } else if (l.Existente) { <select class="field w-auto" @bind="l.Acao"><option value="@AcaoImport.Ignorar">Ignorar</option><option value="@AcaoImport.Criar">Criar homônimo</option></select> } else { <span class="muted">Criar</span> }</td>
                    </tr>
                }
                </tbody></table></div>
            @if (_errosImp is { Count: > 0 }) { <div class="alert-box alert-erro mt8">@Icons.Svg("alert")<div>@foreach (var e in _errosImp) { <div>@e</div> }</div></div> }
            <div class="modal-actions"><button class="btn-ghost" @onclick="@(() => _passo = 2)">Voltar</button><button class="btn-primary" @onclick="ConfirmarImp" disabled="@(_linhas.All(l => l.Rejeitada || l.Acao == AcaoImport.Ignorar))">@Icons.Svg("check")Confirmar importação</button></div>
        </div>
    }
    else if (_passo == 4 && _res is not null)
    {
        <div class="panel">
            <div class="panel-head"><div class="panel-title">4. Resultado da importação</div></div>
            <div class="imp-resumo"><div class="imp-n pos"><b>@_res.Importadas</b>importados</div><div class="imp-n"><b>@_res.Ignoradas</b>ignorados</div><div class="imp-n neg"><b>@_res.Rejeitadas.Count</b>rejeitados</div></div>
            @if (_res.Rejeitadas.Count > 0)
            {
                <h3 class="sec">@Icons.Svg("alert")Linhas rejeitadas e motivos</h3>
                <div class="table-wrap"><table class="grid-tbl"><thead><tr><th>Linha</th><th>Nome</th><th>Motivo</th></tr></thead><tbody>
                    @foreach (var e in _res.Rejeitadas) { <tr><td>@e.linha</td><td>@e.cliente</td><td class="neg">@e.motivo</td></tr> }</tbody></table></div>
                <button class="btn-ghost mt8" @onclick="BaixarErros">@Icons.Svg("download")Baixar lista de erros (CSV)</button>
            }
            @if (_res.Avisos.Count > 0) { <h3 class="sec">@Icons.Svg("info")Avisos</h3><ul class="difs">@foreach (var a in _res.Avisos) { <li>@(a.linha > 0 ? $"Linha {a.linha}: " : "")@a.detalhe</li> }</ul> }
            <p class="muted mt16">Próximos passos: abra a ficha de cada técnico e preencha cidade, contatos, especialidades, serviços e jornada (a cidade é obrigatória ao salvar a ficha); depois cadastre documentos e treinamentos.</p>
            <div class="modal-actions"><button class="btn-ghost" @onclick="ReiniciarImport">Nova importação</button><button class="btn-primary" @onclick="@(() => { _aba = "equipe"; ReiniciarImport(); })">Ver equipe</button></div>
        </div>
    }
}
else if (_aba == "venc")
{
    <div class="imp-resumo">
        <div class="imp-n neg"><b>@_venc.Count(v => v.Status == Vocab.DocVencido)</b>vencidos</div>
        @foreach (var a in Db.DiasAlerta)
        {
            var n = _venc.Count(v => v.Dias is >= 0 && v.Dias <= a && (a == Db.DiasAlerta.Min() || v.Dias > Db.DiasAlerta.Where(x => x < a).DefaultIfEmpty(-1).Max()));
            <div class="imp-n warn"><b>@n</b>vencem em até @a dias</div>
        }
        <div class="imp-n pos"><b>@_venc.Count(v => v.Status is Vocab.DocValido or Vocab.DocSemVenc)</b>válidos</div>
    </div>
    <div class="toolbar">
        <select class="field w-auto" @bind="_vTec"><option value="">Todos os técnicos</option>@foreach (var t in _tecs.OrderBy(t => t.Nome)) {<option value="@t.Id">@t.Nome</option>}</select>
        <select class="field w-auto" @bind="_vCat"><option value="">Todas as categorias</option>@foreach (var c in Vocab.CategoriasDoc) {<option>@c</option>}</select>
        <select class="field w-auto" @bind="_vNorma"><option value="">Todas as normas</option>@foreach (var n in _venc.Select(v => v.Doc.Norma).Where(n => n != "").Distinct().OrderBy(n => n)) {<option>@n</option>}</select>
        <select class="field w-auto" @bind="_vSt"><option value="">Todas as situações</option>@foreach (var s in Vocab.StatusDoc.Where(s => s.Key != Vocab.DocAusente)) {<option value="@s.Key">@s.Label</option>}</select>
        <label class="fld-i">Vence de <input type="date" class="field" value="@Ui.DataInput(_vDe)" @onchange="e => _vDe = Ui.DoDataInput(e.Value?.ToString())" /></label>
        <label class="fld-i">até <input type="date" class="field" value="@Ui.DataInput(_vAte)" @onchange="e => _vAte = Ui.DoDataInput(e.Value?.ToString())" /></label>
        <span class="grow"></span>
        <a class="btn-ghost" href="/export/vencimentos.csv" download>@Icons.Svg("download")Exportar CSV</a>
    </div>
    <div class="table-wrap"><table class="grid-tbl">
        <thead><tr><th>Técnico</th><th>Registro</th><th>Categoria</th><th>Norma</th><th>Vencimento</th><th>Dias</th><th>Situação</th></tr></thead>
        <tbody>
        @foreach (var v in VencFiltrados)
        {
            <tr><td><a href="/tecnicos/@v.Doc.TecnicoId">@v.Tecnico?.Nome</a></td><td>@v.Doc.Nome</td><td>@v.Doc.Categoria</td><td>@v.Doc.Norma</td>
                <td>@(v.Doc.SemVencimento ? "—" : Tempo.Dia(v.Doc.Vencimento))</td><td>@(v.Dias?.ToString() ?? "—")</td>
                <td><StatusBadge Item="@Ui.StDoc(v.Status)" Extra="@(v.Alerta is { } a ? $"≤{a}d" : null)" /></td></tr>
        }
        </tbody>
    </table></div>
    @if (!VencFiltrados.Any()) { <div class="empty-state sm"><div class="ico">@Icons.Svg("shield")</div><h3>Nenhum registro para os filtros</h3></div> }
}
else if (_aba == "apt")
{
    <div class="g12 top">
        <div class="c5">
            <div class="panel">
                <div class="panel-head"><div class="panel-title">Requisitos por serviço ou planta</div></div>
                <p class="muted sm">Defina quais documentos e treinamentos são exigidos e se a falta <strong>bloqueia a confirmação</strong> ou apenas gera alerta. A validade vem do registro de cada técnico.</p>
                @if (_ator.Pode(Perm.EditarRequisitos)) { <button class="btn-primary" @onclick="NovoReq">@Icons.Svg("plus")Novo requisito</button> }
                <div class="table-wrap mt8"><table class="grid-tbl">
                    <thead><tr><th>Onde</th><th>Exigido</th><th>Efeito</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var r in _snap.Requisitos.OrderBy(r => r.Escopo).ThenBy(r => EscopoNome(r)))
                    {
                        <tr><td><span class="tag">@(r.Escopo == "servico" ? "Serviço" : "Planta")</span> @EscopoNome(r)</td><td>@r.Nome@if (!string.IsNullOrEmpty(r.Norma)) { <div class="muted sm">norma @r.Norma</div> }</td>
                            <td><span class="badge @(r.Bloqueia ? "st-neg" : "st-warn")">@(r.Bloqueia ? "Bloqueia" : "Só alerta")</span></td>
                            <td class="right nowrap">@if (_ator.Pode(Perm.EditarRequisitos)) { <button class="row-act" @onclick="() => EditarReq(r)" title="Editar">@Icons.Svg("edit")</button><button class="row-act del" @onclick="() => ExcluirReq(r)" title="Excluir">@Icons.Svg("trash")</button> }</td></tr>
                    }
                    </tbody></table></div>
                @if (_snap.Requisitos.Count == 0) { <div class="empty-state sm"><h3>Nenhum requisito configurado</h3></div> }
            </div>
        </div>
        <div class="c7">
            <div class="panel">
                <div class="panel-head"><div class="panel-title">Quem pode atender?</div></div>
                <p class="muted sm">Mostra, separadamente, a <strong>disponibilidade de agenda</strong> e a <strong>aptidão documental</strong> no período, considerando a validade durante todo o atendimento.</p>
                <div class="form-grid g3">
                    <div class="fld">Planta<SeletorPlanta Value="@_aPlanta" ValueChanged="id => _aPlanta = id ?? string.Empty" Vazio="— qualquer —" Placeholder="— qualquer —" /></div>
                    <label class="fld">Serviço<select @bind="_aServ"><option value="">— qualquer —</option>@foreach (var s in _snap.Servicos.Values.OrderBy(s => s.Nome)) {<option value="@s.Id">@s.Nome</option>}</select></label>
                    <label class="fld chk"><input type="checkbox" @bind="_aSo" />Só livres e aptos</label>
                    <label class="fld">Início<input type="date" value="@Ui.DataInput(_aDe)" @onchange="e => _aDe = Ui.DoDataInput(e.Value?.ToString()) ?? _aDe" /></label>
                    <label class="fld">Término<input type="date" value="@Ui.DataInput(_aAte)" @onchange="e => _aAte = Ui.DoDataInput(e.Value?.ToString()) ?? _aAte" /></label>
                </div>
                @{ var linhas = Aptidoes(); }
                <div class="table-wrap mt8"><table class="grid-tbl">
                    <thead><tr><th>Técnico</th><th>Agenda no período</th><th>Aptidão documental</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var l in linhas)
                    {
                        <tr class="@(l.livre && l.ap.Apto ? "lin-ok" : "")">
                            <td><a href="/tecnicos/@l.t.Id">@l.t.Nome</a></td>
                            <td><span class="badge @(l.livre ? "st-pos" : "st-warn")">@(l.livre ? "Livre" : "Com compromissos")</span><div class="muted sm">@l.agenda</div></td>
                            <td>@if (l.ap.Apto) { <span class="badge st-pos">@Icons.Svg("check", "bico")Apto</span> }
                                else if (l.ap.Bloqueado) { <span class="badge st-neg">@Icons.Svg("x", "bico")Precisa renovar / pendente</span> }
                                else { <span class="badge st-warn">@Icons.Svg("alert", "bico")Apto com alertas</span> }
                                @foreach (var p in l.ap.Pendencias) { <div class="sm @(p.Bloqueia ? "neg" : "warn")">@p.Motivo</div> }</td>
                            <td>@if (l.livre && l.ap.Apto) { <span class="tag ok">Livre e apto</span> }</td>
                        </tr>
                    }
                    </tbody></table></div>
                @if (linhas.Count == 0) { <div class="empty-state sm"><h3>Nenhum técnico atende aos filtros</h3></div> }
            </div>
        </div>
    </div>
}

@if (_req is not null)
{
    <Dialogo Titulo="@(string.IsNullOrEmpty(_req.Id) ? "Novo requisito" : "Editar requisito")" OnFechar="@(() => _req = null)" Erros="_erros">
        <div class="form-grid">
            <label class="fld">Vale para<select @bind="_req.Escopo" @bind:after="@(() => _req.EscopoId = "")"><option value="servico">Serviço</option><option value="planta">Planta</option></select></label>
            <div class="fld">@(_req.Escopo == "servico" ? "Serviço" : "Planta")@if (_req.Escopo == "servico") { <select @bind="_req.EscopoId"><option value="">— selecione —</option>@foreach (var s in _snap.Servicos.Values.OrderBy(s => s.Nome)) {<option value="@s.Id">@s.Nome</option>}</select> } else { <SeletorPlanta Value="@_req.EscopoId" ValueChanged="id => _req.EscopoId = id ?? string.Empty" /> }</div>
            <label class="fld full">Documento / treinamento exigido *<input @bind="_req.Nome" /><span class="hint">O técnico atende se tiver um registro atual com este nome ou com a norma abaixo.</span></label>
            <label class="fld">Norma <span class="hint">opcional</span><input @bind="_req.Norma" /></label>
            <label class="fld">Categoria<select @bind="_req.Categoria"><option value=""></option>@foreach (var c in Vocab.CategoriasDoc) {<option>@c</option>}</select></label>
            <label class="fld chk full"><input type="checkbox" @bind="_req.Bloqueia" />Bloqueia a confirmação quando ausente, vencido ou vencendo antes do fim do atendimento (desmarcado: só alerta)</label>
            <label class="fld full">Observações<input @bind="_req.Obs" /></label>
        </div>
        <div class="modal-actions"><button class="btn-ghost" @onclick="@(() => _req = null)">Cancelar</button><button class="btn-primary" @onclick="SalvarReq">@Icons.Svg("check")Salvar</button></div>
    </Dialogo>
}

@code {
    private Ator _ator = new(); private Snapshot _snap = new(); private List<Tecnico> _tecs = new(); private List<Evento> _eventos = new();
    private Dictionary<string, Estado> _estados = new(); private List<DocEngine.Linha> _venc = new();
    private string _aba = "equipe", _busca = "", _fEsp = ""; private bool _soAtivos;
    private string _vTec = "", _vCat = "", _vNorma = "", _vSt = ""; private DateTime? _vDe, _vAte;
    private string _aPlanta = "", _aServ = ""; private bool _aSo; private DateTime _aDe, _aAte;
    private Requisito? _req; private List<string>? _erros;

    protected override async Task OnInitializedAsync()
    {
        _ator = await Sessao.AtorAsync(); Sessao.Mudou += Ao;
        Carregar();
        var h = Tempo.ParaLocal(DateTime.UtcNow, _snap.FusoPadrao).Date; _aDe = h.AddDays(1); _aAte = h.AddDays(5);
    }
    private void Ao() => InvokeAsync(StateHasChanged);
    public void Dispose() => Sessao.Mudou -= Ao;

    private void Carregar()
    {
        _snap = Svc.Foto();
        _tecs = _snap.Tecnicos.Values.Where(t => _ator.VeTecnico(t.Id)).ToList();
        _eventos = AgendaEngine.Eventos(_snap);
        var agora = DateTime.UtcNow;
        _estados = _tecs.Where(t => t.Ativo).ToDictionary(t => t.Id, t => AgendaEngine.EstadoEm(_snap, _eventos, t, agora, agora));
        var ids = _tecs.Select(t => t.Id).ToHashSet();
        _venc = DocEngine.Vencimentos(_snap, DocEngine.Hoje(_snap.FusoPadrao)).Where(v => ids.Contains(v.Doc.TecnicoId)).ToList();
    }

    private IEnumerable<Tecnico> Filtrados => _tecs.Where(t => (!_soAtivos || t.Ativo)
        && (string.IsNullOrEmpty(_fEsp) || Ui.Ids(t.EspecialidadeIds).Contains(_fEsp))
        && (string.IsNullOrWhiteSpace(_busca) || DocEngine.Norm($"{t.Nome} {t.Cidade} {t.Estado} {t.Matricula}").Contains(DocEngine.Norm(_busca)))).OrderBy(t => t.Nome);

    private IEnumerable<DocEngine.Linha> VencFiltrados => _venc.Where(v =>
        (_vTec == "" || v.Doc.TecnicoId == _vTec) && (_vCat == "" || v.Doc.Categoria == _vCat) && (_vNorma == "" || v.Doc.Norma == _vNorma)
        && (_vSt == "" || v.Status == _vSt) && (_vDe is null || (v.Doc.Vencimento is { } d && d >= _vDe)) && (_vAte is null || (v.Doc.Vencimento is { } d2 && d2 <= _vAte)))
        .OrderBy(v => v.Dias ?? int.MaxValue);

    private string EscopoNome(Requisito r) => r.Escopo == "servico" ? _snap.Servico(r.EscopoId)?.Nome ?? "?" : _snap.NomePlanta(r.EscopoId);

    private List<(Tecnico t, bool livre, string agenda, Aptidao ap)> Aptidoes()
    {
        var res = new List<(Tecnico, bool, string, Aptidao)>();
        var fusoP = _snap.Planta(_aPlanta)?.FusoHorario ?? _snap.FusoPadrao;
        var ini = Tempo.ParaUtc(_aDe.Date.AddHours(8), fusoP); var fim = Tempo.ParaUtc(_aAte.Date.AddHours(17), fusoP);
        if (fim <= ini) return new();
        var reqs = DocEngine.RequisitosDe(_snap, new[] { _aServ }, new[] { _aPlanta });
        var hoje = DocEngine.Hoje(_snap.FusoPadrao);
        foreach (var t in _tecs.Where(t => t.Ativo))
        {
            if (!string.IsNullOrEmpty(_aServ) && Ui.Ids(t.ServicoIds).Length > 0 && !Ui.Ids(t.ServicoIds).Contains(_aServ)) continue;
            var dias = AgendaEngine.Dias(_snap, _eventos, t, Tempo.ParaLocal(ini, t.FusoHorario).Date, Tempo.ParaLocal(fim, t.FusoHorario).Date);
            var util = dias.Where(d => d.Situacao != "naoutil").ToList();
            var livre = util.Count > 0 && util.All(d => d.Situacao is "livre" or "provisorio");
            var agenda = livre ? "Livre em todos os dias úteis do período" : string.Join(", ", util.Where(d => d.Situacao is not ("livre" or "provisorio")).Select(d => $"{d.Dia:dd/MM} {d.Situacao switch { "ocupado" => "ocupado", "parcial" => "parcial", "indisponivel" => "indisponível", _ => d.Situacao }}").Take(4));
            var ap = DocEngine.Avaliar(_snap, t, reqs, ini, fim, hoje, fusoP);
            if (_aSo && !(livre && ap.Apto)) continue;
            res.Add((t, livre, agenda, ap));
        }
        return res.OrderByDescending(x => x.Item2 && x.Item4.Apto).ThenBy(x => x.Item4.Bloqueado).ThenBy(x => x.Item1.Nome).ToList();
    }

    private void NovoReq() { _req = new Requisito(); _erros = null; }
    private void EditarReq(Requisito r) { _req = r.Copia<Requisito>(); _erros = null; }
    private void SalvarReq() { try { Svc.SalvarRequisito(_ator, _req!); _req = null; Carregar(); Sessao.Avisar("Requisito salvo."); } catch (Exception ex) { _erros = Ui.Erros(ex); } }
    private void ExcluirReq(Requisito r) { try { Svc.ExcluirRequisito(_ator, r.Id); Carregar(); Sessao.Avisar("Requisito removido."); } catch (Exception ex) { Sessao.Avisar(string.Join(" ", Ui.Erros(ex)), true); } }

    // ---- importação de técnicos ----
    private int _passo = 1; private ArquivoLido? _arq; private Dictionary<string, int> _map = new(); private List<LinhaImport> _linhas = new();
    private ResultadoImport? _res; private bool _lendo, _soProblemas; private List<string>? _errosImp;

    private async Task AoArquivo(InputFileChangeEventArgs e)
    {
        _errosImp = null; _lendo = true; StateHasChanged();
        try
        {
            await using var st = e.File.OpenReadStream(Importador.MaxBytes);
            using var ms = new MemoryStream(); await st.CopyToAsync(ms); ms.Position = 0;
            _arq = Importador.Ler(e.File.Name, ms); _map = ImportadorTecnicos.SugerirMapeamento(_arq.Cabecalhos); _passo = 2;
        }
        catch (Exception ex) { _errosImp = Ui.Erros(ex); }
        _lendo = false;
    }
    private void Mapear(string key, string? v) { if (int.TryParse(v, out var i) && i >= 0) _map[key] = i; else _map.Remove(key); }
    private void AnalisarImp() { _errosImp = null; try { _linhas = Imp.Analisar(_arq!, _map); _passo = 3; } catch (Exception ex) { _errosImp = Ui.Erros(ex); } }
    private void AplicarPadrao(string? a)
    {
        var ac = a switch { "Ignorar" => AcaoImport.Ignorar, "Criar" => AcaoImport.Criar, _ => AcaoImport.Atualizar };
        foreach (var l in _linhas.Where(l => l.Existente && !l.Rejeitada)) l.Acao = ac;
    }
    private void ConfirmarImp()
    {
        _errosImp = null;
        try { _res = Imp.Aplicar(_ator, _linhas); _passo = 4; Carregar(); Sessao.Avisar("Importação concluída."); } catch (Exception ex) { _errosImp = Ui.Erros(ex); }
    }
    private void ReiniciarImport() { _passo = 1; _arq = null; _linhas = new(); _res = null; _errosImp = null; _map = new(); }
    private async Task BaixarErros()
    {
        if (_res is null) return;
        await JS.InvokeVoidAsync("app.baixarTexto", "erros_importacao_tecnicos.csv", "text/csv;charset=utf-8", Importador.ErrosCsvTexto(_res), true);
    }
