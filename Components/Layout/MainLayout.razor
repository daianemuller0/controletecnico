@inherits LayoutComponentBase
@implements IDisposable
@inject Db Db
@inject Sessao Sessao

<div class="app-shell @(_apres ? "apres" : "")">
    <NavMenu />
    <div class="main-col">
        @if (Db.Demo)
        {
            <div class="demo-banner no-print" role="status">
                @Icons.Svg("info")<strong>AMBIENTE DE DEMONSTRAÇÃO</strong><span>Todos os técnicos, clientes, viagens e documentos são fictícios.</span>
            </div>
        }
        @if (_versaoNova is { } vn)
        {
            <div class="demo-banner versao-banner no-print" role="status">
                @Icons.Svg("refresh")<strong>NOVA VERSÃO PUBLICADA (@vn)</strong><span>Feche a janela preta do Controle Técnico e abra de novo pelo atalho para atualizar.</span>
            </div>
        }
        <TopBar />
        <main class="content @(_apres ? "content-wide" : "")">
            @Body
        </main>
        <Toaster />
        <AutoBarra />
    </div>
</div>

@code {
    private bool _apres; private string? _versaoNova = Lancador.VersaoNova;
    protected override void OnInitialized() { _apres = Sessao.Apresentacao; Sessao.Mudou += Ao; Lancador.VersaoNovaPublicada += AoVersao; }
    private void AoVersao() => InvokeAsync(() => { _versaoNova = Lancador.VersaoNova; StateHasChanged(); });
    public void Dispose() { Sessao.Mudou -= Ao; Lancador.VersaoNovaPublicada -= AoVersao; }
    private void Ao() => InvokeAsync(() => { _apres = Sessao.Apresentacao; StateHasChanged(); });
}
