<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated == true)
                {
                    <div class="content"><div class="state-box state-err">@Icons.Svg("lock")<div><strong>Acesso não permitido</strong><div class="muted">Seu perfil não tem permissão para esta área.</div></div><a class="btn-ghost" href="/">Voltar ao início</a></div></div>
                }
                else
                {
                    <RedirectToLogin />
                }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(MainLayout)">
            <div class="content"><div class="empty-state"><div class="ico">@Icons.Svg("map")</div><h3>Página não encontrada</h3><a class="btn-primary" href="/">Ir para a Visão operacional</a></div></div>
        </LayoutView>
    </NotFound>
</Router>
